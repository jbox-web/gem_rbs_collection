        def initialize: () { (?) -> untyped } -> void

        def call: (untyped target, untyped value) -> untyped
      end
    end

    module ::ActiveSupport::Callbacks::Filters
      ::ActiveSupport::Callbacks::Filters::Environment: untyped

      class ::ActiveSupport::Callbacks::Filters::Before
        def initialize: (untyped user_callback, untyped user_conditions, untyped chain_config, untyped filter, untyped name) -> void

        attr_reader user_callback: untyped

        attr_reader user_conditions: untyped

        attr_reader halted_lambda: untyped

        attr_reader filter: untyped

        attr_reader name: untyped

        def call: (untyped env) -> untyped

        def apply: (untyped callback_sequence) -> untyped
      end

      class ::ActiveSupport::Callbacks::Filters::After
        attr_reader user_callback: untyped

        attr_reader user_conditions: untyped

        attr_reader halting: untyped

        def initialize: (untyped user_callback, untyped user_conditions, untyped chain_config) -> void

        def call: (untyped env) -> untyped

        def apply: (untyped callback_sequence) -> untyped
      end

      class ::ActiveSupport::Callbacks::Filters::Around
        def initialize: (untyped user_callback, untyped user_conditions) -> void

        def apply: (untyped callback_sequence) -> untyped
      end
    end

    class ::ActiveSupport::Callbacks::Callback
      def self.build: (untyped chain, untyped filter, untyped kind, untyped options) -> ::ActiveSupport::Callbacks::Callback

      attr_accessor kind: untyped

      attr_accessor name: untyped

      attr_reader chain_config: untyped

      attr_reader filter: untyped

      def initialize: (untyped name, untyped filter, untyped kind, untyped options, untyped chain_config) -> void

      def merge_conditional_options: (untyped chain, if_option: untyped, unless_option: untyped) -> ::ActiveSupport::Callbacks::Callback

      def matches?: (untyped _kind, untyped _filter) -> untyped

      def duplicates?: (untyped other) -> untyped

      def compiled: () -> (::ActiveSupport::Callbacks::Filters::After | ::ActiveSupport::Callbacks::Filters::Around | ::ActiveSupport::Callbacks::Filters::Before | nil)

      # Wraps code with filter
      def apply: (untyped callback_sequence) -> untyped

      def current_scopes: () -> untyped

      private

      ::ActiveSupport::Callbacks::Callback::EMPTY_ARRAY: ::Array[untyped]

      def check_conditionals: (untyped conditionals) -> untyped

      def conditions_lambdas: () -> untyped
    end

    # A future invocation of user-supplied code (either as a callback,
    # or a condition filter).
    module ::ActiveSupport::Callbacks::CallTemplate
      class ::ActiveSupport::Callbacks::CallTemplate::MethodCall
        def initialize: (untyped method) -> void

        # Return the parts needed to make this call, with the given
        # input values.
        #
        # Returns an array of the form:
        #
        #   [target, block, method, *arguments]
        #
        # This array can be used as such:
        #
        #   target.send(method, *arguments, &block)
        #
