      end

      ::ActiveSupport::Duration::ISO8601Parser::PERIOD_OR_COMMA: ::Regexp

      ::ActiveSupport::Duration::ISO8601Parser::PERIOD: "."

      ::ActiveSupport::Duration::ISO8601Parser::COMMA: ","

      ::ActiveSupport::Duration::ISO8601Parser::SIGN_MARKER: ::Regexp

      ::ActiveSupport::Duration::ISO8601Parser::DATE_MARKER: ::Regexp

      ::ActiveSupport::Duration::ISO8601Parser::TIME_MARKER: ::Regexp

      ::ActiveSupport::Duration::ISO8601Parser::DATE_COMPONENT: ::Regexp

      ::ActiveSupport::Duration::ISO8601Parser::TIME_COMPONENT: ::Regexp

      ::ActiveSupport::Duration::ISO8601Parser::DATE_TO_PART: { "Y" => :years, "M" => :months, "W" => :weeks, "D" => :days }

      ::ActiveSupport::Duration::ISO8601Parser::TIME_TO_PART: { "H" => :hours, "M" => :minutes, "S" => :seconds }

      ::ActiveSupport::Duration::ISO8601Parser::DATE_COMPONENTS: ::Array[:years | :months | :days]

      ::ActiveSupport::Duration::ISO8601Parser::TIME_COMPONENTS: ::Array[:hours | :minutes | :seconds]

      attr_reader parts: untyped

      attr_reader scanner: untyped

      attr_accessor mode: untyped

      attr_accessor sign: untyped

      def initialize: (untyped string) -> void

      def parse!: () -> untyped

      private

      def finished?: () -> untyped

      # Parses number which can be a float with either comma or period.
      def number: () -> untyped

      def scan: (untyped pattern) -> untyped

      def raise_parsing_error: (?untyped? reason) -> bot

      # Checks for various semantic errors as stated in ISO 8601 standard.
      def validate!: () -> true
    end
  end
end

