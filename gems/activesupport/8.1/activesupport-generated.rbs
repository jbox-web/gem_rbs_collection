    # On MRI `ObjectSpace::WeakMap` keys are weak references.
    # So we can simply use WeakMap as a `Set`.
    class ::ActiveSupport::DescendantsTracker::WeakSet
      def to_a: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped

      def <<: (untyped object) -> untyped
    end

    # On TruffleRuby `ObjectSpace::WeakMap` keys are strong references.
    # So we use `object_id` as a key and the actual object as a value.
    #
    # JRuby for now doesn't have Class#descendant, but when it will, it will likely
    # have the same WeakMap semantic than Truffle so we future proof this as much as possible.
    class ::ActiveSupport::DescendantsTracker::WeakSet
      def initialize: () -> void

      def []: (untyped object) -> untyped

      alias include? []

      def []=: (untyped object, untyped _present) -> untyped
    end

    module ::ActiveSupport::DescendantsTracker::ReloadedClassesFiltering
      def subclasses: () -> untyped

      def descendants: () -> untyped
    end

    def self.disable_clear!: () -> (untyped | nil)

    def self.clear: (untyped classes) -> untyped

    def self.reject!: (untyped classes) -> untyped

    def self.subclasses: (untyped klass) -> untyped

    def self.descendants: (untyped klass) -> untyped

    def descendants: () -> untyped
  end
end

