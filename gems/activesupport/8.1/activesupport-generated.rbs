        include ::ActiveSupport::Cache::SerializerWithFallback

        extend ::ActiveSupport::Cache::SerializerWithFallback::Marshal71WithFallback

        ::ActiveSupport::Cache::SerializerWithFallback::Marshal71WithFallback::MARSHAL_SIGNATURE: untyped

        def dump: (untyped value) -> ::String

        def _load: (untyped dumped) -> untyped

