  class ::ActiveSupport::EventContext
    ::ActiveSupport::EventContext::EMPTY_CONTEXT: ::Hash[untyped, untyped]

    ::ActiveSupport::EventContext::FIBER_KEY: :event_reporter_context

    def self.context: () -> untyped

    def self.set_context: (untyped context_hash) -> untyped

    def self.clear: () -> ::Hash[untyped, untyped]
