module ::ActiveSupport
  # Allows you to "listen" to changes in a file system.
  # The evented file updater does not hit disk when checking for updates.
  # Instead, it uses platform-specific file system events to trigger a change
  # in state.
  #
  # The file checker takes an array of files to watch or a hash specifying directories
  # and file extensions to watch. It also takes a block that is called when
  # EventedFileUpdateChecker#execute is run or when EventedFileUpdateChecker#execute_if_updated
  # is run and there have been changes to the file system.
  #
  # Example:
  #
  #     checker = ActiveSupport::EventedFileUpdateChecker.new(["/tmp/foo"]) { puts "changed" }
  #     checker.updated?
  #     # => false
  #     checker.execute_if_updated
  #     # => nil
  #
  #     FileUtils.touch("/tmp/foo")
  #
  #     checker.updated?
  #     # => true
  #     checker.execute_if_updated
  #     # => "changed"
  #
  class ::ActiveSupport::EventedFileUpdateChecker
    def initialize: (untyped files, ?::Hash[untyped, untyped] dirs) ?{ (?) -> untyped } -> void

    def inspect: () -> ::String

    def updated?: () -> untyped

    def execute: () -> untyped

    def execute_if_updated: () ?{ () -> untyped } -> (true | nil)

    class ::ActiveSupport::EventedFileUpdateChecker::Core
      attr_reader updated: untyped

      attr_reader files: untyped

      def initialize: (untyped files, untyped dirs) -> void

      def finalizer: () -> ::Proc

      def thread_safely: () { (untyped) -> untyped } -> untyped

      def start: () -> untyped

      def stop: () -> untyped

      def restart: () -> untyped

      def restart?: () -> (false | true)

      def normalize_dirs!: () -> untyped

      def changed: (untyped modified, untyped added, untyped removed) -> (untyped | nil | nil)

      def watching?: (untyped file) -> (false | nil | true)

      def directories_to_watch: () -> untyped

      def common_path: (untyped paths) -> untyped
    end
  end
end

