        extend ::ActiveSupport::Cache::SerializerWithFallback::Marshal70WithFallback

        ::ActiveSupport::Cache::SerializerWithFallback::Marshal70WithFallback::MARK_UNCOMPRESSED: untyped

        ::ActiveSupport::Cache::SerializerWithFallback::Marshal70WithFallback::MARK_COMPRESSED: untyped

