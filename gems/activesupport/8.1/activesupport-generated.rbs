module ::ActiveSupport
  class ::ActiveSupport::TagStack
    ::ActiveSupport::TagStack::EMPTY_TAGS: ::Hash[untyped, untyped]

    ::ActiveSupport::TagStack::FIBER_KEY: :event_reporter_tags

