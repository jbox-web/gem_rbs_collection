  module ::ActiveSupport::ExecutionContext
    class ::ActiveSupport::ExecutionContext::Record
      attr_reader store: untyped

      attr_reader current_attributes_instances: untyped

      def initialize: () -> void

      def push: () -> self

      def pop: () -> self

      def flush: () -> self
    end

    attr_accessor self.nestable: untyped

    def self.after_change: () { (?) -> untyped } -> untyped

    # Updates the execution context. If a block is given, it resets the provided keys to their
    # previous value once the block exits.
    def self.set: (**untyped options) ?{ () -> untyped } -> untyped

    def self.[]=: (untyped key, untyped value) -> untyped

    def self.to_h: () -> untyped

    def self.push: () -> self

    def self.pop: () -> self

    def self.clear: () -> nil

    def self.flush: () -> untyped

    def self.current_attributes_instances: () -> untyped

    private

    def self.record: () -> ::ActiveSupport::ExecutionContext::Record
  end
end

