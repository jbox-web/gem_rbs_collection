      #  ==== Enumerable Body
      #
      def each: () { (untyped) -> untyped } -> nil

      ::Rack::Lint::Wrapper::BODY_METHODS: { to_ary: true, each: true, call: true, to_path: true }

      def to_path: () -> untyped

      def respond_to?: (untyped name, *untyped) -> untyped

