      #
      #  === The Headers
      #
      def check_headers: (untyped headers) -> ::Hash[untyped, untyped]

      def check_header_value: (untyped key, untyped value) -> (untyped | nil)

      #
      #  ==== The <tt>content-type</tt> Header
      #
      def check_content_type_header: (untyped status, untyped headers) -> untyped

      #
      #  ==== The <tt>content-length</tt> Header
      #
      def check_content_length_header: (untyped status, untyped headers) -> untyped

      def verify_content_length: (untyped size) -> (untyped | nil | untyped | nil | nil)

      #
      #  ==== The <tt>rack.protocol</tt> Header
      #
      def check_rack_protocol_header: (untyped status, untyped headers) -> nil

