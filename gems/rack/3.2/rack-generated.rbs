    #   # => ["mycookie=; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT"]
    #   header
    #   # => ["mycookie=; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT"]
    #
    def self?.delete_set_cookie_header!: (untyped header, untyped key, ?::Hash[untyped, untyped] value) -> untyped

    def self?.rfc2822: (untyped time) -> untyped

    # Parses the "Range:" header, if present, into an array of Range objects.
    # Returns nil if the header is missing or syntactically invalid.
    # Returns an empty array if none of the ranges are satisfiable.
    def self?.byte_ranges: (untyped env, untyped size, ?max_ranges: ::Integer) -> (::Array[::Range[untyped]] | ::Array[untyped] | nil)

    def self?.get_byte_ranges: (untyped http_range, untyped size, ?max_ranges: ::Integer) -> (nil | ::Array[untyped] | untyped)

