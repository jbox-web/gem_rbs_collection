end

module ::Rack
  # Class which can make any IO object rewindable, including non-rewindable ones. It does
  # this by buffering the data into a tempfile, which is rewindable.
  #
  # Don't forget to call #close when you're done. This frees up temporary resources that
  # RewindableInput uses, though it does *not* close the original IO object.
  class ::Rack::RewindableInput
    # Makes rack.input rewindable, for compatibility with applications and middleware
    # designed for earlier versions of Rack (where rack.input was required to be
    # rewindable).
    class ::Rack::RewindableInput::Middleware
      def initialize: (untyped app) -> void

      def call: (untyped env) -> untyped
    end

    def initialize: (untyped io) -> void

    def gets: () -> (::String | nil)

    def read: (*untyped args) -> (::String | nil)

    def each: () { (?) -> untyped } -> ::Tempfile

    def rewind: () -> ::Integer

    def size: () -> ::Integer

    # Closes this RewindableInput object without closing the originally
    # wrapped IO object. Cleans up any temporary resources that this RewindableInput
    # has created.
    #
    # This method may be called multiple times. It does nothing on subsequent calls.
    def close: () -> (untyped | nil)

    private

    def make_rewindable: () -> ::Integer

    def filesystem_has_posix_semantics?: () -> (false | true)
  end
end

