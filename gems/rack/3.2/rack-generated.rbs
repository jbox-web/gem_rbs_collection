    attr_accessor status: untyped

    attr_accessor body: untyped

    attr_reader headers: untyped

    # Initialize the response object with the specified +body+, +status+
    # and +headers+.
    #
    # If the +body+ is +nil+, construct an empty response object with internal
    # buffering.
    #
    # If the +body+ responds to +to_str+, assume it's a string-like object and
    # construct a buffered response object containing using that string as the
    # initial contents of the buffer.
    #
    # Otherwise it is expected +body+ conforms to the normal requirements of a
    # Rack response body, typically implementing one of +each+ (enumerable
    # body) or +call+ (streaming body).
    #
    # The +status+ defaults to +200+ which is the "OK" HTTP status code. You
    # can provide any other valid status code.
    #
    # The +headers+ must be a +Hash+ of key-value header pairs which conform to
    # the Rack specification for response headers. The key must be a +String+
    # instance and the value can be either a +String+ or +Array+ instance.
    def initialize: (?untyped? body, ?::Integer status, ?::Hash[untyped, untyped] headers) ?{ (untyped) -> untyped } -> void

    def redirect: (untyped target, ?::Integer status) -> untyped

    def chunked?: () -> (false | true)

    def no_entity_body?: () -> untyped

    # Generate a response array consistent with the requirements of the SPEC.
    # @return [Array] a 3-tuple suitable of `[status, headers, body]`
    # which is suitable to be returned from the middleware `#call(env)` method.
    def finish: () ?{ (?) -> untyped } -> (::Array[untyped | ::Array[untyped]] | untyped | ::Array[untyped | self] | untyped | ::Array[untyped] | untyped)

    alias to_a finish

    def each: () { (?) -> untyped } -> untyped

    # Append a chunk to the response body.
    #
    # Converts the response into a buffered response if it wasn't already.
    #
    # NOTE: Do not mix #write and direct #body access!
    #
    def write: (untyped chunk) -> untyped

    def close: () -> (untyped | nil)

    def empty?: () -> untyped

    def has_header?: (untyped key) -> untyped

    def get_header: (untyped key) -> untyped

    def set_header: (untyped key, untyped value) -> untyped

    def delete_header: (untyped key) -> untyped

    alias [] get_header

    alias []= set_header

    module ::Rack::Response::Helpers
      def invalid?: () -> untyped

      def informational?: () -> untyped

      def successful?: () -> untyped

      def redirection?: () -> untyped

      def client_error?: () -> untyped

      def server_error?: () -> untyped

      def ok?: () -> untyped

      def created?: () -> untyped

      def accepted?: () -> untyped

      def no_content?: () -> untyped

      def moved_permanently?: () -> untyped

      def bad_request?: () -> untyped

      def unauthorized?: () -> untyped

      def forbidden?: () -> untyped

      def not_found?: () -> untyped

      def method_not_allowed?: () -> untyped

      def not_acceptable?: () -> untyped

      def request_timeout?: () -> untyped

      def precondition_failed?: () -> untyped

      def unprocessable?: () -> untyped

      def redirect?: () -> (false | true)

