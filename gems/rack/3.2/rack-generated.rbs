module ::Rack
  class ::Rack::MockRequest
    class ::Rack::MockRequest::FatalWarning < ::RuntimeError
    end

    class ::Rack::MockRequest::FatalWarner
      def puts: (untyped warning) -> bot

      def write: (untyped warning) -> bot

      def flush: () -> nil

      def string: () -> ""
    end

    def initialize: (untyped app) -> void

    # Make a GET request and return a MockResponse. See #request.
    def get: (untyped uri, ?::Hash[untyped, untyped] opts) -> untyped

    # Make a POST request and return a MockResponse. See #request.
    def post: (untyped uri, ?::Hash[untyped, untyped] opts) -> untyped

    # Make a PUT request and return a MockResponse. See #request.
    def put: (untyped uri, ?::Hash[untyped, untyped] opts) -> untyped

    # Make a PATCH request and return a MockResponse. See #request.
    def patch: (untyped uri, ?::Hash[untyped, untyped] opts) -> untyped

    # Make a DELETE request and return a MockResponse. See #request.
    def delete: (untyped uri, ?::Hash[untyped, untyped] opts) -> untyped

    # Make a HEAD request and return a MockResponse. See #request.
    def head: (untyped uri, ?::Hash[untyped, untyped] opts) -> untyped

    # Make an OPTIONS request and return a MockResponse. See #request.
    def options: (untyped uri, ?::Hash[untyped, untyped] opts) -> untyped

    # Make a request using the given request method for the given
    # uri to the rack application and return a MockResponse.
    # Options given are passed to MockRequest.env_for.
    def request: (?untyped method, ?::String uri, ?::Hash[untyped, untyped] opts) -> untyped

    # For historical reasons, we're pinning to RFC 2396.
    # URI::Parser = URI::RFC2396_Parser
    def self.parse_uri_rfc2396: (untyped uri) -> untyped

    # Return the Rack environment used for a request to +uri+.
    # All options that are strings are added to the returned environment.
    # Options:
    # :fatal :: Whether to raise an exception if request outputs to rack.errors
    # :input :: The rack.input to set
    # :http_version :: The SERVER_PROTOCOL to set
    # :method :: The HTTP request method to use
    # :params :: The params to use
    # :script_name :: The SCRIPT_NAME to set
    def self.env_for: (?::String uri, ?::Hash[untyped, untyped] opts) -> ::Hash[untyped, untyped]
  end
end

module ::Rack
  class ::Rack::MockResponse < ::Rack::Response
    class ::Rack::MockResponse::Cookie
      attr_reader name: untyped

      attr_reader value: untyped

      attr_reader path: untyped

      attr_reader domain: untyped

      attr_reader expires: untyped

      attr_reader secure: untyped

      def initialize: (untyped args) -> void

      def method_missing: (untyped method_name, *untyped args) { (?) -> untyped } -> untyped

      def respond_to_missing?: (untyped method_name, ?bool include_all) -> untyped
    end
    def self.[]: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped

    # Headers
    attr_reader original_headers: untyped

    # Headers
    attr_reader cookies: untyped

    # Errors
    attr_accessor errors: untyped

    def initialize: (untyped status, untyped headers, untyped body, ?untyped? errors) -> void

    def =~: (untyped other) -> untyped

    def match: (untyped other) -> untyped

    def body: () -> (::String | nil)

    def empty?: () -> (false | true)

    def cookie: (untyped name) -> untyped

    private

    def parse_cookies_from_header: () -> ::Hash[untyped, untyped]

    def identify_cookie_attributes: (untyped cookie_filling) -> ::Hash[untyped, untyped]
  end
end

module ::Rack
  # A multipart form data parser, adapted from IOWA.
  #
  # Usually, Rack::Request#POST takes care of calling this.
  module ::Rack::Multipart
    ::Rack::Multipart::MULTIPART_BOUNDARY: "AaB03x"

    class ::Rack::Multipart::MissingInputError < ::StandardError
      include ::Rack::BadRequest
    end

    # Accumulator for multipart form data, conforming to the QueryParser API.
    # In future, the Parser could return the pair list directly, but that would
    # change its API.
    class ::Rack::Multipart::ParamList
      def self.make_params: () -> ::Rack::Multipart::ParamList

      def self.normalize_params: (untyped params, untyped key, untyped value) -> untyped

      def initialize: () -> void

      def <<: (untyped pair) -> ::Array[untyped]

      def to_params_hash: () -> ::Array[untyped]
    end

    def self.parse_multipart: (untyped env, ?untyped params) -> untyped

    def self.extract_multipart: (untyped request, ?untyped params) -> untyped

    def self.build_multipart: (untyped params, ?bool first) -> untyped
  end
end

module ::Rack
  module ::Rack::Multipart
    class ::Rack::Multipart::Generator
      def initialize: (untyped params, ?bool first) -> void

      def dump: () -> (nil | untyped)

      private

      def multipart?: () -> untyped

      def flattened_params: () -> untyped

      def content_for_tempfile: (untyped io, untyped file, untyped name) -> ::String

      def content_for_other: (untyped file, untyped name) -> ::String
    end
  end
end

module ::Rack
  module ::Rack::Multipart
    class ::Rack::Multipart::MultipartPartLimitError < ::Errno::EMFILE
      include ::Rack::BadRequest
    end

    class ::Rack::Multipart::MultipartTotalPartLimitError < ::StandardError
      include ::Rack::BadRequest
    end

    # Use specific error class when parsing multipart request
    # that ends early.
    class ::Rack::Multipart::EmptyContentError < ::EOFError
      include ::Rack::BadRequest
    end

    # Base class for multipart exceptions that do not subclass from
    # other exception classes for backwards compatibility.
    class ::Rack::Multipart::BoundaryTooLongError < ::StandardError
      include ::Rack::BadRequest
    end

    # Prefer to use the BoundaryTooLongError class or Rack::BadRequest.
    ::Rack::Multipart::Error: untyped

    ::Rack::Multipart::EOL: "\r\n"

    ::Rack::Multipart::FWS: ::Regexp

    ::Rack::Multipart::HEADER_VALUE: "(?:[^\r\n]|\r\n[ \t])*"

    ::Rack::Multipart::MULTIPART: ::Regexp

    ::Rack::Multipart::MULTIPART_CONTENT_TYPE: ::Regexp

    ::Rack::Multipart::MULTIPART_CONTENT_DISPOSITION: ::Regexp

    ::Rack::Multipart::MULTIPART_CONTENT_ID: ::Regexp

    # Rack::Multipart::Parser handles parsing of multipart/form-data requests.
    #
    # File Parameter Contents
    #
    # When processing file uploads, the parser returns a hash containing
    # information about uploaded files. For +file+ parameters, the hash includes:
    #
    # * +:filename+ - The original filename, already URL decoded by the parser
    # * +:type+ - The content type of the uploaded file  
    # * +:name+ - The parameter name from the form
    # * +:tempfile+ - A Tempfile object containing the uploaded data
    # * +:head+ - The raw header content for this part
    class ::Rack::Multipart::Parser
      ::Rack::Multipart::Parser::BUFSIZE: 1048576

      ::Rack::Multipart::Parser::TEXT_PLAIN: "text/plain"

      ::Rack::Multipart::Parser::TEMPFILE_FACTORY: untyped

      ::Rack::Multipart::Parser::BOUNDARY_START_LIMIT: untyped

      ::Rack::Multipart::Parser::MIME_HEADER_BYTESIZE_LIMIT: untyped

      ::Rack::Multipart::Parser::BUFFERED_UPLOAD_BYTESIZE_LIMIT: untyped

      ::Rack::Multipart::Parser::PARSER_BYTESIZE_LIMIT: untyped

      ::Rack::Multipart::Parser::CONTENT_DISPOSITION_QUOTED_ESCAPES_LIMIT: untyped

      class ::Rack::Multipart::Parser::BoundedIO
        def initialize: (untyped io, untyped content_length) -> void

        def read: (untyped size, ?untyped? outbuf) -> (nil | untyped)
      end

      ::Rack::Multipart::Parser::MultipartInfo: untyped

      ::Rack::Multipart::Parser::EMPTY: untyped

      def self.parse_boundary: (untyped content_type) -> (nil | untyped)

      def self.parse: (untyped io, untyped content_length, untyped content_type, untyped tmpfile, untyped bufsize, untyped qp) -> untyped

      class ::Rack::Multipart::Parser::Collector
        class ::Rack::Multipart::Parser::Collector::MimePart
          def get_data: () { (untyped) -> untyped } -> (nil | untyped)
        end

        class ::Rack::Multipart::Parser::Collector::BufferPart < ::Rack::Multipart::Parser::Collector::MimePart
          def file?: () -> false

          def close: () -> nil
        end

        class ::Rack::Multipart::Parser::Collector::TempfilePart < ::Rack::Multipart::Parser::Collector::MimePart
          def file?: () -> true

          def close: () -> untyped
        end

        include ::Enumerable[untyped]

        def initialize: (untyped tempfile) -> void

        def each: () { (untyped) -> untyped } -> ::Array[untyped]

        def on_mime_head: (untyped mime_index, untyped head, untyped filename, untyped content_type, untyped name) -> nil

        def on_mime_body: (untyped mime_index, untyped content) -> untyped

        def on_mime_finish: (untyped mime_index) -> nil

        private

        def check_part_limits: () -> nil
      end

      attr_reader state: untyped

      def initialize: (untyped boundary, untyped tempfile, untyped bufsize, untyped query_parser) -> void

      def parse: (untyped io) -> (nil | untyped)

      def result: () -> untyped

      private

      def read_data: (untyped io, untyped outbuf) -> untyped

      # This handles the initial parser state.  We read until we find the starting
      # boundary, then we can transition to the next state. If we find the ending
      # boundary, this is an invalid multipart upload, but keep scanning for opening
      # boundary in that case. If no boundary found, we need to keep reading data
      # and retry. It's highly unlikely the initial read will not consume the
      # boundary.  The client would have to deliberately craft a response
      # with the opening boundary beyond the buffer size for that to happen.
      def handle_fast_forward: () -> (:want_read | nil)

      def handle_consume_token: () -> (:DONE | :MIME_HEAD)

      ::Rack::Multipart::Parser::CONTENT_DISPOSITION_MAX_PARAMS: 16

      ::Rack::Multipart::Parser::CONTENT_DISPOSITION_MAX_BYTES: 1536

      ::Rack::Multipart::Parser::OBS_UNFOLD: ::Regexp

      def handle_mime_head: () -> (untyped | :want_read | untyped)

      def handle_mime_body: () -> (untyped | :want_read)

      def update_retained_size: (untyped size) -> nil

      # Scan until the we find the start or end of the boundary.
      # If we find it, return the appropriate symbol for the start or
      # end of the boundary.  If we don't find the start or end of the
      # boundary, clear the buffer and return nil.
      def consume_boundary: () -> (:BOUNDARY | :END_BOUNDARY | nil)

      def normalize_filename: (untyped filename) -> untyped

      ::Rack::Multipart::Parser::CHARSET: "charset"

      def tag_multipart_encoding: (untyped filename, untyped content_type, untyped name, untyped body) -> (nil | untyped)

      # Return the related Encoding object. However, because
      # enc is submitted by the user, it may be invalid, so
      # use a binary encoding in that case.
      def find_encoding: (untyped enc) -> (::Encoding | nil)

      ::Rack::Multipart::Parser::REENCODE_DUMMY_ENCODINGS: ::Hash[untyped, true]

      def handle_dummy_encoding: (untyped name, untyped body) -> (::Array[untyped] | untyped)

      def handle_empty_content!: (untyped content) -> (untyped | nil)
    end
  end
end

module ::Rack
  module ::Rack::Multipart
    # Despite the misleading name, UploadedFile is designed for use for
    # preparing multipart file upload bodies, generally for use in tests.
    # It is not designed for and should not be used for handling uploaded
    # files (there is no need for that, since Rack's multipart parser
    # already creates Tempfiles for that). Using this with non-trusted
    # filenames can create a security vulnerability.
    #
    # You should only use this class if you plan on passing the instances
    # to Rack::MockRequest for use in creating multipart request bodies.
    #
    # UploadedFile delegates most methods to the tempfile it contains.
    class ::Rack::Multipart::UploadedFile
      # The provided name of the file. This generally is the basename of
      # path provided during initialization, but it can contain slashes if they
      # were present in the filename argument when the instance was created.
      attr_reader original_filename: untyped

      # The content type of the instance.
      attr_accessor content_type: untyped

      # Create a new UploadedFile.  For backwards compatibility, this accepts
      # both positional and keyword versions of the same arguments:
      #
      # filepath/path :: The path to the file
      # ct/content_type :: The content_type of the file
      # bin/binary :: Whether to set binmode on the file before copying data into it.
      #
      # If both positional and keyword arguments are present, the keyword arguments
      # take precedence.
      #
      # The following keyword-only arguments are also accepted:
      #
      # filename :: Override the filename to use for the file.  This is so the
      #             filename for the upload does not need to match the basename of
      #             the file path.  This should not contain slashes, unless you are
      #             trying to test how an application handles invalid filenames in
      #             multipart upload bodies.
      # io :: Use the given IO-like instance as the tempfile, instead of creating
      #       a Tempfile instance.  This is useful for building multipart file
      #       upload bodies without a file being present on the filesystem. If you are
      #       providing this, you should also provide the filename argument.
      def initialize: (?untyped? filepath, ?::String ct, ?bool bin, ?path: untyped, ?content_type: untyped, ?binary: untyped, ?filename: untyped?, ?io: untyped?) -> void

      # The path of the tempfile for the instance, if the tempfile has a path.
      # nil if the tempfile does not have a path.
      def path: () -> (untyped | nil)

      alias local_path path

      # Return true if the tempfile responds to the method.
      def respond_to_missing?: (*untyped args) -> (false | true)

      # Delegate method missing calls to the tempfile.
      def method_missing: (untyped method_name, *untyped args) { (?) -> untyped } -> untyped
    end
  end
end

module ::Rack
  class ::Rack::NullLogger
    def initialize: (untyped app) -> void

    def call: (untyped env) -> untyped

    def info: (?untyped? progname) { (?) -> untyped } -> nil

    def debug: (?untyped? progname) { (?) -> untyped } -> nil

    def warn: (?untyped? progname) { (?) -> untyped } -> nil

    def error: (?untyped? progname) { (?) -> untyped } -> nil

    def fatal: (?untyped? progname) { (?) -> untyped } -> nil

    def unknown: (?untyped? progname) { (?) -> untyped } -> nil

    def info?: () -> nil

    def debug?: () -> nil

    def warn?: () -> nil

    def error?: () -> nil

    def fatal?: () -> nil

    def debug!: () -> nil

    def error!: () -> nil

    def fatal!: () -> nil

    def info!: () -> nil

    def warn!: () -> nil

    def level: () -> nil

    def progname: () -> nil

    def datetime_format: () -> nil

    def formatter: () -> nil

    def sev_threshold: () -> nil

    def level=: (untyped level) -> nil

    def progname=: (untyped progname) -> nil

    def datetime_format=: (untyped datetime_format) -> nil

    def formatter=: (untyped formatter) -> nil

    def sev_threshold=: (untyped sev_threshold) -> nil

    def close: () -> nil

    def add: (untyped severity, ?untyped? message, ?untyped? progname) { (?) -> untyped } -> nil

    def log: (untyped severity, ?untyped? message, ?untyped? progname) { (?) -> untyped } -> nil

    def <<: (untyped msg) -> nil

    def reopen: (?untyped? logdev) -> nil
  end
end

module ::Rack
  class ::Rack::QueryParser
    ::Rack::QueryParser::DEFAULT_SEP: ::Regexp

    ::Rack::QueryParser::COMMON_SEP: { ";" => ::Regexp, ";," => ::Regexp, "&" => ::Regexp }

    # ParameterTypeError is the error that is raised when incoming structural
    # parameters (parsed by parse_nested_query) contain conflicting types.
    class ::Rack::QueryParser::ParameterTypeError < ::TypeError
      include ::Rack::BadRequest
    end

    # InvalidParameterError is the error that is raised when incoming structural
    # parameters (parsed by parse_nested_query) contain invalid format or byte
    # sequence.
    class ::Rack::QueryParser::InvalidParameterError < ::ArgumentError
      include ::Rack::BadRequest
    end

    # QueryLimitError is for errors raised when the query provided exceeds one
    # of the query parser limits.
    class ::Rack::QueryParser::QueryLimitError < ::RangeError
      include ::Rack::BadRequest
    end

    # ParamsTooDeepError is the old name for the error that is raised when params
    # are recursively nested over the specified limit. Make it the same as
    # as QueryLimitError, so that code that rescues ParamsTooDeepError error
    # to handle bad query strings also now handles other limits.
    ::Rack::QueryParser::ParamsTooDeepError: untyped

    def self.make_default: (untyped param_depth_limit, **untyped options) -> ::Rack::QueryParser

    attr_reader param_depth_limit: untyped

    ::Rack::QueryParser::BYTESIZE_LIMIT: untyped

    ::Rack::QueryParser::PARAMS_LIMIT: untyped

    attr_reader bytesize_limit: untyped

    def initialize: (untyped params_class, untyped param_depth_limit, ?bytesize_limit: untyped, ?params_limit: untyped) -> void

    # Stolen from Mongrel, with some small modifications:
    # Parses a query string by breaking it up at the '&'.  You can also use this
    # to parse cookies by changing the characters used in the second parameter
    # (which defaults to '&').
    def parse_query: (untyped qs, ?untyped? separator) { (?) -> untyped } -> untyped

    # Parses a query string by breaking it up at the '&', returning all key-value
    # pairs as an array of [key, value] arrays. Unlike parse_query, this preserves
    # all duplicate keys rather than collapsing them.
    def parse_query_pairs: (untyped qs, ?untyped? separator) -> ::Array[untyped]

    # parse_nested_query expands a query string into structural types. Supported
    # types are Arrays, Hashes and basic value types. It is possible to supply
    # query strings with parameters of conflicting types, in this case a
    # ParameterTypeError is raised. Users are encouraged to return a 400 in this
    # case.
    def parse_nested_query: (untyped qs, ?untyped? separator) -> untyped

    # normalize_params recursively expands parameters into structural types. If
    # the structural types represented by two different parameter names are in
    # conflict, a ParameterTypeError is raised.  The depth argument is deprecated
    # and should no longer be used, it is kept for backwards compatibility with
    # earlier versions of rack.
    def normalize_params: (untyped params, untyped name, untyped v, ?untyped? _depth) -> untyped

    private

    def _normalize_params: (untyped params, untyped name, untyped v, untyped depth) -> (nil | ::Array[untyped] | untyped)

    public

    def make_params: () -> untyped

    def new_depth_limit: (untyped param_depth_limit) -> ::Rack::QueryParser

    private

    def params_hash_type?: (untyped obj) -> (false | true)

    def params_hash_has_key?: (untyped hash, untyped key) -> (false | true)

    def each_query_pair: (untyped qs, untyped separator, ?untyped? unescaper) { (untyped, untyped) -> untyped } -> untyped

    def unescape: (untyped string, ?untyped encoding) -> ::String

    class ::Rack::QueryParser::Params < ::Hash[untyped, untyped]
      def to_params_hash: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped
    end
  end
end

module ::Rack
  class ::Rack::ForwardRequest < ::Exception
    attr_reader url: untyped

    attr_reader env: untyped

    def initialize: (untyped url, ?::Hash[untyped, untyped] env) -> void
  end

  class ::Rack::Recursive
    def initialize: (untyped app) -> void

    def call: (untyped env) -> untyped

    def _call: (untyped env) -> untyped

