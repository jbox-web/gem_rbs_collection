    # multipart_part_limit is the original name of multipart_file_limit, but
    # the limit only counts parts with filenames.
    alias self.multipart_part_limit self.multipart_file_limit

    def self.multipart_part_limit=: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped

    def self.param_depth_limit: () -> untyped

    def self.param_depth_limit=: (untyped v) -> untyped

