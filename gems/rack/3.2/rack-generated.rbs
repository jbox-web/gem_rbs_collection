    ::Rack::Utils::SYMBOL_TO_STATUS_CODE: untyped

    ::Rack::Utils::OBSOLETE_SYMBOLS_TO_STATUS_CODES: { payload_too_large: 413, unprocessable_entity: 422, bandwidth_limit_exceeded: 509, not_extended: 510 }

    ::Rack::Utils::OBSOLETE_SYMBOL_MAPPINGS: { payload_too_large: :content_too_large, unprocessable_entity: :unprocessable_content }

    def self?.status_code: (untyped status) -> untyped

