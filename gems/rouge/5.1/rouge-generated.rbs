module ::Rouge
  # @abstract
  # A stateful lexer that uses sets of regular expressions to
  # tokenize a string.  Most lexers are instances of RegexLexer.
  class ::Rouge::RegexLexer < ::Rouge::Lexer
    class ::Rouge::RegexLexer::InvalidRegex < ::StandardError
      def initialize: (untyped re) -> void

      def to_s: () -> ::String
    end

    class ::Rouge::RegexLexer::ClosedState < ::StandardError
      attr_reader state: untyped

      def initialize: (untyped state) -> void

      def rule: () -> untyped

      def to_s: () -> ::String
    end

    # exception class for fallthrough - using an exception is slightly faster
    # than catch { ... }, but it is not semantically an error that should be
    # rescued from.
    class ::Rouge::RegexLexer::Fallthrough < ::Exception
    end

    # A rule is a tuple of a regular expression to test, and a callback
    # to perform if the test succeeds.
    #
    # @see StateDSL#rule
    class ::Rouge::RegexLexer::Rule
      attr_reader callback: untyped

      attr_reader re: untyped

      def initialize: (untyped re, untyped callback) -> void

      def inspect: () -> ::String
    end

    # a State is a named set of rules that can be tested for or
    # mixed in.
    #
    # @see RegexLexer.state
    class ::Rouge::RegexLexer::State
      attr_reader name: untyped

      attr_reader rules: untyped

      def initialize: (untyped name, untyped rules) -> void

      def inspect: () -> ::String
    end

    class ::Rouge::RegexLexer::StateDSL
      attr_reader rules: untyped

      attr_reader name: untyped

      def initialize: (untyped name) { (?) -> untyped } -> void

      def to_state: (untyped lexer_class) -> ::Rouge::RegexLexer::State

      def prepended: () { (?) -> untyped } -> ::Rouge::RegexLexer::StateDSL

      def appended: () { (?) -> untyped } -> ::Rouge::RegexLexer::StateDSL

      # Define a new rule for this state.
      #
      # @overload rule(re, token, next_state=nil)
      # @overload rule(re, &callback)
      #
      # @param [Regexp] re
      #   a regular expression for this rule to test.
      # @param [String] tok
      #   the token type to yield if `re` matches.
      # @param [#to_s] next_state
      #   (optional) a state to push onto the stack if `re` matches.
      #   If `next_state` is `:pop!`, the state stack will be popped
      #   instead.
      # @param [Proc] callback
      #   a block that will be evaluated in the context of the lexer
      #   if `re` matches.  This block has access to a number of lexer
      #   methods, including {RegexLexer#push}, {RegexLexer#pop!},
      #   {RegexLexer#token}, and {RegexLexer#delegate}.  The first
      #   argument can be used to access the match groups.
      def rule: (untyped re, ?untyped? tok, ?untyped? next_state) ?{ (?) -> untyped } -> (nil | true)

      def context_sensitive?: (untyped re) -> (true | false)

      def close!: () -> true

      # Mix in the rules from another state into this state.  The rules
      # from the mixed-in state will be tried in order before moving on
      # to the rest of the rules in this state.
      def mixin: (untyped state) -> untyped

      private

      def load!: () -> (nil | untyped)
    end

    # The states hash for this lexer.
    # @see state
    def self.states: () -> ::Hash[untyped, untyped]

    def self.state_definitions: () -> untyped

    def self.replace_state: (untyped name, untyped new_defn) -> untyped

    # The routines to run at the beginning of a fresh lex.
    # @see start
    def self.start_procs: () -> untyped

    # Specify an action to be run every fresh lex.
    #
    # @example
    #   start { puts "I'm lexing a new string!" }
    def self.start: () { (?) -> untyped } -> untyped

    # Define a new state for this lexer with the given name.
    # The block will be evaluated in the context of a {StateDSL}.
    def self.state: (untyped name) { (?) -> untyped } -> ::Rouge::RegexLexer::StateDSL

    def self.prepend: (untyped name) { (?) -> untyped } -> untyped

    def self.append: (untyped name) { (?) -> untyped } -> untyped

    # @private
    def self.get_state: (untyped name) -> untyped

    def inspect_details: () { (untyped) -> untyped } -> untyped

    # @private
    def get_state: (untyped state_name) -> untyped

    # The state stack.  This is initially the single state `[:root]`.
    # It is an error for this stack to be empty.
    # @see #state
    def stack: () -> [ untyped ]

    # The current state - i.e. one on top of the state stack.
    #
    # NB: if the state stack is empty, this will throw an error rather
    # than returning nil.
    def state: () -> untyped

    # reset this lexer to its initial state.  This runs all of the
    # start_procs.
    def reset!: () -> untyped

    # This implements the lexer protocol, by yielding [token, value] pairs.
    #
    # The process for lexing works as follows, until the stream is empty:
    #
    # 1. We look at the state on top of the stack (which by default is
    #    `[:root]`).
    # 2. Each rule in that state is tried until one is successful.  If one
    #    is found, that rule's callback is evaluated - which may yield
    #    tokens and manipulate the state stack.  Otherwise, one character
    #    is consumed with an `'Error'` token, and we continue at (1.)
    #
    # @see #step #step (where (2.) is implemented)
    def stream_tokens: (untyped str) { (untyped, untyped) -> untyped } -> nil

    # The number of successive scans permitted without consuming
    # the input stream.  If this is exceeded, the match fails.
    ::Rouge::RegexLexer::MAX_NULL_SCANS: 5

    # Runs one step of the lex.  Rules in the current state are tried
    # until one matches, at which point its callback is called.
    #
    # @return true if a rule was tried successfully
    # @return false otherwise.
    def step: (untyped state, untyped stream) -> (true | false)

    # Yield a token.
    #
    # @param tok
    #   the token type
    # @param val
    #   (optional) the string value to yield.  If absent, this defaults
    #   to the entire last match.
    def token: (untyped tok, ?untyped val) -> untyped

    # @deprecated
    #
    # Yield a token with the next matched group.  Subsequent calls
    # to this method will yield subsequent groups.
    def group: (untyped tok) -> bot

    # Yield tokens corresponding to the matched groups of the current
    # match.
    def groups: (*untyped tokens) -> untyped

    # Delegate the lex to another lexer. We use the `continue_lex` method
    # so that #reset! will not be called.  In this way, a single lexer
    # can be repeatedly delegated to while maintaining its own internal
    # state stack.
    #
    # @param [#lex] lexer
    #   The lexer or lexer class to delegate to
    # @param [String] text
    #   The text to delegate.  This defaults to the last matched string.
    def delegate: (untyped lexer, ?untyped? text) -> untyped

    # Re-lexes the given text (or the most recently matched string if
    # none is given) with the current lexer.
    def recurse: (?untyped? text) -> untyped

    # Breaks out of the current rule block and continues to match later
    # rules, as if the current regex had not matched. Does not affect
    # the stack.
    def fallthrough!: () -> bot

    # Push a state onto the stack.  If no state name is given and you've
    # passed a block, a state will be dynamically created using the
    # {StateDSL}.
    def push: (?untyped? state_name) ?{ (?) -> untyped } -> untyped

    # Pop the state stack.  If a number is passed in, it will be popped
    # that number of times.
    def pop!: (?::Integer times) -> nil

    # replace the head of the stack with the given state
    def goto: (untyped state_name) -> untyped

    # reset the stack back to `[:root]`.
    def reset_stack: () -> untyped

    # Check if `state_name` is in the state stack.
    def in_state?: (untyped state_name) -> untyped

    # Check if `state_name` is the state on top of the state stack.
    def state?: (untyped state_name) -> untyped

    private

    def yield_token: (untyped tok, untyped val) -> (nil | untyped)
  end
end

module ::Rouge
  # @abstract
  # A TemplateLexer is one that accepts a :parent option, to specify
  # which language is being templated.  The lexer class can specify its
  # own default for the parent lexer, which is otherwise defaulted to
  # HTML.
  class ::Rouge::TemplateLexer < ::Rouge::RegexLexer
    # the parent lexer - the one being templated.
    def parent: () -> untyped
  end
end

module ::Rouge
  class ::Rouge::TexThemeRenderer
    def initialize: (untyped theme, ?::Hash[untyped, untyped] opts) -> void

    # Our general strategy is this:
    #
    # * First, define the \RG{tokname}{content} command, which will
    #   expand into \RG@tok@tokname{content}. We use \csname...\endcsname
    #   to interpolate into a command.
    #
    # * Define the default RG* environment, which will enclose the whole
    #   thing. By default this will simply set \ttfamily (select monospace font)
    #   but it can be overridden with \renewcommand by the user to be
    #   any other formatting.
    #
    # * Define all the colors using xcolors \definecolor command. First we define
    #   every palette color with a name such as RG@palette@themneame@colorname.
    #   Then we find all foreground and background colors that have literal html
    #   colors embedded in them and define them with names such as
    #   RG@palette@themename@000000. While html allows three-letter colors such
    #   as #FFF, xcolor requires all six characters to be present, so we make sure
    #   to normalize that as well as the case convention in #inline_name.
    #
    # * Define the token commands RG@tok@xx. These will take the content as the
    #   argument and format it according to the theme, referring to the color
    #   in the palette.
    def render: () { (untyped) -> untyped } -> untyped

    def render_palette: (untyped palette) { (untyped) -> untyped } -> untyped

    def render_inline_pallete: (untyped style) { (?) -> untyped } -> untyped

    def inline_name: (untyped color) -> (nil | untyped)

    def gen_inline: (untyped name) { (untyped) -> untyped } -> (nil | untyped)

    def camelize: (untyped name) -> untyped

    def palette_name: (untyped name) -> ::String

    def token_name: (untyped tok) -> ::String

    def render_blank: (untyped tok) { (?) -> untyped } -> ::String

    def render_style: (untyped tok, untyped style) { (untyped) -> untyped } -> untyped
  end
end

module ::Rouge
  class ::Rouge::TextAnalyzer < ::String
    # Find a shebang.  Returns nil if no shebang is present.
    def shebang: () -> (::String | nil)

    # Check if the given shebang is present.
    #
    # This normalizes things so that `text.shebang?('bash')` will detect
    # `#!/bash`, '#!/bin/bash', '#!/usr/bin/env bash', and '#!/bin/bash -x'
    def shebang?: (untyped match) -> (false | untyped)

    # Return the contents of the doctype tag if present, nil otherwise.
    def doctype: () -> (::String | nil)

    # Check if the doctype matches a given regexp or string
    def doctype?: (?untyped type) -> untyped

    # Return true if the result of lexing with the given lexer contains no
    # error tokens.
    def lexes_cleanly?: (untyped lexer) -> (false | true)
  end
end

module ::Rouge
  class ::Rouge::Theme
    include ::Rouge::Token::Tokens

    class ::Rouge::Theme::Style < ::Hash[untyped, untyped]
      def initialize: (untyped theme, ?::Hash[untyped, untyped] hsh) -> void

      def render: (untyped selector) ?{ (untyped) -> untyped } -> (untyped | nil)

      def rendered_rules: () ?{ (untyped) -> untyped } -> untyped
    end

    def styles: () -> untyped

    def self.palette: (?::Hash[untyped, untyped] arg) -> untyped

    def palette: (*untyped a) -> untyped

    def self.styles: () -> untyped

    def self.render: (?::Hash[untyped, untyped] opts) { (?) -> untyped } -> untyped

    def get_own_style: (untyped token) -> (::Rouge::Theme::Style | nil)

    def get_style: (untyped token) -> (::Rouge::Theme::Style | nil)

    def name: () -> ::String

    def self.style: (*untyped tokens) -> untyped

    def self.get_own_style: (untyped token) -> (untyped | nil)

    def self.get_style: (untyped token) -> (::Rouge::Theme::Style | nil)

    def self.base_style: () -> (::Rouge::Theme::Style | nil)

    def self.name: (?untyped? n) -> untyped

    def self.register: (untyped name) -> singleton(::Rouge::Theme)

    def self.find: (untyped n) -> untyped

    def self.registry: () -> ::Hash[untyped, untyped]
  end

  module ::Rouge::HasModes
    def mode: (?::Symbol arg) -> untyped

    def get_mode: (untyped mode) -> (self | untyped)

    def set_mode!: (untyped mode) -> untyped

    def mode!: (untyped arg) -> untyped
  end

  class ::Rouge::CSSTheme < ::Rouge::Theme
    def initialize: (?::Hash[untyped, untyped] opts) -> void

    def render: () ?{ (untyped) -> untyped } -> untyped

    def render_base: (untyped selector) { (?) -> untyped } -> untyped

    def style_for: (untyped tok) -> (::Rouge::Theme::Style | nil)

    private

    def css_selector: (untyped token) -> untyped

    def single_css_selector: (untyped token) -> (untyped | ::String)

    # yield all of the tokens that should be styled the same
    # as the given token.  Essentially this recursively all of
    # the subtokens, except those which are more specifically
    # styled.
    def inflate_token: (untyped tok) ?{ (untyped) -> untyped } -> untyped
  end
end

