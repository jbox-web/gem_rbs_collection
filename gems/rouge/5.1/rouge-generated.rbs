    def self.qualname: () -> untyped

    def self.register!: () -> singleton(::Rouge::Token)

    def self.make_token: (untyped name, untyped shortname) { (?) -> untyped } -> singleton(::Rouge::Token)

    def self.token: (untyped name, untyped shortname) { (?) -> untyped } -> untyped

