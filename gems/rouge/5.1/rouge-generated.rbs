    # Specify or get this lexer's title. Meant to be human-readable.
    def self.title: (?untyped? t) -> untyped

    # Specify or get this lexer's description.
    def self.desc: (?::Symbol arg) -> untyped

    def self.option_docs: () -> untyped

    def self.option: (untyped name, untyped desc) -> untyped

