    # @return a list of all lexers.
    def self.all: () -> untyped

    # Guess which lexer to use based on a hash of info.
    #
    # This accepts the same arguments as Lexer.guess, but will never throw
    # an error.  It will return a (possibly empty) list of potential lexers
    # to use.
    def self.guesses: (?::Hash[untyped, untyped] info) -> untyped

    # Guess which lexer to use based on a hash of info.
    #
    # @option info :mimetype
    #   A mimetype to guess by
    # @option info :filename
    #   A filename to guess by
    # @option info :source
    #   The source itself, which, if guessing by mimetype or filename
    #   fails, will be searched for shebangs, <!DOCTYPE ...> tags, and
    #   other hints.
    # @param [Proc] fallback called if multiple lexers are detected.
    #   If omitted, Guesser::Ambiguous is raised.
    #
    # @see Lexer.detect?
    # @see Lexer.guesses
    # @return [Class<Rouge::Lexer>]
    def self.guess: (?::Hash[untyped, untyped] info) ?{ (untyped) -> untyped } -> untyped

    def self.guess_by_mimetype: (untyped mt) -> untyped

    def self.guess_by_filename: (untyped fname) -> untyped

    def self.guess_by_source: (untyped source) -> untyped

    def self.enable_debug!: () -> true

    def self.disable_debug!: () -> (untyped | nil)

    def self.debug_enabled?: () -> (true | false)

    # Determine if a lexer has a method named +:detect?+ defined in its
    # singleton class.
    def self.detectable?: () -> untyped

    # @private
    def self.register: (untyped name, untyped lexer) -> untyped

    def self.lazy_procs: () -> ::Array[untyped]

    def self.eager_load!: () -> (nil | self)

    def self.lazy: (?auto: bool) { (?) -> untyped } -> untyped

    def self.skip_auto_load?: () -> (true | untyped | false)

    # Used to specify or get the canonical name of this lexer class.
    #
    # @example
    #   class MyLexer < Lexer
    #     tag 'foo'
    #   end
    #
    #   MyLexer.tag # => 'foo'
    #
    #   Lexer.find('foo') # => MyLexer
    def self.tag: (?untyped? t) -> untyped

    # Used to specify alternate names this lexer class may be found by.
    #
    # @example
    #   class Erb < Lexer
    #     tag 'erb'
    #     aliases 'eruby', 'rhtml'
    #   end
    #
    #   Lexer.find('eruby') # => Erb
    def self.aliases: (*untyped args) -> ::Array[untyped]

    # Specify a list of filename globs associated with this lexer.
    #
    # If a filename glob is associated with more than one lexer, this can
    # cause a Guesser::Ambiguous error to be raised in various guessing
    # methods. These errors can be avoided by disambiguation. Filename globs
    # are disambiguated in one of two ways. Either the lexer will define a
    # `self.detect?` method (intended for use with shebangs and doctypes) or a
    # manual rule will be specified in Guessers::Disambiguation.
    #
    # @example
    #   class Ruby < Lexer
    #     filenames '*.rb', '*.ruby', 'Gemfile', 'Rakefile'
    #   end
    def self.filenames: (*untyped fnames) -> ::Array[untyped]

    # Specify a list of mimetypes associated with this lexer.
    #
    # @example
    #   class Html < Lexer
    #     mimetypes 'text/html', 'application/xhtml+xml'
    #   end
    def self.mimetypes: (*untyped mts) -> ::Array[untyped]

    # @private
    def self.assert_utf8!: (untyped str) -> (nil | untyped)

    private

    def self.registry: () -> ::Hash[untyped, untyped]

    public

    attr_reader options: untyped

    # Create a new lexer with the given options.  Individual lexers may
    # specify extra options.  The only current globally accepted option
    # is `:debug`.
    #
    # @option opts :debug
    #   Prints debug information to stdout.  The particular info depends
    #   on the lexer in question.  In regex lexers, this will log the
    #   state stack at the beginning of each step, along with each regex
    #   tried and each stream consumed.  Try it, it's pretty useful.
    def initialize: (?::Hash[untyped, untyped] opts) -> void

    def inspect: () -> ::String

    def inspect_parts: () { (untyped, untyped, untyped) -> untyped } -> untyped

    def inspect_details: () -> nil

    def eager_load!: () -> (nil | singleton(::Rouge::Lexer))

    # Returns a new lexer with the given options set. Useful for e.g. setting
    # debug flags post hoc, or providing global overrides for certain options
    def with: (?::Hash[untyped, untyped] opts) -> ::Rouge::Lexer

    def as_bool: (untyped val) -> (false | true)

    def as_string: (untyped val) -> untyped

    def as_list: (untyped val) -> (::Array[untyped] | ::Array[::String] | ::Array[untyped])

    def as_lexer: (untyped val) -> untyped

    def as_token: (untyped val) -> untyped

    def bool_option: (untyped name) ?{ () -> untyped } -> untyped

    def string_option: (untyped name) { (?) -> untyped } -> untyped

    def lexer_option: (untyped name) { (?) -> untyped } -> untyped

    def list_option: (untyped name) { (?) -> untyped } -> (::Array[untyped] | ::Array[::String] | ::Array[untyped])

    def token_option: (untyped name) { (?) -> untyped } -> untyped

    def hash_option: (untyped name, untyped defaults) { (untyped) -> untyped } -> untyped

    # @abstract
    #
    # Called after each lex is finished.  The default implementation
    # is a noop.
    def reset!: () -> nil

    # Given a string, yield [token, chunk] pairs.  If no block is given,
    # an enumerator is returned.
    #
    # @option opts :continue
    #   Continue the lex from the previous state (i.e. don't call #reset!)
    #
    # @note The use of :continue => true has been deprecated. A warning is
    #       issued if run with `$VERBOSE` set to true.
    #
    # @note The use of arbitrary `opts` has never been supported, but we
    #       previously ignored them with no error. We now warn unconditionally.
    def lex: (untyped string, ?untyped? opts) ?{ (?) -> untyped } -> untyped

    # Continue the lex from the the current state without resetting
    def continue_lex: (untyped string) ?{ (untyped, untyped) -> untyped } -> untyped

    # delegated to {Lexer.tag}
    def tag: () -> untyped

    # @abstract
    #
    # Yield `[token, chunk]` pairs, given a prepared input stream.  This
    # must be implemented.
    #
    # @param [StringScanner] stream
    #   the stream
    def stream_tokens: (untyped stream) { (?) -> untyped } -> untyped

    # @abstract
    #
    # Return true if there is an in-text indication (such as a shebang
    # or DOCTYPE declaration) that this lexer should be used.
    #
    # @param [TextAnalyzer] text
    #   the text to be analyzed, with a couple of handy methods on it,
    #   like {TextAnalyzer#shebang?} and {TextAnalyzer#doctype?}
    def self.detect?: (untyped text) -> false
  end

  # container module for built-in lexers
  module ::Rouge::Lexers
  end
end

