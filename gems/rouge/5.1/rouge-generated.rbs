module ::Rouge
  class ::Rouge::InheritableHash < ::Hash[untyped, untyped]
    def initialize: (?untyped? parent) -> void

    def []: (untyped k) -> untyped

    def parent: () -> untyped

    def include?: (untyped k) -> untyped

    def each: () { (untyped, untyped) -> untyped } -> untyped

    alias own_keys keys

    def keys: () -> untyped
  end

  class ::Rouge::InheritableList
    include ::Enumerable[untyped]

    def initialize: (?untyped? parent) -> void

    def parent: () -> untyped

    def each: () ?{ (?) -> untyped } -> untyped

    def own_entries: () -> ::Array[untyped]

    def push: (untyped o) -> untyped

    alias << push
  end

  # shared methods for some indentation-sensitive lexers
  module ::Rouge::Indentation
    def reset!: () -> nil

    # push a state for the next indented block
    def starts_block: (untyped block_state) -> nil

    # handle a single indented line
    def indentation: (untyped indent_str) -> untyped
  end
end

