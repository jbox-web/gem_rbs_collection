    class ::Rouge::Lexers::Haml < ::Rouge::RegexLexer
      include ::Rouge::Indentation

      attr_reader filters: untyped

      # @option opts :filters
      #   A hash of filter name to lexer of how various filters should be
      #   highlighted.  By default, :javascript, :css, :ruby, and :erb
      #   are supported.
