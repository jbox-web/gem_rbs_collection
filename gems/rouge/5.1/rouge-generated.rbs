module ::RuboCop
  module ::RuboCop::Cop
    module ::RuboCop::Cop::Rouge
      # Checks for the use of `.join('|')` or `Regexp.union` inside
      # interpolated regular expressions.
      #
      # Building alternation patterns by joining arrays or using
      # `Regexp.union` inside a regexp harms performance — the regex
      # engine must backtrack through every alternative on each match
      # attempt. It also risks quoting bugs when values contain regex
      # metacharacters.
      #
      # Prefer a `Set` lookup with a simple regex pattern instead.
      #
      # @example
      #   # bad — joins an array into a huge alternation regex
      #   KEYWORDS = %w[if else while ...]
      #   rule %r/\b(#{KEYWORDS.join('|')})\b/, Keyword
      #
      #   # bad — Regexp.union inside a regex has the same problem
      #   rule %r/#{Regexp.union(keywords)}/
      #
      #   # good — simple regex + Set lookup
      #   KEYWORDS = Set.new(%w[if else while ...])
      #   rule %r/\w+/ do |m|
      #     if KEYWORDS.include?(m[0])
      #       token Keyword
      #     else
      #       token Name
      #     end
      #   end
      #
      class ::RuboCop::Cop::Rouge::NoBuildingAlternationPatternInRegexp
        ::RuboCop::Cop::Rouge::NoBuildingAlternationPatternInRegexp::MSG: "Avoid building alternation patterns inside a regexp. Use a Set lookup with a simple regex pattern for performance."

        def on_regexp: (untyped node) -> untyped

        private

        def find_offending_calls: (untyped begin_node) -> untyped
      end
    end
  end
end

module ::RuboCop
  module ::RuboCop::Cop
    module ::RuboCop::Cop::Rouge
      class ::RuboCop::Cop::Rouge::NoHugeCollections
        ::RuboCop::Cop::Rouge::NoHugeCollections::MSG: "Avoid collections of over 300 elements. Place those in a lazy-loaded file, ideally generated by a Rake task from the relevant documentation."

        ::RuboCop::Cop::Rouge::NoHugeCollections::RESTRICT_ON_SEND: ::Array[:[]]

        ::RuboCop::Cop::Rouge::NoHugeCollections::MAX_SIZE: 300

        def on_send: (untyped node) -> (nil | untyped)

        def on_array: (untyped node) -> (untyped | nil)
      end
    end
  end
