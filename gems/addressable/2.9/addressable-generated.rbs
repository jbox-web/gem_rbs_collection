    def normalized_site: () -> (nil | untyped)

    #
    # Sets the site value for this URI.
    #
    # @param [String, #to_str] new_site The new site value.
    def site=: (untyped new_site) -> untyped

    #
    # The path component for this URI.
    #
    # @return [String] The path component.
    attr_reader path: untyped

    ::Addressable::URI::NORMPATH: ::Regexp

    #
    # The path component for this URI, normalized.
    #
    # @return [String] The path component, normalized.
    def normalized_path: () -> untyped

    #
    # Sets the path component for this URI.
    #
    # @param [String, #to_str] new_path The new path component.
    def path=: (untyped new_path) -> nil

    #
    # The basename, if any, of the file in the path component.
    #
    # @return [String] The path's basename.
    def basename: () -> ::String

    #
    # The extname, if any, of the file in the path component.
    # Empty string if there is no extension.
    #
    # @return [String] The path's extname.
    def extname: () -> (nil | untyped)

    #
    # The query component for this URI.
    #
    # @return [String] The query component.
    attr_reader query: untyped

    #
    # The query component for this URI, normalized.
    #
    # @return [String] The query component, normalized.
    def normalized_query: (*untyped flags) -> (nil | untyped)

    #
    # Sets the query component for this URI.
    #
    # @param [String, #to_str] new_query The new query component.
    def query=: (untyped new_query) -> nil

    #
    # Converts the query component to a Hash value.
    #
    # @param [Class] return_type The return type desired. Value must be either
    #   `Hash` or `Array`.
    #
    # @return [Hash, Array, nil] The query string parsed as a Hash or Array
    #   or nil if the query string is blank.
    #
    # @example
    #   Addressable::URI.parse("?one=1&two=2&three=3").query_values
    #   #=> {"one" => "1", "two" => "2", "three" => "3"}
    #   Addressable::URI.parse("?one=two&one=three").query_values(Array)
    #   #=> [["one", "two"], ["one", "three"]]
    #   Addressable::URI.parse("?one=two&one=three").query_values(Hash)
    #   #=> {"one" => "three"}
