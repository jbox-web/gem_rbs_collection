class ::Thor
  class ::Thor::Arguments
    ::Thor::Arguments::NUMERIC: ::Regexp

    # Receives an array of args and returns two arrays, one with arguments
    # and one with switches.
    #
    def self.split: (untyped args) -> ::Array[untyped]

    def self.parse: (*untyped args) -> untyped

    # Takes an array of Thor::Argument objects.
    #
    def initialize: (?untyped arguments) -> void

    def parse: (untyped args) -> untyped

    def remaining: () -> untyped

    private

    def no_or_skip?: (untyped arg) -> (::String | nil)

    def last?: () -> untyped

    def peek: () -> untyped

    def shift: () -> untyped

    def unshift: (untyped arg) -> untyped

    def current_is_value?: () -> untyped

    # Runs through the argument array getting strings that contains ":" and
    # mark it as a hash:
    #
    #   [ "name:string", "age:integer" ]
    #
    # Becomes:
    #
    #   { "name" => "string", "age" => "integer" }
    #
    def parse_hash: (untyped name) -> untyped

    # Runs through the argument array getting all strings until no string is
    # found or a switch is found.
    #
    #   ["a", "b", "c"]
    #
    # And returns it as an array:
    #
    #   ["a", "b", "c"]
    #
    def parse_array: (untyped name) -> untyped

    # Check if the peek is numeric format and return a Float or Integer.
    # Check if the peek is included in enum if enum is provided.
    # Otherwise raises an error.
    #
    def parse_numeric: (untyped name) -> untyped

    # Parse string:
    # for --string-arg, just return the current value in the pile
    # for --no-string-arg, nil
    # Check if the peek is included in enum if enum is provided. Otherwise raises an error.
    #
    def parse_string: (untyped name) -> (nil | untyped)

    # Raises an error if the switch is an enum and the values aren't included on it.
    #
    def validate_enum_value!: (untyped name, untyped value, untyped message) -> (nil | untyped)

    # Raises an error if @non_assigned_required array is not empty.
    #
    def check_requirement!: () -> (nil | untyped)
  end
end

class ::Thor
  class ::Thor::Option < ::Thor::Argument
    attr_reader aliases: untyped

    attr_reader group: untyped

    attr_reader lazy_default: untyped

    attr_reader hide: untyped

    attr_reader repeatable: untyped

    ::Thor::Option::VALID_TYPES: ::Array[:boolean | :numeric | :hash | :array | :string]

    def initialize: (untyped name, ?::Hash[untyped, untyped] options) -> void

    # This parse quick options given as method_options. It makes several
    # assumptions, but you can be more specific using the option method.
    #
    #   parse :foo => "bar"
    #   #=> Option foo with default value bar
    #
    #   parse [:foo, :baz] => "bar"
    #   #=> Option foo with default value bar and alias :baz
    #
    #   parse :foo => :required
    #   #=> Required option foo without default value
    #
    #   parse :foo => 2
    #   #=> Option foo with default value 2 and type numeric
    #
    #   parse :foo => :numeric
    #   #=> Option foo without default value and type numeric
    #
    #   parse :foo => true
    #   #=> Option foo with default value true and type boolean
    #
    # The valid types are :boolean, :numeric, :hash, :array and :string. If none
    # is given a default type is assumed. This default type accepts arguments as
    # string (--foo=value) or booleans (just --foo).
    #
    # By default all options are optional, unless :required is given.
    #
    def self.parse: (untyped key, untyped value) -> ::Thor::Option

    def switch_name: () -> untyped

    def human_name: () -> untyped

    def usage: (?::Integer padding) -> ::String

    def aliases_for_usage: () -> ("" | ::String)

    def show_default?: () -> untyped

    def validate!: () -> untyped

    def validate_default_type!: () -> (nil | untyped)

    def dasherized?: () -> untyped

    def undasherize: (untyped str) -> untyped

    def dasherize: (untyped str) -> ::String

    private

    def normalize_aliases: (untyped aliases) -> untyped
  end
end

class ::Thor
  class ::Thor::Options < ::Thor::Arguments
    ::Thor::Options::LONG_RE: ::Regexp

    ::Thor::Options::SHORT_RE: ::Regexp

    ::Thor::Options::EQ_RE: ::Regexp

    ::Thor::Options::SHORT_SQ_RE: ::Regexp

    ::Thor::Options::SHORT_NUM: ::Regexp

    ::Thor::Options::OPTS_END: "--"

    # Receives a hash and makes it switches.
    def self.to_switches: (untyped options) -> untyped

    # Takes a hash of Thor::Option and a hash with defaults.
    #
    # If +stop_on_unknown+ is true, #parse will stop as soon as it encounters
    # an unknown option or a regular argument.
    def initialize: (?::Hash[untyped, untyped] hash_options, ?::Hash[untyped, untyped] defaults, ?bool stop_on_unknown, ?bool disable_required_check, ?::Hash[untyped, untyped] relations) -> void

    def remaining: () -> ::Array[untyped]

    def peek: () -> untyped

    def shift: () -> untyped

    def unshift: (untyped arg, ?is_value: bool) -> untyped

    def parse: (untyped args) -> untyped

    def check_exclusive!: () -> nil

    def check_at_least_one!: () -> nil

    def check_unknown!: () -> nil

    # Option names changes to swith name or human name
    def names_to_switch_names: (?untyped names) -> ::Array[untyped]

    def assign_result!: (untyped option, untyped result) -> untyped

    # Check if the current value in peek is a registered switch.
    #
    # Two booleans are returned.  The first is true if the current value
    # starts with a hyphen; the second is true if it is a registered switch.
    def current_is_switch?: () -> (::Array[false] | untyped)

    def current_is_switch_formatted?: () -> (false | untyped)

    def current_is_value?: () -> (true | untyped)

    def switch?: (untyped arg) -> (false | true)

    def switch_option: (untyped arg) -> untyped

    # Check if the given argument is actually a shortcut.
    #
    def normalize_switch: (untyped arg) -> untyped

    def parsing_options?: () -> (false | nil | true)

    # Parse boolean values which can be given as --foo=true or --foo for true values, or
    # --foo=false, --no-foo or --skip-foo for false values.
    #
    def parse_boolean: (untyped switch) -> (true | false | untyped | untyped)

    # Parse the value at the peek analyzing if it requires an input or not.
    #
    def parse_peek: (untyped switch, untyped option) -> (nil | untyped)
  end
end

class ::Thor
  # Adds a compatibility layer to your Thor classes which allows you to use
  # rake package tasks. For example, to use rspec rake tasks, one can do:
  #
  #   require 'thor/rake_compat'
  #   require 'rspec/core/rake_task'
  #
  #   class Default < Thor
  #     include Thor::RakeCompat
  #
  #     RSpec::Core::RakeTask.new(:spec) do |t|
  #       t.spec_opts = ['--options', './.rspec']
  #       t.spec_files = FileList['spec/**/*_spec.rb']
  #     end
  #   end
  #
  module ::Thor::RakeCompat
    include ::Rake::DSL

    def self.rake_classes: () -> ::Array[untyped]

    def self.included: (untyped base) -> untyped
  end
end

class ::Thor::Runner < ::Thor
  def self.banner: (untyped command, ?bool all, ?bool subcommand) -> ::String

  def self.exit_on_failure?: () -> true

  # Override Thor#help so it can give information about any class and any method.
  #
  def help: (?untyped? meth) -> untyped

  # If a command is not found on Thor::Runner, method missing is invoked and
  # Thor::Runner is then responsible for finding the command in all classes.
  #
  def method_missing: (untyped meth, *untyped args) -> untyped

  def install: (untyped name) -> (false | untyped)

  def version: () -> untyped

  def uninstall: (untyped name) -> nil

  def update: (untyped name) -> (::Integer | nil)

  def installed: () -> ::Array[::Array[untyped]]

  def list: (?::String search) -> ::Array[::Array[untyped]]

  private

  def thor_root: () -> untyped

  def thor_yaml: () -> untyped

  # Save the yaml file. If none exists in thor root, creates one.
  #
  def save_yaml: (untyped yaml) -> nil

  # Load the Thorfiles. If relevant_to is supplied, looks for specific files
  # in the thor_root instead of loading them all.
  #
  # By default, it also traverses the current path until find Thor files, as
  # described in thorfiles. This look up can be skipped by supplying
  # skip_lookup true.
  #
  def initialize_thorfiles: (?untyped? relevant_to, ?bool skip_lookup) -> untyped

  # Finds Thorfiles by traversing from your current directory down to the root
  # directory of your system. If at any time we find a Thor file, we stop.
  #
  # We also ensure that system-wide Thorfiles are loaded first, so local
  # Thorfiles can override them.
  #
  # ==== Example
  #
  # If we start at /Users/wycats/dev/thor ...
  #
  # 1. /Users/wycats/dev/thor
  # 2. /Users/wycats/dev
  # 3. /Users/wycats <-- we find a Thorfile here, so we stop
  #
  # Suppose we start at c:\Documents and Settings\james\dev\thor ...
  #
  # 1. c:\Documents and Settings\james\dev\thor
  # 2. c:\Documents and Settings\james\dev
  # 3. c:\Documents and Settings\james
  # 4. c:\Documents and Settings
  # 5. c:\ <-- no Thorfiles found!
  #
  def thorfiles: (?untyped? relevant_to, ?bool skip_lookup) -> untyped

  # Load Thorfiles relevant to the given method. If you provide "foo:bar" it
  # will load all thor files in the thor.yaml that has "foo" e "foo:bar"
  # namespaces registered.
  #
  def thorfiles_relevant_to: (untyped meth) -> untyped

  # Display information about the given klasses. If with_module is given,
  # it shows a table with information extracted from the yaml file.
  #
  def display_klasses: (?bool with_modules, ?bool show_internal, ?untyped klasses) -> ::Array[::Array[untyped]]

  def display_commands: (untyped namespace, untyped list) -> untyped

  alias display_tasks display_commands

  def show_modules: () -> untyped
end

class ::Thor
  module ::Thor::Base
    attr_writer self.shell: untyped

    # Returns the shell used in all Thor classes. If you are in a Unix platform
    # it will use a colored log, otherwise it will use a basic one without color.
    #
    def self.shell: () -> untyped
  end

  module ::Thor::Shell
    ::Thor::Shell::SHELL_DELEGATED_METHODS: ::Array[:ask | :error | :set_color | :yes? | :no? | :say | :say_error | :say_status | :print_in_columns | :print_table | :print_wrapped | :file_collision | :terminal_width]

    attr_writer shell: untyped

    # Add shell to initialize config values.
    #
    # ==== Configuration
    # shell<Object>:: An instance of the shell to be used.
    #
    # ==== Examples
    #
    #   class MyScript < Thor
    #     argument :first, :type => :numeric
    #   end
    #
    #   MyScript.new [1.0], { :foo => :bar }, :shell => Thor::Shell::Basic.new
    #
    def initialize: (?untyped args, ?::Hash[untyped, untyped] options, ?::Hash[untyped, untyped] config) -> void

    # Holds the shell for the given Thor instance. If no shell is given,
    # it gets a default shell from Thor::Base.shell.
    def shell: () -> untyped

    # Yields the given block with padding.
    def with_padding: () { () -> untyped } -> untyped

    # Allow shell to be shared between invocations.
    #
    def _shared_configuration: () -> untyped
  end
end

class ::Thor
  module ::Thor::Shell
    class ::Thor::Shell::Basic
      attr_accessor base: untyped

      attr_reader padding: untyped

      # Initialize base, mute and padding to nil.
      #
      def initialize: () -> void

      # Mute everything that's inside given block
      #
      def mute: () { () -> untyped } -> untyped

      # Check if base is muted
      #
      def mute?: () -> (false | true)

      # Sets the output padding, not allowing less than zero values.
      #
      def padding=: (untyped value) -> untyped

      # Sets the output padding while executing a block and resets it.
      #
      def indent: (?::Integer count) { () -> untyped } -> untyped

      # Asks something to the user and receives a response.
      #
      # If a default value is specified it will be presented to the user
      # and allows them to select that value with an empty response. This
      # option is ignored when limited answers are supplied.
      #
      # If asked to limit the correct responses, you can pass in an
      # array of acceptable answers.  If one of those is not supplied,
      # they will be shown a message stating that one of those answers
      # must be given and re-asked the question.
      #
      # If asking for sensitive information, the :echo option can be set
      # to false to mask user input from $stdin.
      #
      # If the required input is a path, then set the path option to
      # true. This will enable tab completion for file paths relative
      # to the current working directory on systems that support
      # Readline.
      #
      # ==== Example
      #   ask("What is your name?")
      #
      #   ask("What is the planet furthest from the sun?", :default => "Neptune")
      #
      #   ask("What is your favorite Neopolitan flavor?", :limited_to => ["strawberry", "chocolate", "vanilla"])
      #
      #   ask("What is your password?", :echo => false)
      #
      #   ask("Where should the file be saved?", :path => true)
      #
      def ask: (untyped statement, *untyped args) -> untyped

      # Say (print) something to the user. If the sentence ends with a whitespace
      # or tab character, a new line is not appended (print + flush). Otherwise
      # are passed straight to puts (behavior got from Highline).
      #
      # ==== Example
      #   say("I know you knew that.")
      #
      def say: (?::String message, ?untyped? color, ?untyped force_new_line) -> (nil | untyped)

      # Say (print) an error to the user. If the sentence ends with a whitespace
      # or tab character, a new line is not appended (print + flush). Otherwise
      # are passed straight to puts (behavior got from Highline).
      #
      # ==== Example
      #   say_error("error: something went wrong")
      #
      def say_error: (?::String message, ?untyped? color, ?untyped force_new_line) -> (nil | untyped)

      # Say a status with the given color and appends the message. Since this
      # method is used frequently by actions, it allows nil or false to be given
      # in log_status, avoiding the message from being shown. If a Symbol is
      # given in log_status, it's used as the color.
      #
      def say_status: (untyped status, untyped message, ?bool log_status) -> (nil | untyped)

      # Asks the user a question and returns true if the user replies "y" or
      # "yes".
      #
      def yes?: (untyped statement, ?untyped? color) -> (false | true)

      # Asks the user a question and returns true if the user replies "n" or
      # "no".
      #
      def no?: (untyped statement, ?untyped? color) -> (false | true)

      # Prints values in columns
      #
      # ==== Parameters
      # Array[String, String, ...]
      #
      def print_in_columns: (untyped array) -> untyped

      # Prints a table.
      #
      # ==== Parameters
      # Array[Array[String, String, ...]]
      #
      # ==== Options
      # indent<Integer>:: Indent the first column by indent value.
      # colwidth<Integer>:: Force the first column to colwidth spaces wide.
      # borders<Boolean>:: Adds ascii borders.
      #
      def print_table: (untyped array, ?::Hash[untyped, untyped] options) -> untyped

      # Prints a long string, word-wrapping the text to the current width of the
      # terminal display. Ideal for printing heredocs.
      #
      # ==== Parameters
      # String
      #
      # ==== Options
      # indent<Integer>:: Indent each line of the printed paragraph by indent value.
      #
      def print_wrapped: (untyped message, ?::Hash[untyped, untyped] options) -> untyped

      # Deals with file collision and returns true if the file should be
      # overwritten and false otherwise. If a block is given, it uses the block
      # response as the content for the diff.
      #
      # ==== Parameters
      # destination<String>:: the destination file to solve conflicts
      # block<Proc>:: an optional block that returns the value to be used in diff and merge
      #
      def file_collision: (untyped destination) ?{ () -> untyped } -> (true | false | untyped | nil)

      # Called if something goes wrong during the execution. This is used by Thor
      # internally and should not be used inside your scripts. If something went
      # wrong, you can always raise an exception. If you raise a Thor::Error, it
      # will be rescued and wrapped in the method below.
      #
      def error: (untyped statement) -> untyped

      # Apply color to the given string with optional bold. Disabled in the
      # Thor::Shell::Basic class.
      #
      def set_color: (untyped string, *untyped) -> untyped

      def prepare_message: (untyped message, *untyped color) -> ::String

      def can_display_colors?: () -> false

      def lookup_color: (untyped color) -> untyped

      def stdout: () -> untyped

      def stderr: () -> untyped

      def is?: (untyped value) -> ::Regexp

      def file_collision_help: (untyped block_given) -> ("        Y - yes, overwrite\n        n - no, do not overwrite\n        a - all, overwrite this and all others\n        q - quit, abort\n        h - help, show this help\n" | ::String)

      def show_diff: (untyped destination, untyped content) -> (::FalseClass | ::NilClass | ::TrueClass)

      def quiet?: () -> untyped

      def unix?: () -> untyped

      def ask_simply: (untyped statement, untyped color, untyped options) -> (nil | untyped)

      def ask_filtered: (untyped statement, untyped color, untyped options) -> untyped

      def answer_match: (untyped possibilities, untyped answer, untyped case_insensitive) -> untyped

      def merge: (untyped destination, untyped content) -> (::FalseClass | ::NilClass | ::TrueClass)

      def merge_tool: () -> ::Array[::String]

      def diff_tool: () -> ::Array[::String]
    end
  end
end

class ::Thor
  module ::Thor::Shell
    # Inherit from Thor::Shell::Basic and add set_color behavior. Check
    # Thor::Shell::Basic to see all available methods.
    #
    class ::Thor::Shell::Color < ::Thor::Shell::Basic
      include ::LCSDiff

      # Embed in a String to clear all previous ANSI sequences.
      ::Thor::Shell::Color::CLEAR: "\e[0m"

      # The start of an ANSI bold sequence.
      ::Thor::Shell::Color::BOLD: "\e[1m"

      # Set the terminal's foreground ANSI color to black.
      ::Thor::Shell::Color::BLACK: "\e[30m"

      # Set the terminal's foreground ANSI color to red.
      ::Thor::Shell::Color::RED: "\e[31m"

      # Set the terminal's foreground ANSI color to green.
      ::Thor::Shell::Color::GREEN: "\e[32m"

      # Set the terminal's foreground ANSI color to yellow.
      ::Thor::Shell::Color::YELLOW: "\e[33m"

      # Set the terminal's foreground ANSI color to blue.
      ::Thor::Shell::Color::BLUE: "\e[34m"

      # Set the terminal's foreground ANSI color to magenta.
      ::Thor::Shell::Color::MAGENTA: "\e[35m"

      # Set the terminal's foreground ANSI color to cyan.
      ::Thor::Shell::Color::CYAN: "\e[36m"

      # Set the terminal's foreground ANSI color to white.
      ::Thor::Shell::Color::WHITE: "\e[37m"

      # Set the terminal's background ANSI color to black.
      ::Thor::Shell::Color::ON_BLACK: "\e[40m"

      # Set the terminal's background ANSI color to red.
      ::Thor::Shell::Color::ON_RED: "\e[41m"

      # Set the terminal's background ANSI color to green.
      ::Thor::Shell::Color::ON_GREEN: "\e[42m"

      # Set the terminal's background ANSI color to yellow.
      ::Thor::Shell::Color::ON_YELLOW: "\e[43m"

      # Set the terminal's background ANSI color to blue.
      ::Thor::Shell::Color::ON_BLUE: "\e[44m"

      # Set the terminal's background ANSI color to magenta.
      ::Thor::Shell::Color::ON_MAGENTA: "\e[45m"

      # Set the terminal's background ANSI color to cyan.
      ::Thor::Shell::Color::ON_CYAN: "\e[46m"

      # Set the terminal's background ANSI color to white.
      ::Thor::Shell::Color::ON_WHITE: "\e[47m"

      # Set color by using a string or one of the defined constants. If a third
      # option is set to true, it also adds bold to the string. This is based
      # on Highline implementation and it automatically appends CLEAR to the end
      # of the returned String.
      #
      # Pass foreground, background and bold options to this method as
      # symbols.
      #
      # Example:
      #
      #   set_color "Hi!", :red, :on_white, :bold
      #
      # The available colors are:
      #
      #   :bold
      #   :black
      #   :red
      #   :green
      #   :yellow
      #   :blue
      #   :magenta
      #   :cyan
      #   :white
      #   :on_black
      #   :on_red
      #   :on_green
      #   :on_yellow
      #   :on_blue
      #   :on_magenta
      #   :on_cyan
      #   :on_white
      def set_color: (untyped string, *untyped colors) -> (untyped | ::String)

      def can_display_colors?: () -> untyped

      def are_colors_supported?: () -> untyped

      def are_colors_disabled?: () -> (false | true)
    end
  end
end

class ::Thor
  module ::Thor::Shell
    class ::Thor::Shell::ColumnPrinter
