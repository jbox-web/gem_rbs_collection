      #
      def convert_encoded_instructions: (untyped filename) -> untyped

      # Receives a hash of options and just execute the block if some
      # conditions are met.
      #
      def invoke_with_conflict_check: () { () -> untyped } -> untyped

      def on_file_clash_behavior: () -> untyped

      # What to do when the destination file already exists.
      #
      def on_conflict_behavior: () -> untyped

      # Shortcut to say_status shell method.
      #
      def say_status: (untyped status, untyped color) -> (untyped | nil)
    end
  end
end

class ::Thor
  module ::Thor::Actions
    # Copies the file from the relative source to the relative destination. If
    # the destination is not given it's assumed to be equal to the source.
    #
    # ==== Parameters
    # source<String>:: the relative path to the source root.
    # destination<String>:: the relative path to the destination root.
    # config<Hash>:: give :verbose => false to not log the status, and
    #                :mode => :preserve, to preserve the file mode from the source.
    #
    # ==== Examples
    #
    #   copy_file "README", "doc/README"
    #
    #   copy_file "doc/README"
    #
    def copy_file: (untyped source, *untyped args) { (untyped) -> untyped } -> top

    # Links the file from the relative source to the relative destination. If
    # the destination is not given it's assumed to be equal to the source.
    #
    # ==== Parameters
    # source<String>:: the relative path to the source root.
    # destination<String>:: the relative path to the destination root.
    # config<Hash>:: give :verbose => false to not log the status.
    #
    # ==== Examples
    #
    #   link_file "README", "doc/README"
    #
    #   link_file "doc/README"
    #
    def link_file: (untyped source, *untyped args) -> untyped

    # Gets the content at the given address and places it at the given relative
    # destination. If a block is given instead of destination, the content of
    # the url is yielded and used as location.
    #
    # +get+ relies on open-uri, so passing application user input would provide
    # a command injection attack vector.
    #
    # ==== Parameters
    # source<String>:: the address of the given content.
    # destination<String>:: the relative path to the destination root.
    # config<Hash>:: give :verbose => false to not log the status, and
    #                :http_headers => <Hash> to add headers to an http request.
    #
    # ==== Examples
    #
    #   get "http://gist.github.com/103208", "doc/README"
    #
    #   get "http://gist.github.com/103208", "doc/README", :http_headers => {"Content-Type" => "application/json"}
    #
    #   get "http://gist.github.com/103208" do |content|
    #     content.split("\n").first
    #   end
    #
    def get: (untyped source, *untyped args) ?{ (untyped) -> untyped } -> untyped

    # Gets an ERB template at the relative source, executes it and makes a copy
    # at the relative destination. If the destination is not given it's assumed
    # to be equal to the source removing .tt from the filename.
    #
    # ==== Parameters
    # source<String>:: the relative path to the source root.
    # destination<String>:: the relative path to the destination root.
    # config<Hash>:: give :verbose => false to not log the status.
    #
    # ==== Examples
    #
    #   template "README", "doc/README"
    #
    #   template "doc/README"
    #
    def template: (untyped source, *untyped args) { (untyped) -> untyped } -> untyped

    # Changes the mode of the given file or directory.
    #
    # ==== Parameters
    # mode<Integer>:: the file mode
    # path<String>:: the name of the file to change mode
    # config<Hash>:: give :verbose => false to not log the status.
    #
    # ==== Example
    #
    #   chmod "script/server", 0755
    #
    def chmod: (untyped path, untyped mode, ?::Hash[untyped, untyped] config) -> (nil | untyped)

    # Prepend text to a file. Since it depends on insert_into_file, it's reversible.
    #
    # ==== Parameters
    # path<String>:: path of the file to be changed
    # data<String>:: the data to prepend to the file, can be also given as a block.
    # config<Hash>:: give :verbose => false to not log the status.
    #
    # ==== Example
    #
    #   prepend_to_file 'config/environments/test.rb', 'config.gem "rspec"'
    #
    #   prepend_to_file 'config/environments/test.rb' do
    #     'config.gem "rspec"'
    #   end
    #
    def prepend_to_file: (untyped path, *untyped args) { (?) -> untyped } -> untyped

    alias prepend_file prepend_to_file

    # Append text to a file. Since it depends on insert_into_file, it's reversible.
    #
    # ==== Parameters
    # path<String>:: path of the file to be changed
    # data<String>:: the data to append to the file, can be also given as a block.
    # config<Hash>:: give :verbose => false to not log the status.
    #
    # ==== Example
    #
    #   append_to_file 'config/environments/test.rb', 'config.gem "rspec"'
    #
    #   append_to_file 'config/environments/test.rb' do
    #     'config.gem "rspec"'
    #   end
    #
    def append_to_file: (untyped path, *untyped args) { (?) -> untyped } -> untyped

    alias append_file append_to_file

    # Injects text right after the class definition. Since it depends on
    # insert_into_file, it's reversible.
    #
    # ==== Parameters
    # path<String>:: path of the file to be changed
    # klass<String|Class>:: the class to be manipulated
    # data<String>:: the data to append to the class, can be also given as a block.
    # config<Hash>:: give :verbose => false to not log the status.
    #
    # ==== Examples
    #
    #   inject_into_class "app/controllers/application_controller.rb", "ApplicationController", "  filter_parameter :password\n"
    #
    #   inject_into_class "app/controllers/application_controller.rb", "ApplicationController" do
    #     "  filter_parameter :password\n"
    #   end
    #
    def inject_into_class: (untyped path, untyped klass, *untyped args) { (?) -> untyped } -> untyped

    # Injects text right after the module definition. Since it depends on
    # insert_into_file, it's reversible.
    #
    # ==== Parameters
    # path<String>:: path of the file to be changed
    # module_name<String|Class>:: the module to be manipulated
    # data<String>:: the data to append to the class, can be also given as a block.
    # config<Hash>:: give :verbose => false to not log the status.
    #
    # ==== Examples
    #
    #   inject_into_module "app/helpers/application_helper.rb", "ApplicationHelper", "  def help; 'help'; end\n"
    #
    #   inject_into_module "app/helpers/application_helper.rb", "ApplicationHelper" do
    #     "  def help; 'help'; end\n"
    #   end
    #
    def inject_into_module: (untyped path, untyped module_name, *untyped args) { (?) -> untyped } -> untyped

    # Run a regular expression replacement on a file, raising an error if the
    # contents of the file are not changed.
    #
    # ==== Parameters
    # path<String>:: path of the file to be changed
    # flag<Regexp|String>:: the regexp or string to be replaced
    # replacement<String>:: the replacement, can be also given as a block
    # config<Hash>:: give :verbose => false to not log the status, and
    #                :force => true, to force the replacement regardless of runner behavior.
    #
    # ==== Example
    #
    #   gsub_file! 'app/controllers/application_controller.rb', /#\s*(filter_parameter_logging :password)/, '\1'
    #
    #   gsub_file! 'README', /rake/, :green do |match|
    #     match << " no more. Use thor!"
    #   end
    #
    def gsub_file!: (untyped path, untyped flag, *untyped args) { (?) -> untyped } -> (nil | untyped)

    # Run a regular expression replacement on a file.
    #
    # ==== Parameters
    # path<String>:: path of the file to be changed
    # flag<Regexp|String>:: the regexp or string to be replaced
    # replacement<String>:: the replacement, can be also given as a block
    # config<Hash>:: give :verbose => false to not log the status, and
    #                :force => true, to force the replacement regardless of runner behavior.
    #
    # ==== Example
    #
    #   gsub_file 'app/controllers/application_controller.rb', /#\s*(filter_parameter_logging :password)/, '\1'
    #
    #   gsub_file 'README', /rake/, :green do |match|
    #     match << " no more. Use thor!"
    #   end
    #
    def gsub_file: (untyped path, untyped flag, *untyped args) { (?) -> untyped } -> (nil | untyped)

    # Uncomment all lines matching a given regex. Preserves indentation before
    # the comment hash and removes the hash and any immediate following space.
    #
    # ==== Parameters
    # path<String>:: path of the file to be changed
    # flag<Regexp|String>:: the regexp or string used to decide which lines to uncomment
    # config<Hash>:: give :verbose => false to not log the status.
    #
    # ==== Example
    #
    #   uncomment_lines 'config/initializers/session_store.rb', /active_record/
    #
    def uncomment_lines: (untyped path, untyped flag, *untyped args) -> (::Integer | nil)

    # Comment all lines matching a given regex.  It will leave the space
    # which existed before the beginning of the line in tact and will insert
    # a single space after the comment hash.
    #
    # ==== Parameters
    # path<String>:: path of the file to be changed
    # flag<Regexp|String>:: the regexp or string used to decide which lines to comment
    # config<Hash>:: give :verbose => false to not log the status.
    #
    # ==== Example
    #
    #   comment_lines 'config/initializers/session_store.rb', /cookie_store/
    #
    def comment_lines: (untyped path, untyped flag, *untyped args) -> (::Integer | nil)

    # Removes a file at the given location.
    #
    # ==== Parameters
    # path<String>:: path of the file to be changed
    # config<Hash>:: give :verbose => false to not log the status.
    #
    # ==== Example
    #
    #   remove_file 'README'
    #   remove_file 'app/controllers/application_controller.rb'
    #
    def remove_file: (untyped path, ?::Hash[untyped, untyped] config) -> (nil | untyped)

    alias remove_dir remove_file

    attr_accessor output_buffer: untyped

    private

    def concat: (untyped string) -> untyped

    def capture: (*untyped args) { (untyped) -> untyped } -> untyped

    def with_output_buffer: (?untyped buf) { () -> untyped } -> untyped

    def actually_gsub_file: (untyped path, untyped flag, untyped args, untyped error_on_no_change) { (?) -> untyped } -> ::Integer

    # Thor::Actions#capture depends on what kind of buffer is used in ERB.
    # Thus CapturableERB fixes ERB to use String buffer.
    class ::Thor::Actions::CapturableERB < ::ERB
      def set_eoutvar: (untyped compiler, ?::String eoutvar) -> [ untyped ]
    end
  end
end

class ::Thor
  module ::Thor::Actions
    ::Thor::Actions::WARNINGS: { unchanged_no_flag: "File unchanged! Either the supplied flag value not found or the content has already been inserted!" }

    # Injects the given content into a file, raising an error if the contents of
    # the file are not changed. Different from gsub_file, this method is reversible.
    #
    # ==== Parameters
    # destination<String>:: Relative path to the destination root
    # data<String>:: Data to add to the file. Can be given as a block.
    # config<Hash>:: give :verbose => false to not log the status and the flag
    #                for injection (:after or :before) or :force => true for
    #                insert two or more times the same content.
    #
    # ==== Examples
    #
    #   insert_into_file "config/environment.rb", "config.gem :thor", :after => "Rails::Initializer.run do |config|\n"
    #
    #   insert_into_file "config/environment.rb", :after => "Rails::Initializer.run do |config|\n" do
    #     gems = ask "Which gems would you like to add?"
    #     gems.split(" ").map{ |gem| "  config.gem :#{gem}" }.join("\n")
    #   end
    #
    def insert_into_file!: (untyped destination, *untyped args) ?{ (?) -> untyped } -> untyped

    alias inject_into_file! insert_into_file!

    # Injects the given content into a file. Different from gsub_file, this
    # method is reversible.
    #
    # ==== Parameters
    # destination<String>:: Relative path to the destination root
    # data<String>:: Data to add to the file. Can be given as a block.
    # config<Hash>:: give :verbose => false to not log the status and the flag
    #                for injection (:after or :before) or :force => true for
    #                insert two or more times the same content.
    #
    # ==== Examples
    #
    #   insert_into_file "config/environment.rb", "config.gem :thor", :after => "Rails::Initializer.run do |config|\n"
    #
    #   insert_into_file "config/environment.rb", :after => "Rails::Initializer.run do |config|\n" do
    #     gems = ask "Which gems would you like to add?"
    #     gems.split(" ").map{ |gem| "  config.gem :#{gem}" }.join("\n")
    #   end
    #
    def insert_into_file: (untyped destination, *untyped args) ?{ (?) -> untyped } -> untyped

    alias inject_into_file insert_into_file

    class ::Thor::Actions::InjectIntoFile < ::Thor::Actions::EmptyDirectory
      attr_reader replacement: untyped

      attr_reader flag: untyped

      attr_reader behavior: untyped

      def initialize: (untyped base, untyped destination, untyped data, untyped config) -> void

      def invoke!: () -> untyped

      def revoke!: () -> untyped

      def say_status: (untyped behavior, ?warning: untyped?, ?color: untyped?) -> untyped

      def content: () -> ::String

      def replacement_present?: () -> untyped

      # Adds the content to the file.
      #
      def replace!: (untyped regexp, untyped string, untyped force) -> (untyped | nil)
    end
  end
end

class ::Thor
  # Shortcuts for help and tree commands.
  ::Thor::HELP_MAPPINGS: ::Array["-h" | "-?" | "--help" | "-D"]

  ::Thor::TREE_MAPPINGS: ::Array["-t" | "--tree"]

  # Thor methods that should not be overwritten by the user.
  ::Thor::THOR_RESERVED_WORDS: ::Array["invoke" | "shell" | "options" | "behavior" | "root" | "destination_root" | "relative_root" | "action" | "add_file" | "create_file" | "in_root" | "inside" | "run" | "run_ruby_script"]

  ::Thor::TEMPLATE_EXTNAME: ".tt"

  def self.deprecation_warning: (untyped message) -> (untyped | nil)

  module ::Thor::Base
    attr_accessor options: untyped

    attr_accessor parent_options: untyped

    attr_accessor args: untyped

    # It receives arguments in an Array and two hashes, one for options and
    # other for configuration.
    #
    # Notice that it does not check if all required arguments were supplied.
    # It should be done by the parser.
    #
    # ==== Parameters
    # args<Array[Object]>:: An array of objects. The objects are applied to their
    #                       respective accessors declared with <tt>argument</tt>.
    #
    # options<Hash>:: An options hash that will be available as self.options.
    #                 The hash given is converted to a hash with indifferent
    #                 access, magic predicates (options.skip?) and then frozen.
    #
    # config<Hash>:: Configuration for this Thor class.
    #
    def initialize: (?untyped args, ?::Hash[untyped, untyped] local_options, ?::Hash[untyped, untyped] config) -> void

    def self.included: (untyped base) -> untyped

    # Returns the classes that inherits from Thor or Thor::Group.
    #
    # ==== Returns
    # Array[Class]
    #
    def self.subclasses: () -> ::Array[untyped]

    # Returns the files where the subclasses are kept.
    #
    # ==== Returns
    # Hash[path<String> => Class]
    #
    def self.subclass_files: () -> ::Hash[untyped, untyped]

    # Whenever a class inherits from Thor or Thor::Group, we should track the
    # class and the file on Thor::Base. This is the method responsible for it.
    #
    def self.register_klass_file: (untyped klass) -> untyped

    module ::Thor::Base::ClassMethods
      def attr_reader: (*untyped) -> untyped

      def attr_writer: (*untyped) -> untyped

      def attr_accessor: (*untyped) -> untyped

      # If you want to raise an error for unknown options, call check_unknown_options!
      # This is disabled by default to allow dynamic invocations.
      def check_unknown_options!: () -> true

      def check_unknown_options: () -> untyped

      def check_unknown_options?: (untyped config) -> (false | true)

      # If you want to raise an error when the default value of an option does not match
      # the type call check_default_type!
      # This will be the default; for compatibility a deprecation warning is issued if necessary.
      def check_default_type!: () -> true

      # If you want to use defaults that don't match the type of an option,
      # either specify `check_default_type: false` or call `allow_incompatible_default_type!`
      def allow_incompatible_default_type!: () -> false

      def check_default_type: () -> untyped

      # If true, option parsing is suspended as soon as an unknown option or a
      # regular argument is encountered.  All remaining arguments are passed to
      # the command as regular arguments.
      def stop_on_unknown_option?: (untyped command_name) -> false

      # If true, option set will not suspend the execution of the command when
      # a required option is not provided.
      def disable_required_check?: (untyped command_name) -> false

      # If you want only strict string args (useful when cascading thor classes),
      # call strict_args_position! This is disabled by default to allow dynamic
      # invocations.
      def strict_args_position!: () -> true

      def strict_args_position: () -> untyped

      def strict_args_position?: (untyped config) -> (false | true)

      # Adds an argument to the class and creates an attr_accessor for it.
      #
      # Arguments are different from options in several aspects. The first one
      # is how they are parsed from the command line, arguments are retrieved
      # from position:
      #
      #   thor command NAME
      #
      # Instead of:
      #
      #   thor command --name=NAME
      #
      # Besides, arguments are used inside your code as an accessor (self.argument),
      # while options are all kept in a hash (self.options).
      #
      # Finally, arguments cannot have type :default or :boolean but can be
      # optional (supplying :optional => :true or :required => false), although
      # you cannot have a required argument after a non-required argument. If you
      # try it, an error is raised.
      #
      # ==== Parameters
      # name<Symbol>:: The name of the argument.
      # options<Hash>:: Described below.
      #
      # ==== Options
      # :desc     - Description for the argument.
      # :required - If the argument is required or not.
      # :optional - If the argument is optional or not.
      # :type     - The type of the argument, can be :string, :hash, :array, :numeric.
      # :default  - Default value for this argument. It cannot be required and have default values.
      # :banner   - String to show on usage notes.
      #
      # ==== Errors
      # ArgumentError:: Raised if you supply a required argument after a non required one.
      #
      def argument: (untyped name, ?::Hash[untyped, untyped] options) -> untyped

      # Returns this class arguments, looking up in the ancestors chain.
      #
      # ==== Returns
      # Array[Thor::Argument]
      #
      def arguments: () -> untyped

      # Adds a bunch of options to the set of class options.
      #
      #   class_options :foo => false, :bar => :required, :baz => :string
      #
      # If you prefer more detailed declaration, check class_option.
      #
      # ==== Parameters
      # Hash[Symbol => Object]
      #
      def class_options: (?untyped? options) -> untyped

      # Adds an option to the set of class options
      #
      # ==== Parameters
      # name<Symbol>:: The name of the argument.
      # options<Hash>:: Described below.
      #
      # ==== Options
      # :desc::     -- Description for the argument.
      # :required:: -- If the argument is required or not.
      # :default::  -- Default value for this argument.
      # :group::    -- The group for this options. Use by class options to output options in different levels.
      # :aliases::  -- Aliases for this option. <b>Note:</b> Thor follows a convention of one-dash-one-letter options. Thus aliases like "-something" wouldn't be parsed; use either "\--something" or "-s" instead.
      # :type::     -- The type of the argument, can be :string, :hash, :array, :numeric or :boolean.
      # :banner::   -- String to show on usage notes.
      # :hide::     -- If you want to hide this option from the help.
      #
      def class_option: (untyped name, ?::Hash[untyped, untyped] options) -> untyped

      # Adds and declares option group for exclusive options in the
      # block and arguments. You can declare options as the outside of the block.
      #
      # ==== Parameters
      # Array[Thor::Option.name]
      #
      # ==== Examples
      #
      #   class_exclusive do
      #     class_option :one
      #     class_option :two
      #    end
      #
      # Or
      #
      #   class_option :one
      #   class_option :two
      #   class_exclusive :one, :two
      #
      # If you give "--one" and "--two" at the same time ExclusiveArgumentsError
      # will be raised.
      #
      def class_exclusive: (*untyped args) { (?) -> untyped } -> untyped

      # Adds and declares option group for required at least one of options in the
      # block and arguments. You can declare options as the outside of the block.
      #
      # ==== Examples
      #
      #   class_at_least_one do
      #     class_option :one
      #     class_option :two
      #    end
      #
      # Or
      #
      #   class_option :one
      #   class_option :two
      #   class_at_least_one :one, :two
      #
      # If you do not give "--one" and "--two" AtLeastOneRequiredArgumentError
      # will be raised.
      #
      # You can use class_at_least_one and class_exclusive at the same time.
      #
      #    class_exclusive do
      #      class_at_least_one do
      #        class_option :one
      #        class_option :two
      #      end
      #    end
      #
      # Then it is required either only one of "--one" or "--two".
      #
      def class_at_least_one: (*untyped args) { (?) -> untyped } -> untyped

      # Returns this class exclusive options array set, looking up in the ancestors chain.
      #
      # ==== Returns
      # Array[Array[Thor::Option.name]]
      #
      def class_exclusive_option_names: () -> untyped

      # Returns this class at least one of required options array set, looking up in the ancestors chain.
      #
      # ==== Returns
      # Array[Array[Thor::Option.name]]
      #
      def class_at_least_one_option_names: () -> untyped

      # Removes a previous defined argument. If :undefine is given, undefine
      # accessors as well.
      #
      # ==== Parameters
      # names<Array>:: Arguments to be removed
      #
      # ==== Examples
      #
      #   remove_argument :foo
      #   remove_argument :foo, :bar, :baz, :undefine => true
      #
      def remove_argument: (*untyped names) -> untyped

      # Removes a previous defined class option.
      #
      # ==== Parameters
      # names<Array>:: Class options to be removed
      #
      # ==== Examples
      #
      #   remove_class_option :foo
      #   remove_class_option :foo, :bar, :baz
      #
      def remove_class_option: (*untyped names) -> untyped

      # Defines the group. This is used when thor list is invoked so you can specify
      # that only commands from a pre-defined group will be shown. Defaults to standard.
      #
      # ==== Parameters
      # name<String|Symbol>
      #
      def group: (?untyped? name) -> untyped

      # Returns the commands for this Thor class.
      #
      # ==== Returns
      # Hash:: An ordered hash with commands names as keys and Thor::Command
      #        objects as values.
      #
      def commands: () -> ::Hash[untyped, untyped]

      alias tasks commands

      # Returns the commands for this Thor class and all subclasses.
      #
      # ==== Returns
      # Hash:: An ordered hash with commands names as keys and Thor::Command
      #        objects as values.
      #
      def all_commands: () -> untyped

      alias all_tasks all_commands

      # Removes a given command from this Thor class. This is usually done if you
      # are inheriting from another class and don't want it to be available
      # anymore.
      #
      # By default it only remove the mapping to the command. But you can supply
      # :undefine => true to undefine the method from the class as well.
      #
      # ==== Parameters
      # name<Symbol|String>:: The name of the command to be removed
      # options<Hash>:: You can give :undefine => true if you want commands the method
      #                 to be undefined from the class as well.
      #
      def remove_command: (*untyped names) -> untyped

      alias remove_task remove_command

      # All methods defined inside the given block are not added as commands.
      #
      # So you can do:
      #
      #   class MyScript < Thor
      #     no_commands do
      #       def this_is_not_a_command
      #       end
      #     end
      #   end
      #
      # You can also add the method and remove it from the command list:
      #
      #   class MyScript < Thor
      #     def this_is_not_a_command
      #     end
      #     remove_command :this_is_not_a_command
      #   end
      #
      def no_commands: () { (?) -> untyped } -> untyped

      alias no_tasks no_commands

      def no_commands_context: () -> untyped

      def no_commands?: () -> untyped

      # Sets the namespace for the Thor or Thor::Group class. By default the
      # namespace is retrieved from the class name. If your Thor class is named
      # Scripts::MyScript, the help method, for example, will be called as:
      #
      #   thor scripts:my_script -h
      #
      # If you change the namespace:
      #
      #   namespace :my_scripts
      #
      # You change how your commands are invoked:
      #
      #   thor my_scripts -h
      #
      # Finally, if you change your namespace to default:
      #
      #   namespace :default
      #
      # Your commands can be invoked with a shortcut. Instead of:
      #
      #   thor :my_command
      #
      def namespace: (?untyped? name) -> untyped

      # Parses the command and options from the given args, instantiate the class
      # and invoke the command. This method is used when the arguments must be parsed
      # from an array. If you are inside Ruby and want to use a Thor class, you
      # can simply initialize it:
      #
      #   script = MyScript.new(args, options, config)
      #   script.invoke(:command, first_arg, second_arg, third_arg)
      #
      def start: (?untyped given_args, ?::Hash[untyped, untyped] config) -> bot

      # Allows to use private methods from parent in child classes as commands.
      #
      # ==== Parameters
      #   names<Array>:: Method names to be used as commands
      #
      # ==== Examples
      #
      #   public_command :foo
      #   public_command :foo, :bar, :baz
      #
      def public_command: (*untyped names) -> untyped

      alias public_task public_command

      def handle_no_command_error: (untyped command, ?untyped has_namespace) -> bot

      alias handle_no_task_error handle_no_command_error

      def handle_argument_error: (untyped command, untyped error, untyped args, untyped arity) -> bot

      # A flag that makes the process exit with status 1 if any error happens.
      def exit_on_failure?: () -> false

      # Prints the class options per group. If an option does not belong to
      # any group, it's printed as Class option.
      #
      def class_options_help: (untyped shell, ?::Hash[untyped, untyped] groups) -> untyped

      # Receives a set of options and print them.
      def print_options: (untyped shell, untyped options, ?untyped? group_name) -> (nil | untyped)

      # Raises an error if the word given is a Thor reserved word.
      def is_thor_reserved_word?: (untyped word, untyped type) -> (false | untyped)

      # Build an option and adds it to the given scope.
      #
      # ==== Parameters
      # name<Symbol>:: The name of the argument.
      # options<Hash>:: Described in both class_option and method_option.
      # scope<Hash>:: Options hash that is being built up
      def build_option: (untyped name, untyped options, untyped scope) -> untyped

      # Receives a hash of options, parse them and add to the scope. This is a
      # fast way to set a bunch of options:
      #
      #   build_options :foo => true, :bar => :required, :baz => :string
      #
      # ==== Parameters
      # Hash[Symbol => Object]
      def build_options: (untyped options, untyped scope) -> untyped

      # Finds a command with the given name. If the command belongs to the current
      # class, just return it, otherwise dup it and add the fresh copy to the
      # current command hash.
      def find_and_refresh_command: (untyped name) -> untyped

      alias find_and_refresh_task find_and_refresh_command

      # Every time someone inherits from a Thor class, register the klass
      # and file into baseclass.
      def inherited: (untyped klass) -> untyped

      # Fire this callback whenever a method is added. Added methods are
      # tracked as commands by invoking the create_command method.
      def method_added: (untyped meth) -> (nil | untyped)

      # Retrieves a value from superclass. If it reaches the baseclass,
      # returns default.
      def from_superclass: (untyped method, ?untyped? default) -> untyped

      #
      # The basename of the program invoking the thor class.
      #
      def basename: () -> ::String

      # SIGNATURE: Sets the baseclass. This is where the superclass lookup
      # finishes.
      def baseclass: () -> nil

      # SIGNATURE: Creates a new command if valid_command? is true. This method is
      # called when a new method is added to the class.
      def create_command: (untyped meth) -> nil

      alias create_task create_command

      # SIGNATURE: Defines behavior when the initialize method is added to the
      # class.
      def initialize_added: () -> nil

      # SIGNATURE: The hook invoked by start.
      def dispatch: (untyped command, untyped given_args, untyped given_opts, untyped config) -> bot

      # Register a relation of options for target(method_option/class_option)
      # by args and block.
      def register_options_relation_for: (untyped target, untyped relation, *untyped args) ?{ (?) -> untyped } -> untyped

      # Get target(method_options or class_options) options
      # of before and after by block evaluation.
      def built_option_names: (untyped target, ?::Hash[untyped, untyped] opt) { (?) -> untyped } -> untyped

      # Get command scope member by name.
      def command_scope_member: (untyped name, ?::Hash[untyped, untyped] options) -> untyped
    end
  end
end

class ::Thor
  class ::Thor::Command
    ::Thor::Command::FILE_REGEXP: ::Regexp

    def initialize: (untyped name, untyped description, untyped long_description, untyped wrap_long_description, untyped usage, ?untyped? options, ?untyped? options_relation) -> void

    def initialize_copy: (untyped other) -> untyped

    def hidden?: () -> false

    # By default, a command invokes a method in the thor class. You can change this
    # implementation to create custom commands.
    def run: (untyped instance, ?untyped args) -> untyped

    # Returns the formatted usage by injecting given required arguments
    # and required options into the given usage.
    def formatted_usage: (untyped klass, ?bool namespace, ?bool subcommand) -> untyped

    def method_exclusive_option_names: () -> untyped

    def method_at_least_one_option_names: () -> untyped

    # Add usage with required arguments
    def required_arguments_for: (untyped klass, untyped usage) -> untyped

    def not_debugging?: (untyped instance) -> (false | true)

    def required_options: () -> untyped

    # Given a target, checks if this class name is a public method.
    def public_method?: (untyped instance) -> (false | true)

    def private_method?: (untyped instance) -> (false | true)

    def local_method?: (untyped instance, untyped name) -> (false | true)

    def sans_backtrace: (untyped backtrace, untyped caller) -> untyped

    def handle_argument_error?: (untyped instance, untyped error, untyped caller) -> untyped

    def handle_no_method_error?: (untyped instance, untyped error, untyped caller) -> untyped
  end

  ::Thor::Task: untyped

  # A command that is hidden in help messages but still invocable.
  class ::Thor::HiddenCommand < ::Thor::Command
    def hidden?: () -> true
  end

  ::Thor::HiddenTask: untyped

  # A dynamic command that handles method missing scenarios.
  class ::Thor::DynamicCommand < ::Thor::Command
    def initialize: (untyped name, ?untyped? options) -> void

    def run: (untyped instance, ?untyped args) -> untyped
  end

  ::Thor::DynamicTask: untyped
end

class ::Thor
  module ::Thor::CoreExt
    # A hash with indifferent access and magic predicates.
    #
    #   hash = Thor::CoreExt::HashWithIndifferentAccess.new 'foo' => 'bar', 'baz' => 'bee', 'force' => true
    #
    #   hash[:foo]  #=> 'bar'
    #   hash['foo'] #=> 'bar'
    #   hash.foo?   #=> true
    #
    class ::Thor::CoreExt::HashWithIndifferentAccess < ::Hash[untyped, untyped]
      def initialize: (?::Hash[untyped, untyped] hash) -> void

      def []: (untyped key) -> untyped

      def []=: (untyped key, untyped value) -> untyped

      def delete: (untyped key) -> untyped

      def except: (*untyped keys) -> ::Thor::CoreExt::HashWithIndifferentAccess

      def fetch: (untyped key, *untyped args) -> untyped

      def slice: (*untyped keys) -> untyped

      def key?: (untyped key) -> untyped

      def values_at: (*untyped indices) -> untyped

      def merge: (untyped other) -> ::Thor::CoreExt::HashWithIndifferentAccess

      def merge!: (untyped other) -> self

      def reverse_merge: (untyped other) -> ::Thor::CoreExt::HashWithIndifferentAccess

      def reverse_merge!: (untyped other_hash) -> untyped

      def replace: (untyped other_hash) -> untyped

      # Convert to a Hash with String keys.
      def to_hash: () -> ::Hash[untyped, untyped]

      def convert_key: (untyped key) -> untyped

      # Magic predicates. For instance:
      #
      #   options.force?                  # => !!options['force']
      #   options.shebang                 # => "/usr/lib/local/ruby"
      #   options.test_framework?(:rspec) # => options[:test_framework] == :rspec
      #
      def method_missing: (untyped method, *untyped args) -> untyped
    end
  end
end

class ::Thor
  ::Thor::Correctable: untyped

  # Thor::Error is raised when it's caused by wrong usage of thor classes. Those
  # errors have their backtrace suppressed and are nicely shown to the user.
  #
  # Errors that are caused by the developer, like declaring a method which
  # overwrites a thor keyword, SHOULD NOT raise a Thor::Error. This way, we
  # ensure that developer errors are shown with full backtrace.
  class ::Thor::Error < ::StandardError
  end

  # Raised when a command was not found.
  class ::Thor::UndefinedCommandError < ::Thor::Error
    class ::Thor::UndefinedCommandError::SpellChecker
      attr_reader error: untyped

      def initialize: (untyped error) -> void

      def corrections: () -> untyped

      def spell_checker: () -> untyped
    end

    attr_reader command: untyped

    attr_reader all_commands: untyped

    def initialize: (untyped command, untyped all_commands, untyped namespace) -> void
  end

  ::Thor::UndefinedTaskError: untyped

  class ::Thor::AmbiguousCommandError < ::Thor::Error
  end

  ::Thor::AmbiguousTaskError: untyped

  # Raised when a command was found, but not invoked properly.
  class ::Thor::InvocationError < ::Thor::Error
  end

  class ::Thor::UnknownArgumentError < ::Thor::Error
    class ::Thor::UnknownArgumentError::SpellChecker
      attr_reader error: untyped

      def initialize: (untyped error) -> void

      def corrections: () -> untyped

      def spell_checker: () -> untyped
    end

    attr_reader switches: untyped

    attr_reader unknown: untyped

    def initialize: (untyped switches, untyped unknown) -> void
  end

  class ::Thor::RequiredArgumentMissingError < ::Thor::InvocationError
  end

  class ::Thor::MalformattedArgumentError < ::Thor::InvocationError
  end

  class ::Thor::ExclusiveArgumentError < ::Thor::InvocationError
  end

  class ::Thor::AtLeastOneRequiredArgumentError < ::Thor::InvocationError
  end
end

# Thor has a special class called Thor::Group. The main difference to Thor class
# is that it invokes all commands at once. It also include some methods that allows
# invocations to be done at the class method, which are not available to Thor
# commands.
class ::Thor::Group
  # The description for this Thor::Group. If none is provided, but a source root
  # exists, tries to find the USAGE one folder above it, otherwise searches
  # in the superclass.
  #
  # ==== Parameters
  # description<String>:: The description for this Thor::Group.
  #
  def self.desc: (?untyped? description) -> untyped

  # Prints help information.
  #
  # ==== Options
  # short:: When true, shows only usage.
  #
  def self.help: (untyped shell) -> untyped

  # Stores invocations for this class merging with superclass values.
  #
  def self.invocations: () -> untyped

  # Stores invocation blocks used on invoke_from_option.
  #
  def self.invocation_blocks: () -> untyped

  # Invoke the given namespace or class given. It adds an instance
  # method that will invoke the klass and command. You can give a block to
  # configure how it will be invoked.
  #
  # The namespace/class given will have its options showed on the help
  # usage. Check invoke_from_option for more information.
  #
  def self.invoke: (*untyped names) ?{ (?) -> untyped } -> untyped

  # Invoke a thor class based on the value supplied by the user to the
  # given option named "name". A class option must be created before this
  # method is invoked for each name given.
  #
  # ==== Examples
  #
  #   class GemGenerator < Thor::Group
  #     class_option :test_framework, :type => :string
  #     invoke_from_option :test_framework
  #   end
  #
  # ==== Boolean options
  #
  # In some cases, you want to invoke a thor class if some option is true or
  # false. This is automatically handled by invoke_from_option. Then the
  # option name is used to invoke the generator.
  #
  # ==== Preparing for invocation
  #
  # In some cases you want to customize how a specified hook is going to be
  # invoked. You can do that by overwriting the class method
  # prepare_for_invocation. The class method must necessarily return a klass
  # and an optional command.
  #
  # ==== Custom invocations
  #
  # You can also supply a block to customize how the option is going to be
  # invoked. The block receives two parameters, an instance of the current
  # class and the klass to be invoked.
  #
  def self.invoke_from_option: (*untyped names) ?{ (?) -> untyped } -> untyped

  # Remove a previously added invocation.
  #
  # ==== Examples
  #
  #   remove_invocation :test_framework
  #
  def self.remove_invocation: (*untyped names) -> untyped

  # Overwrite class options help to allow invoked generators options to be
  # shown recursively when invoking a generator.
  #
  def self.class_options_help: (untyped shell, ?::Hash[untyped, untyped] groups) -> untyped

  # Get invocations array and merge options from invocations. Those
  # options are added to group_options hash. Options that already exists
  # in base_options are not added twice.
  #
  def self.get_options_from_invocations: (untyped group_options, untyped base_options) ?{ (untyped) -> untyped } -> untyped

  # Returns commands ready to be printed.
  def self.printable_commands: (*untyped) -> ::Array[untyped]

  alias self.printable_tasks self.printable_commands

  def self.handle_argument_error: (untyped command, untyped error, untyped _args, untyped arity) -> bot

  # Checks if a specified command exists.
  #
  # ==== Parameters
  # command_name<String>:: The name of the command to check for existence.
  #
  # ==== Returns
  # Boolean:: +true+ if the command exists, +false+ otherwise.
  def self.command_exists?: (untyped command_name) -> untyped

  # The method responsible for dispatching given the args.
  def self.dispatch: (untyped command, untyped given_args, untyped given_opts, untyped config) ?{ (untyped) -> untyped } -> (nil | untyped)

  # The banner for this class. You can customize it if you are invoking the
  # thor class by another ways which is not the Thor::Runner.
  def self.banner: () -> ::String

  # Represents the whole class as a command.
  def self.self_command: () -> untyped

  alias self.self_task self.self_command

  def self.baseclass: () -> singleton(::Thor::Group)

  def self.create_command: (untyped meth) -> true

  alias self.create_task self.create_command

  include ::Thor::Base

  # Shortcut to invoke with padding and block handling. Use internally by
  # invoke and invoke_from_option class methods.
  def _invoke_for_class_method: (untyped klass, ?untyped? command, *untyped args) { (untyped, untyped, untyped) -> untyped } -> untyped
end

class ::Thor
  module ::Thor::Invocation
    def self.included: (untyped base) -> untyped

    module ::Thor::Invocation::ClassMethods
      # This method is responsible for receiving a name and find the proper
      # class and command for it. The key is an optional parameter which is
      # available only in class methods invocations (i.e. in Thor::Group).
      def prepare_for_invocation: (untyped key, untyped name) -> untyped
    end

    # Make initializer aware of invocations and the initialization args.
    def initialize: (?untyped args, ?::Hash[untyped, untyped] options, ?::Hash[untyped, untyped] config) { (?) -> untyped } -> void

    # Make the current command chain accessible with in a Thor-(sub)command
    def current_command_chain: () -> untyped

    # Receives a name and invokes it. The name can be a string (either "command" or
    # "namespace:command"), a Thor::Command, a Class or a Thor instance. If the
    # command cannot be guessed by name, it can also be supplied as second argument.
    #
    # You can also supply the arguments, options and configuration values for
    # the command to be invoked, if none is given, the same values used to
    # initialize the invoker are used to initialize the invoked.
    #
    # When no name is given, it will invoke the default command of the current class.
    #
    # ==== Examples
    #
    #   class A < Thor
    #     def foo
    #       invoke :bar
    #       invoke "b:hello", ["Erik"]
    #     end
    #
    #     def bar
    #       invoke "b:hello", ["Erik"]
    #     end
    #   end
    #
    #   class B < Thor
    #     def hello(name)
    #       puts "hello #{name}"
    #     end
    #   end
    #
    # You can notice that the method "foo" above invokes two commands: "bar",
    # which belongs to the same class and "hello" which belongs to the class B.
    #
    # By using an invocation system you ensure that a command is invoked only once.
    # In the example above, invoking "foo" will invoke "b:hello" just once, even
    # if it's invoked later by "bar" method.
    #
    # When class A invokes class B, all arguments used on A initialization are
    # supplied to B. This allows lazy parse of options. Let's suppose you have
    # some rspec commands:
    #
    #   class Rspec < Thor::Group
    #     class_option :mock_framework, :type => :string, :default => :rr
    #
    #     def invoke_mock_framework
    #       invoke "rspec:#{options[:mock_framework]}"
    #     end
    #   end
    #
    # As you noticed, it invokes the given mock framework, which might have its
    # own options:
    #
    #   class Rspec::RR < Thor::Group
    #     class_option :style, :type => :string, :default => :mock
    #   end
    #
    # Since it's not rspec concern to parse mock framework options, when RR
    # is invoked all options are parsed again, so RR can extract only the options
    # that it's going to use.
    #
    # If you want Rspec::RR to be initialized with its own set of options, you
    # have to do that explicitly:
    #
    #   invoke "rspec:rr", [], :style => :foo
    #
    # Besides giving an instance, you can also give a class to invoke:
    #
    #   invoke Rspec::RR, [], :style => :foo
    #
    def invoke: (?untyped? name, *untyped args) -> untyped

    # Invoke the given command if the given args.
    def invoke_command: (untyped command, *untyped args) -> untyped

    alias invoke_task invoke_command

    # Invoke all commands for the current instance.
    def invoke_all: () -> untyped

    # Invokes using shell padding.
    def invoke_with_padding: (*untyped args) -> untyped

    # Configuration values that are shared between invocations.
    def _shared_configuration: () -> { invocations: untyped }

    # This method simply retrieves the class and command to be invoked.
    # If the name is nil or the given name is a command in the current class,
    # use the given name and return self as class. Otherwise, call
    # prepare_for_invocation in the current class.
    def _retrieve_class_and_command: (untyped name, ?untyped? sent_command) -> (::Array[untyped | nil] | ::Array[untyped])

    alias _retrieve_class_and_task _retrieve_class_and_command

    # Initialize klass using values stored in the @_initializer.
    def _parse_initialization_options: (untyped args, untyped opts, untyped config) -> ::Array[untyped]
  end
end

