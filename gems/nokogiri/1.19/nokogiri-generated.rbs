module ::Nokogiri
  module ::Nokogiri::XML
    # #
    # Represents the allowed content in an Element Declaration inside a DTD:
    #
    #   <?xml version="1.0"?><?TEST-STYLE PIDATA?>
    #   <!DOCTYPE staff SYSTEM "staff.dtd" [
    #      <!ELEMENT div1 (head, (p | list | note)*, div2*)>
    #   ]>
    #   </root>
    #
    # ElementContent represents the binary tree inside the <!ELEMENT> tag shown above that lists the
    # possible content for the div1 tag.
    class ::Nokogiri::XML::ElementContent
      include ::Nokogiri::XML::PP::Node

      # Possible definitions of type
      ::Nokogiri::XML::ElementContent::PCDATA: 1

      ::Nokogiri::XML::ElementContent::ELEMENT: 2

      ::Nokogiri::XML::ElementContent::SEQ: 3

      ::Nokogiri::XML::ElementContent::OR: 4

      # Possible content occurrences
      ::Nokogiri::XML::ElementContent::ONCE: 1

      ::Nokogiri::XML::ElementContent::OPT: 2

      ::Nokogiri::XML::ElementContent::MULT: 3

      ::Nokogiri::XML::ElementContent::PLUS: 4

      attr_reader document: untyped

      # #
      # Get the children of this ElementContent node
      def children: () -> ::Array[untyped]

      private

      def inspect_attributes: () -> ::Array[:prefix | :name | :type | :occur | :children]
    end
  end
end

