module ::Nokogiri
  module ::Nokogiri::HTML5
    # Since v1.12.0
    #
    # 💡 HTML5 functionality is not available when running JRuby.
    module ::Nokogiri::HTML5::Node
      def inner_html: (?::Hash[untyped, untyped] options) -> untyped

      def write_to: (untyped io, *untyped options) ?{ (untyped) -> untyped } -> untyped

      def fragment: (untyped tags) -> untyped

      private

      # HTML elements can have attributes that contain colons.
      # Nokogiri::XML::Node#[]= treats names with colons as a prefixed QName
      # and tries to create an attribute in a namespace. This is especially
      # annoying with attribute names like xml:lang since libxml2 will
      # actually create the xml namespace if it doesn't exist already.
      def add_child_node_and_reparent_attrs: (untyped node) -> untyped
    end
  end
end

