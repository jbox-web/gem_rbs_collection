      ::Nokogiri::HTML4::ElementDescription::BGCOLOR_ATTR: ::Array["bgcolor"]

      ::Nokogiri::HTML4::ElementDescription::LI_ELT: ::Array["li"]

      ::Nokogiri::HTML4::ElementDescription::UL_DEPR: ::Array["type" | "compact"]

      ::Nokogiri::HTML4::ElementDescription::DIR_ATTR: ::Array["dir"]
    end
  end
end

module ::Nokogiri
  module ::Nokogiri::HTML4
    # :nodoc: all
    class ::Nokogiri::HTML4::EncodingReader
      class ::Nokogiri::HTML4::EncodingReader::EncodingFound < ::StandardError
        attr_reader found_encoding: untyped

        def initialize: (untyped encoding) -> void
      end

      class ::Nokogiri::HTML4::EncodingReader::SAXHandler < ::Nokogiri::XML::SAX::Document
        attr_reader encoding: untyped

        def initialize: () -> void

        def start_element: (untyped name, ?untyped attrs) -> (nil | untyped)
      end

      class ::Nokogiri::HTML4::EncodingReader::JumpSAXHandler < ::Nokogiri::HTML4::EncodingReader::SAXHandler
        def initialize: (untyped jumptag) -> void

        def start_element: (untyped name, ?untyped attrs) -> nil
      end

      def self.detect_encoding: (untyped chunk) -> untyped

      def initialize: (untyped io) -> void

      # This method is used by the C extension so that
      # Nokogiri::HTML4::Document#read_io() does not leak memory when
      # EncodingFound is raised.
      attr_reader encoding_found: untyped

      def read: (untyped len) -> (nil | untyped)
    end
  end
end

