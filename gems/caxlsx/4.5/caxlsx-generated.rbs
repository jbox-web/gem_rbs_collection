    # creates a new Tables object
    def initialize: (untyped worksheet) -> void

    # The worksheet that owns this collection of tables
    # @return [Worksheet]
    attr_reader worksheet: untyped

    # serialize the conditional formatting
    def to_xml_string: (?untyped str) -> (nil | untyped)
  end
