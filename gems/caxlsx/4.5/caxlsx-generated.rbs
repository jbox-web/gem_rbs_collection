  ::Axlsx::APP_CT: "application/vnd.openxmlformats-officedocument.extended-properties+xml"

  # rels content type
  ::Axlsx::RELS_CT: "application/vnd.openxmlformats-package.relationships+xml"

  # styles content type
  ::Axlsx::STYLES_CT: "application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"

  # xml content type
