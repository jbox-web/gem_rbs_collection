module ::Axlsx
  # CellAlignment stores information about the cell alignment of a style Xf Object.
  # @note Using Styles#add_style is the recommended way to manage cell alignment.
  # @see Styles#add_style
  class ::Axlsx::CellAlignment
    include ::Axlsx::SerializedAttributes

    include ::Axlsx::OptionsParser

    # Create a new cell_alignment object
    # @option options [Symbol] horizontal
    # @option options [Symbol] vertical
    # @option options [Integer] text_rotation
    # @option options [Boolean] wrap_text
    # @option options [Integer] indent
    # @option options [Integer] relative_indent
    # @option options [Boolean] justify_last_line
    # @option options [Boolean] shrink_to_fit
    # @option options [Integer] reading_order
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # The horizontal alignment of the cell.
    # @note
    #  The horizontal cell alignment style must be one of
    #   :general
    #   :left
    #   :center
    #   :right
    #   :fill
    #   :justify
    #   :centerContinuous
    #   :distributed
    # @return [Symbol]
    attr_reader horizontal: untyped

    # The vertical alignment of the cell.
    # @note
    #  The vertical cell allingment style must be one of the following:
    #   :top
    #   :center
    #   :bottom
    #   :justify
    #   :distributed
    # @return [Symbol]
    attr_reader vertical: untyped

    # The textRotation of the cell.
    # @return [Integer]
    attr_reader text_rotation: untyped

    alias textRotation text_rotation

    # Indicate if the text of the cell should wrap
    # @return [Boolean]
    attr_reader wrap_text: untyped

    alias wrapText wrap_text

    # The amount of indent
    # @return [Integer]
    attr_reader indent: untyped

    # The amount of relativeIndent
    # @return [Integer]
    attr_reader relative_indent: untyped

    alias relativeIndent relative_indent

    # Indicate if the last line should be justified.
    # @return [Boolean]
    attr_reader justify_last_line: untyped

    alias justifyLastLine justify_last_line

    # Indicate if the text should be shrunk to the fit in the cell.
    # @return [Boolean]
    attr_reader shrink_to_fit: untyped

    alias shrinkToFit shrink_to_fit

    # The reading order of the text
    # 0 Context Dependent
    # 1 Left-to-Right
    # 2 Right-to-Left
    # @return [Integer]
    attr_reader reading_order: untyped

    alias readingOrder reading_order

    # @see horizontal
    def horizontal=: (untyped v) -> untyped

    # @see vertical
    def vertical=: (untyped v) -> untyped

    # @see textRotation
    def text_rotation=: (untyped v) -> untyped

    alias textRotation= text_rotation=

    # @see wrapText
    def wrap_text=: (untyped v) -> untyped

    alias wrapText= wrap_text=

    # @see indent
    def indent=: (untyped v) -> untyped

    # @see relativeIndent
    def relative_indent=: (untyped v) -> untyped

    alias relativeIndent= relative_indent=

    # @see justifyLastLine
    def justify_last_line=: (untyped v) -> untyped

    alias justifyLastLine= justify_last_line=

    # @see shrinkToFit
    def shrink_to_fit=: (untyped v) -> untyped

    alias shrinkToFit= shrink_to_fit=

    # @see readingOrder
    def reading_order=: (untyped v) -> untyped

    alias readingOrder= reading_order=

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

