    def marker_symbol=: (untyped v) -> untyped

    # @see smooth
    def smooth=: (untyped v) -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped

    private

    # assigns the data for this series
