    def ax_pos=: (untyped v) -> untyped

    alias axPos= ax_pos=

    # the position of the tick labels
    # must be one of [:nextTo, :high, :low1]
    def tick_lbl_pos=: (untyped v) -> untyped

    alias tickLblPos= tick_lbl_pos=

    ::Axlsx::Axis::VALID_TICK_MARK_VALUES: ::Array[:cross | :in | :none | :out]

    # the type of major tick mark
    # must be one of [:cross, :in, :none, :out]
    def major_tick_mark=: (untyped v) -> untyped

    alias majorTickMark= major_tick_mark=

    # the type of minor tick mark
    # must be one of [:cross, :in, :none, :out]
    def minor_tick_mark=: (untyped v) -> untyped

    alias minorTickMark= minor_tick_mark=

    # The number format format code for this axis
    # default :General
    def format_code=: (untyped v) -> untyped

    # Specify if gridlines should be shown for this axis
    # default true
    def gridlines=: (untyped v) -> untyped

    # Specify if axis should be removed from the chart
    # default false
    def delete=: (untyped v) -> untyped

    # specifies how the perpendicular axis is crossed
    # must be one of [:autoZero, :min, :max]
    def crosses=: (untyped v) -> untyped

    # Specify the degree of label rotation to apply to labels
    # default true
    def label_rotation=: (untyped v) -> untyped

    # The title object for the chart.
    # @param [String, Cell] v
    # @return [Title]
    def title=: (untyped v) -> (::Axlsx::Cell | ::String | nil)

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # The Bar3DChart is a three dimensional barchart (who would have guessed?) that you can add to your worksheet.
  # @see Worksheet#add_chart
  # @see Chart#add_series
  # @see Package#serialize
  # @see README for an example
  class ::Axlsx::Bar3DChart < ::Axlsx::Chart
    # the category axis
    # @return [CatAxis]
    def cat_axis: () -> untyped

    alias catAxis cat_axis

    # the value axis
    # @return [ValAxis]
    def val_axis: () -> untyped

    alias valAxis val_axis

    # The direction of the bars in the chart
    # must be one of [:bar, :col]
    # @return [Symbol]
    def bar_dir: () -> untyped

    alias barDir bar_dir

    # space between bar or column clusters, as a percentage of the bar or column width.
    # @return [Integer]
    attr_reader gap_depth: untyped

    alias gapDepth gap_depth

    # space between bar or column clusters, as a percentage of the bar or column width.
    # @return [Integer]
    def gap_width: () -> untyped

    alias gapWidth gap_width

    # grouping for a column, line, or area chart.
    # must be one of  [:percentStacked, :clustered, :standard, :stacked]
    # @return [Symbol]
    def grouping: () -> untyped

    # The shabe of the bars or columns
    # must be one of  [:cone, :coneToMax, :box, :cylinder, :pyramid, :pyramidToMax]
    # @return [Symbol]
    def shape: () -> untyped

    # Creates a new bar chart object
    # @param [GraphicFrame] frame The workbook that owns this chart.
    # @option options [Cell, String] title
    # @option options [Boolean] show_legend
    # @option options [Symbol] bar_dir
    # @option options [Symbol] grouping
    # @option options [String] gap_width
    # @option options [String] gap_depth
    # @option options [Symbol] shape
    # @option options [Integer] rot_x
    # @option options [String] h_percent
    # @option options [Integer] rot_y
    # @option options [String] depth_percent
    # @option options [Boolean] r_ang_ax
    # @option options [Integer] perspective
    # @see Chart
    # @see View3D
    def initialize: (untyped frame, ?::Hash[untyped, untyped] options) -> void

    # The direction of the bars in the chart
    # must be one of [:bar, :col]
    def bar_dir=: (untyped v) -> untyped

    alias barDir= bar_dir=

    # grouping for a column, line, or area chart.
    # must be one of  [:percentStacked, :clustered, :standard, :stacked]
    def grouping=: (untyped v) -> untyped

    # space between bar or column clusters, as a percentage of the bar or column width.
    def gap_width=: (untyped v) -> untyped

    alias gapWidth= gap_width=

    # space between bar or column clusters, as a percentage of the bar or column width.
    def gap_depth=: (untyped v) -> untyped

    alias gapDepth= gap_depth=

    # The shabe of the bars or columns
    # must be one of  [:cone, :coneToMax, :box, :cylinder, :pyramid, :pyramidToMax]
    def shape=: (untyped v) -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped

    # A hash of axes used by this chart. Bar charts have a value and
    # category axes specified via axes[:val_axes] and axes[:cat_axis]
    # @return [Axes]
    def axes: () -> untyped
  end
end

