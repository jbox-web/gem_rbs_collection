    # @option options [NumFmt] numFmt
    # @option options [Fill] fill
    # @option options [Font] font
    # @option options [CellAlignment] alignment
    # @option options [CellProtection] protection
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # @see Dxf#alignment
    def alignment=: (untyped v) -> untyped

    # @see protection
    def protection=: (untyped v) -> untyped

    # @see numFmt
    def numFmt=: (untyped v) -> untyped

    # @see font
    def font=: (untyped v) -> untyped

    # @see border
    def border=: (untyped v) -> untyped

    # @see fill
    def fill=: (untyped v) -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

