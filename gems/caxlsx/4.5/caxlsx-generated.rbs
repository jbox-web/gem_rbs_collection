    # 57 = SuperA/SuperA/A4 paper (227 mm by 356 mm)
    # 58 = SuperB/SuperB/A3 paper (305 mm by 487 mm)
    # 59 = Letter plus paper (8.5 in. by 12.69 in.)
    # 60 = A4 plus paper (210 mm by 330 mm)
    # 61 = A5 transverse paper (148 mm by 210 mm)
    # 62 = JIS B5 transverse paper (182 mm by 257 mm)
    # 63 = A3 extra paper (322 mm by 445 mm)
    # 64 = A5 extra paper (174 mm by 235 mm)
    # 65 = ISO B5 extra paper (201 mm by 276 mm)
    # 66 = A2 paper (420 mm by 594 mm)
    # 67 = A3 transverse paper (297 mm by 420 mm)
    # 68 = A3 extra transverse paper (322 mm by 445 mm)
    # 69 = Japanese Double Postcard (200 mm x 148 mm)
    # 70 = A6 (105 mm x 148 mm
    # 71 = Japanese Envelope Kaku #2
    # 72 = Japanese Envelope Kaku #3
    # 73 = Japanese Envelope Chou #3
    # 74 = Japanese Envelope Chou #4
    # 75 = Letter Rotated (11in x 8 1/2 11 in)
    # 76 = A3 Rotated (420 mm x 297 mm)
    # 77 = A4 Rotated (297 mm x 210 mm)
    # 78 = A5 Rotated (210 mm x 148 mm)
    # 79 = B4 (JIS) Rotated (364 mm x 257 mm)
    # 80 = B5 (JIS) Rotated (257 mm x 182 mm)
    # 81 = Japanese Postcard Rotated (148 mm x 100 mm)
    # 82 = Double Japanese Postcard Rotated (148 mm x 200 mm)
    # 83 = A6 Rotated (148 mm x 105 mm)
    # 84 = Japanese Envelope Kaku #2 Rotated
    # 85 = Japanese Envelope Kaku #3 Rotated
    # 86 = Japanese Envelope Chou #3 Rotated
    # 87 = Japanese Envelope Chou #4 Rotated
    # 88 = B6 (JIS) (128 mm x 182 mm)
    # 89 = B6 (JIS) Rotated (182 mm x 128 mm)
    # 90 = (12 in x 11 in)
    # 91 = Japanese Envelope You #4
    # 92 = Japanese Envelope You #4 Rotated
    # 93 = PRC 16K (146 mm x 215 mm)
    # 94 = PRC 32K (97 mm x 151 mm)
    # 95 = PRC 32K(Big) (97 mm x 151 mm)
    # 96 = PRC Envelope #1 (102 mm x 165 mm)
    # 97 = PRC Envelope #2 (102 mm x 176 mm)
    # 98 = PRC Envelope #3 (125 mm x 176 mm)
    # 99 = PRC Envelope #4 (110 mm x 208 mm)
    # 100 = PRC Envelope #5 (110 mm x 220 mm)
    # 101 = PRC Envelope #6 (120 mm x 230 mm)
    # 102 = PRC Envelope #7 (160 mm x 230 mm)
    # 103 = PRC Envelope #8 (120 mm x 309 mm)
    # 104 = PRC Envelope #9 (229 mm x 324 mm)
    # 105 = PRC Envelope #10 (324 mm x 458 mm)
    # 106 = PRC 16K Rotated
    # 107 = PRC 32K Rotated
    # 108 = PRC 32K(Big) Rotated
    # 109 = PRC Envelope #1 Rotated (165 mm x 102 mm)
    # 110 = PRC Envelope #2 Rotated (176 mm x 102 mm)
    # 111 = PRC Envelope #3 Rotated (176 mm x 125 mm)
    # 112 = PRC Envelope #4 Rotated (208 mm x 110 mm)
    # 113 = PRC Envelope #5 Rotated (220 mm x 110 mm)
    # 114 = PRC Envelope #6 Rotated (230 mm x 120 mm)
    # 115 = PRC Envelope #7 Rotated (230 mm x 160 mm)
    # 116 = PRC Envelope #8 Rotated (309 mm x 120 mm)
    # 117 = PRC Envelope #9 Rotated (324 mm x 229 mm)
    # 118 = PRC Envelope #10 Rotated (458 mm x 324 mm)
    # @return [Integer]
    attr_reader paper_size: untyped

    # Sets the paper size for printing.
    # @see PageSetup#paper_size
    # @return integer
    def paper_size=: (untyped size) -> untyped

    # Set some or all page settings at once.
    # @param [Hash] options The page settings to set (possible keys are :fit_to_height, :fit_to_width, :orientation, :paper_height, :paper_width, and :scale).
    def set: (untyped options) -> untyped

    # @see fit_to_height
    def fit_to_height=: (untyped v) -> untyped

    # @see fit_to_width
    def fit_to_width=: (untyped v) -> untyped

    # @see orientation
    def orientation=: (untyped v) -> untyped

    # @see paper_height
    def paper_height=: (untyped v) -> untyped

    # @see paper_width
    def paper_width=: (untyped v) -> untyped

    # @see scale
    def scale=: (untyped v) -> untyped

    # convenience method to achieve sanity when setting fit_to_width and fit_to_height
    # as they both default to 1 if only their counterpart is specified.
    # @note This method will overwrite any value you explicitly set via the fit_to_height or fit_to_width methods.
    # @option options [Integer] width The number of pages to fit this worksheet on horizontally. Default 999
    # @option options [Integer] height The number of pages to fit this worksheet on vertically. Default 999
    def fit_to: (?::Hash[untyped, untyped] options) -> ::Array[untyped]

    # helper method for worksheet to determine if the page setup is configured for fit to page printing
    # We treat any page set up that has a value set for fit_to_width or fit_to_height value as fit_to_page.
    # @return [Boolean]
    def fit_to_page?: () -> (false | true)

    # Serializes the page settings element.
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # Pane options for a worksheet.
  #
  # @note The recommended way to manage the pane options is via SheetView#pane
  # @see SheetView#pane
  class ::Axlsx::Pane
    include ::Axlsx::OptionsParser

    include ::Axlsx::SerializedAttributes

    # Creates a new {Pane} object
    # @option options [Symbol] active_pane Active Pane
    # @option options [Symbol] state Split State
    # @option options [Cell, String] top_left_cell Top Left Visible Cell
    # @option options [Integer] x_split Horizontal Split Position
    # @option options [Integer] y_split Vertical Split Position
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # Active Pane
    # The pane that is active.
    # Options are
    #  * bottom_left:  Bottom left pane, when both vertical and horizontal
    #                  splits are applied. This value is also used when only
    #                  a horizontal split has been applied, dividing the pane
    #                  into upper and lower regions. In that case, this value
    #                  specifies the bottom pane.
    #  * bottom_right: Bottom right pane, when both vertical and horizontal
    #                  splits are applied.
    #  * top_left:     Top left pane, when both vertical and horizontal splits
    #                  are applied. This value is also used when only a horizontal
    #                  split has been applied, dividing the pane into upper and lower
    #                  regions. In that case, this value specifies the top pane.
    #                  This value is also used when only a vertical split has
    #                  been applied, dividing the pane into right and left
    #                  regions. In that case, this value specifies the left pane
    #  * top_right:    Top right pane, when both vertical and horizontal
    #                  splits are applied. This value is also used when only
    #                  a vertical split has been applied, dividing the pane
    #                  into right and left regions. In that case, this value
    #                  specifies the right pane.
    # @see type
    # @return [Symbol]
    # default nil
    attr_reader active_pane: untyped

    # Split State
    # Indicates whether the pane has horizontal / vertical
    # splits, and whether those splits are frozen.
    # Options are
    #  * frozen:       Panes are frozen, but were not split being frozen. In
    #                  this state, when the panes are unfrozen again, a single
    #                  pane results, with no split. In this state, the split
    #                  bars are not adjustable.
    #  * frozen_split: Panes are frozen and were split before being frozen. In
    #                  this state, when the panes are unfrozen again, the split
    #                  remains, but is adjustable.
    #  * split:        Panes are split, but not frozen. In this state, the split
    #                  bars are adjustable by the user.
    # @see type
    # @return [Symbol]
    # default nil
    attr_reader state: untyped

    # Top Left Visible Cell
    # Location of the top left visible cell in the bottom
    # right pane (when in Left-To-Right mode).
    # @see type
    # @return [String]
    # default nil
    attr_reader top_left_cell: untyped

    # Horizontal Split Position
    # Horizontal position of the split, in 1/20th of a point; 0 (zero)
    # if none. If the pane is frozen, this value indicates the number
    # of columns visible in the top pane.
    # @see type
    # @return [Integer]
    # default 0
    attr_reader x_split: untyped

    # Vertical Split Position
    # Vertical position of the split, in 1/20th of a point; 0 (zero)
    # if none. If the pane is frozen, this value indicates the number
    # of rows visible in the left pane.
    # @see type
    # @return [Integer]
    # default 0
    attr_reader y_split: untyped

    # @see active_pane
    def active_pane=: (untyped v) -> untyped

    # @see state
    def state=: (untyped v) -> untyped

    # @see top_left_cell
    def top_left_cell=: (untyped v) -> untyped

    # @see x_split
    def x_split=: (untyped v) -> untyped

    # @see y_split
    def y_split=: (untyped v) -> untyped

    # Serializes the data validation
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped

    private

    def finalize: () -> (untyped | nil)
  end
end

module ::Axlsx
  # Table
  # @note Worksheet#add_pivot_table is the recommended way to create tables for your worksheets.
  # @see README for examples
  class ::Axlsx::PivotTable
    include ::Axlsx::OptionsParser

    # Creates a new PivotTable object
    # @param [String] ref The reference to where the pivot table lives like 'G4:L17'.
    # @param [String] range The reference to the pivot table data like 'A1:D31'.
    # @param [Worksheet] sheet The sheet containing the table data.
    # @option options [Cell, String] name
    # @option options [TableStyle] style
    def initialize: (untyped ref, untyped range, untyped sheet, ?::Hash[untyped, untyped] options) ?{ (untyped) -> untyped } -> void

    # Defines the headers in which subtotals are not to be included.
    # @return [Array]
    attr_accessor no_subtotals_on_headers: untyped

    # Defines the headers in which sort is applied.
    # Can be an array of headers to sort ascending by default, or a hash for specific control
    # (with headers as keys, `:ascending` or `:descending` as values).
    #
    # Examples: `["year", "month"]` or `{"year" => :descending, "month" => :descending}`
    # @return [Hash]
    attr_reader sort_on_headers: untyped

    # (see #sort_on_headers)
    def sort_on_headers=: (untyped headers) -> untyped

    # Defines which Grand Totals are to be shown.
    # @return [Symbol] The row and/or column Grand Totals that are to be shown.
    # Defaults to `:both` to show both row & column grand totals.
    # Set to `:row_only`, `:col_only`, or `:none` to hide one or both Grand Totals.
    attr_reader grand_totals: untyped

    # (see #grand_totals)
    def grand_totals=: (untyped value) -> untyped

    # Style info for the pivot table
    # @return [Hash]
    attr_accessor style_info: untyped

    # The reference to the table data
    # @return [String]
    attr_reader ref: untyped

    # The name of the table.
    # @return [String]
    attr_reader name: untyped

    # The name of the sheet.
    # @return [String]
    attr_reader sheet: untyped

    # The sheet used as data source for the pivot table
    # @return [Worksheet]
    attr_writer data_sheet: untyped

    # Whether to apply auto formatting to the pivot table.
    # @return [Boolean]
    attr_accessor use_auto_formatting: untyped

    # Whether to apply width/height formats to the pivot table.
    # @return [Boolean]
    attr_accessor apply_width_height_formats: untyped

    # @see #data_sheet
    def data_sheet: () -> untyped

    # The range where the data for this pivot table lives.
    # @return [String]
    attr_reader range: untyped

    # (see #range)
    def range=: (untyped v) -> (::String | nil)

    # The rows
    # @return [Array]
    attr_reader rows: untyped

    # (see #rows)
    def rows=: (untyped v) -> untyped

    # The columns
    # @return [Array]
    attr_reader columns: untyped

    # (see #columns)
    def columns=: (untyped v) -> untyped

    # The data as an array of either headers (String) or hashes or mix of the two.
    # Hash in format of { ref: header, num_fmt: numFmts, subtotal: subtotal }, where header is String, numFmts is Integer, and subtotal one of %w[sum count average max min product countNums stdDev stdDevp var varp]; leave subtotal blank to sum values
    # @return [Array]
    attr_reader data: untyped

    # (see #data)
    def data=: (untyped v) -> untyped

    # The pages
    # @return [String]
    attr_reader pages: untyped

    # (see #pages)
    def pages=: (untyped v) -> untyped

    # The index of this chart in the workbooks charts collection
    # @return [Integer]
    def index: () -> untyped

    # The part name for this table
    # @return [String]
    def pn: () -> ::String

    # The relationship part name of this pivot table
    # @return [String]
    def rels_pn: () -> ::String

    # The cache_definition for this pivot table
    # @return [PivotTableCacheDefinition]
    def cache_definition: () -> untyped

    # The relationships for this pivot table.
    # @return [Relationships]
    def relationships: () -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped

    # References for header cells
    # @return [Array]
    def header_cell_refs: () -> untyped

    # The header cells for the pivot table
    # @return [Array]
    def header_cells: () -> untyped

    # The values in the header cells collection
    # @return [Array]
    def header_cell_values: () -> untyped

    # The number of cells in the header_cells collection
    # @return [Integer]
    def header_cells_count: () -> untyped

    # The index of a given value in the header cells
    # @return [Integer]
    def header_index_of: (untyped value) -> untyped

    private

    def pivot_field_for: (untyped cell_ref, untyped subtotal, untyped sorttype) -> ::String

    def data_refs: () -> untyped

    def header_range: () -> untyped
  end
end

module ::Axlsx
  # Table
  # @note Worksheet#add_pivot_table is the recommended way to create tables for your worksheets.
  # @see README for examples
  class ::Axlsx::PivotTableCacheDefinition
    include ::Axlsx::OptionsParser

    # Creates a new PivotTable object
    # @param [String] pivot_table The pivot table this cache definition is in
    def initialize: (untyped pivot_table) -> void

    # # The reference to the pivot table data
    # # @return [PivotTable]
    attr_reader pivot_table: untyped

    # The index of this chart in the workbooks charts collection
    # @return [Integer]
    def index: () -> untyped

    # The part name for this table
    # @return [String]
    def pn: () -> ::String

    # The identifier for this cache
    # @return [Integer]
    def cache_id: () -> untyped

    # The relationship id for this pivot table cache definition.
    # @see Relationship#Id
    # @return [String]
    def rId: () -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # A simple, self serializing class for storing pivot tables
  class ::Axlsx::PivotTables < ::Axlsx::SimpleTypedList
    # creates a new Tables object
    def initialize: (untyped worksheet) -> void

    # The worksheet that owns this collection of pivot tables
    # @return [Worksheet]
    attr_reader worksheet: untyped

    # returns the relationships required by this collection
    def relationships: () -> (::Array[untyped] | untyped)
  end
end

module ::Axlsx
  # Options for printing a worksheet. All options are boolean and false by default.
  #
  # @note The recommended way to manage print options is via Worksheet#print_options
  # @see Worksheet#print_options
  # @see Worksheet#initialize
  class ::Axlsx::PrintOptions
    include ::Axlsx::OptionsParser

    include ::Axlsx::SerializedAttributes

    include ::Axlsx::Accessors

    # Creates a new PrintOptions object
    # @option options [Boolean] grid_lines Whether grid lines should be printed
    # @option options [Boolean] headings Whether row and column headings should be printed
    # @option options [Boolean] horizontal_centered Whether the content should be centered horizontally
    # @option options [Boolean] vertical_centered  Whether the content should be centered vertically
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # Set some or all options at once.
    # @param [Hash] options The options to set (possible keys are :grid_lines, :headings, :horizontal_centered, and :vertical_centered).
    def set: (untyped options) -> untyped

    # Serializes the page options element.
    # @note As all attributes default to "false" according to the xml schema definition, the generated xml includes only those attributes that are set to true.
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # The Protected Range class represents a set of cells in the worksheet
  # @note the recommended way to manage protected ranges with via Worksheet#protect_range
  # @see Worksheet#protect_range
  class ::Axlsx::ProtectedRange
    include ::Axlsx::OptionsParser

    include ::Axlsx::SerializedAttributes

    # Initializes a new protected range object
    # @option [String] sqref The cell range reference to protect. This can be an absolute or a relateve range however, it only applies to the current sheet.
    # @option [String] name An optional name for the protected name.
    def initialize: (?::Hash[untyped, untyped] options) ?{ (untyped) -> untyped } -> void

    # The reference for the protected range
    # @return [String]
    attr_reader sqref: untyped

    # The name of the protected range
    # @return [String]
    attr_reader name: untyped

    # @see sqref
    def sqref=: (untyped v) -> untyped

    # @see name
    def name=: (untyped v) -> untyped

    # serializes the proteted range
    # @param [String] str if this string object is provided we append
    # our output to that object. Use this - it helps limit the number of
    # objects created during serialization
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # A self serializing collection of ranges that should be protected in
  # the worksheet
  class ::Axlsx::ProtectedRanges < ::Axlsx::SimpleTypedList
    attr_reader worksheet: untyped

    def initialize: (untyped worksheet) -> void

    # Adds a protected range
    # @param [Array|String] cells A string range reference or array of cells that will be protected
    def add_range: (untyped cells) -> untyped

    # Serializes the protected ranges
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> (nil | untyped)
  end
end

module ::Axlsx
  # A simple, self serializing class for storing TextRuns
  class ::Axlsx::RichText < ::Axlsx::SimpleTypedList
    # creates a new RichText collection
    # @param [String] text -optional The text to use in creating the first RichTextRun
    # @param [Object] options -optional The options to use in creating the first RichTextRun
    # @yield [RichText] self
    def initialize: (?untyped? text, ?::Hash[untyped, untyped] options) ?{ (untyped) -> untyped } -> void

    # The cell that owns this RichText collection
    attr_reader cell: untyped

    # Assign the cell for this RichText collection
    # @param [Cell] cell The cell which all RichTextRuns in the collection will belong to
    def cell=: (untyped cell) -> untyped

    # Calculates the longest autowidth of the RichTextRuns in this collection
    # @return [Number]
    def autowidth: () -> 0

    # Creates and adds a RichTextRun to this collectino
    # @param [String] text The text to use in creating a new RichTextRun
    # @param [Object] options The options to use in creating the new RichTextRun
    def add_run: (untyped text, ?::Hash[untyped, untyped] options) -> untyped

    # The RichTextRuns we own
    # @return [RichText]
    def runs: () -> self

    # renders the RichTextRuns in this collection
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # The RichTextRun class creates and self serializing text run.
  class ::Axlsx::RichTextRun
    include ::Axlsx::OptionsParser

    attr_reader value: untyped

    # A list of allowed inline style attributes used for validation
    ::Axlsx::RichTextRun::INLINE_STYLES: ::Array[:font_name | :charset | :family | :b | :i | :strike | :outline | :shadow | :condense | :extend | :u | :vertAlign | :sz | :color | :scheme]

    def initialize: (untyped value, ?::Hash[untyped, untyped] options) -> void

    def value=: (untyped value) -> untyped

    attr_accessor cell: untyped

    # The inline font_name property for the cell
    # @return [String]
    attr_reader font_name: untyped

    # @see font_name
    def font_name=: (untyped v) -> untyped

    # The inline charset property for the cell
    # As far as I can tell, this is pretty much ignored. However, based on the spec it should be one of the following:
    # 0 ￼ ANSI_CHARSET
    # 1 DEFAULT_CHARSET
    # 2 SYMBOL_CHARSET
    # 77 MAC_CHARSET
    # 128 SHIFTJIS_CHARSET
    # 129 ￼ HANGUL_CHARSET
    # 130 ￼ JOHAB_CHARSET
    # 134 ￼ GB2312_CHARSET
    # 136 ￼ CHINESEBIG5_CHARSET
    # 161 ￼ GREEK_CHARSET
    # 162 ￼ TURKISH_CHARSET
    # 163 ￼ VIETNAMESE_CHARSET
    # 177 ￼ HEBREW_CHARSET
    # 178 ￼ ARABIC_CHARSET
    # 186 ￼ BALTIC_CHARSET
    # 204 ￼ RUSSIAN_CHARSET
    # 222 ￼ THAI_CHARSET
    # 238 ￼ EASTEUROPE_CHARSET
    # 255 ￼ OEM_CHARSET
    # @return [String]
    attr_reader charset: untyped

    # @see charset
    def charset=: (untyped v) -> untyped

    # The inline family property for the cell
    # @return [Integer]
    # 1 Roman
    # 2 Swiss
    # 3 Modern
    # 4 Script
    # 5 Decorative
    attr_reader family: untyped

    # @see family
    def family=: (untyped v) -> untyped

    # The inline bold property for the cell
    # @return [Boolean]
    attr_reader b: untyped

    # @see b
    def b=: (untyped v) -> untyped

    # The inline italic property for the cell
    # @return [Boolean]
    attr_reader i: untyped

    # @see i
    def i=: (untyped v) -> untyped

    # The inline strike property for the cell
    # @return [Boolean]
    attr_reader strike: untyped

    # @see strike
    def strike=: (untyped v) -> untyped

    # The inline outline property for the cell
    # @return [Boolean]
    attr_reader outline: untyped

    # @see outline
    def outline=: (untyped v) -> untyped

    # The inline shadow property for the cell
    # @return [Boolean]
    attr_reader shadow: untyped

    # @see shadow
    def shadow=: (untyped v) -> untyped

    # The inline condense property for the cell
    # @return [Boolean]
    attr_reader condense: untyped

    # @see condense
    def condense=: (untyped v) -> untyped

    # The inline extend property for the cell
    # @return [Boolean]
    attr_reader extend: untyped

    # @see extend
    def extend=: (untyped v) -> untyped

    # The inline underline property for the cell.
    # It must be one of :none, :single, :double, :singleAccounting, :doubleAccounting, true
    # @return [Boolean]
    # @return [String]
    # @note true is for backwards compatibility and is reassigned to :single
    attr_reader u: untyped

    # @see u
    def u=: (untyped v) -> untyped

    # The inline color property for the cell
    # @return [Color]
    attr_reader color: untyped

    # @param [String] v The 8 character representation for an rgb color #FFFFFFFF"
    def color=: (untyped v) -> untyped

    # The inline sz property for the cell
    # @return [Inteter]
    attr_reader sz: untyped

    # @see sz
    def sz=: (untyped v) -> untyped

    # The inline vertical alignment property for the cell
    # this must be one of [:baseline, :subscript, :superscript]
    # @return [Symbol]
    attr_reader vertAlign: untyped

    # @see vertAlign
    def vertAlign=: (untyped v) -> untyped

    # The inline scheme property for the cell
    # this must be one of [:none, major, minor]
    # @return [Symbol]
    attr_reader scheme: untyped

    # @see scheme
    def scheme=: (untyped v) -> untyped

    # Tries to work out the width of the longest line in the run
    # @param [Array] widtharray this array is populated with the widths of each line in the run.
    # @return [Array]
    def autowidth: (untyped widtharray) -> (nil | untyped)

    # Utility method for setting inline style attributes
    def set_run_style: (untyped validator, untyped attr, untyped value) -> (nil | untyped)

    # Serializes the RichTextRun
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped

    private

    # Returns the width of a string according to the current style
    # This is still not perfect...
    #  - scaling is not linear as font sizes increase
    def string_width: (untyped string, untyped font_size) -> untyped

    # we scale the font size if bold style is applied to either the style font or
    # the cell itself. Yes, it is a bit of a hack, but it is much better than using
    # imagemagick and loading metrics for every character.
    def font_size: () -> untyped

    def style: () -> untyped

    def styles: () -> untyped

    # Converts the value to the correct XML representation (fixes issues with
    # Numbers)
    def xml_value: (untyped value) -> untyped
  end
end

module ::Axlsx
  # A Row is a single row in a worksheet.
  # @note The recommended way to manage rows and cells is to use Worksheet#add_row
  # @see Worksheet#add_row
  class ::Axlsx::Row < ::Axlsx::SimpleTypedList
    include ::Axlsx::SerializedAttributes

    include ::Axlsx::Accessors

    # Creates a new row. New Cell objects are created based on the values, types and style options.
    # A new cell is created for each item in the values array. style and types options are applied as follows:
    #   If the types option is defined and is a symbol it is applied to all the cells created.
    #   If the types option is an array, cell types are applied by index for each cell
    #   If the types option is not set, the cell will automatically determine its type.
    #   If the style option is defined and is an Integer, it is applied to all cells created.
    #   If the style option is an array, style is applied by index for each cell.
    #   If the style option is not defined, the default style (0) is applied to each cell.
    # @param [Worksheet] worksheet
    # @option options [Array] values
    # @option options [Array, Symbol] types
    # @option options [Array, Integer] style
    # @option options [Array, Boolean] escape_formulas
    # @option options [Float] height the row's height (in points)
    # @option options [Integer] offset - add empty columns before values
    # @see Row#array_to_cells
    # @see Cell
    def initialize: (untyped worksheet, ?untyped values, ?::Hash[untyped, untyped] options) -> void

    # The worksheet this row belongs to
    # @return [Worksheet]
    attr_reader worksheet: untyped

    # Row height measured in point size. There is no margin padding on row height.
    # @return [Float]
    def height: () -> (untyped | nil)

    # Outlining level of the row, when outlining is on
    # @return [Integer]
    attr_reader outline_level: untyped

    alias outlineLevel outline_level

    # The style applied to the row. This affects the entire row.
    # @return [Integer]
    attr_reader s: untyped

    # @see Row#s
    def s=: (untyped v) -> untyped

    # @see Row#outline
    def outline_level=: (untyped v) -> untyped

    alias outlineLevel= outline_level=

    # The index of this row in the worksheet
    # @return [Integer]
    def row_index: () -> untyped

    # Serializes the row
    # @param [Integer] r_index The row index, 0 based.
    # @param [String] str The string this rows xml will be appended to.
    # @return [String]
    def to_xml_string: (untyped r_index, ?untyped str) -> untyped

    # Adds a single cell to the row based on the data provided and updates the worksheet's autofit data.
    # @return [Cell]
    def add_cell: (?::String value, ?::Hash[untyped, untyped] options) -> untyped

    # Sets the color for every cell in this row.
    def color=: (untyped color) -> untyped

    # Sets the style for every cell in this row.
    def style=: (untyped style) -> untyped

    # Sets escape_formulas for every cell in this row. This determines whether to treat
    # values starting with an equals sign as formulas or as literal strings.
    # @param [Array, Boolean] value The value to set.
    def escape_formulas=: (untyped value) -> untyped

    # @see height
    def height=: (untyped v) -> (untyped | nil)

    # return cells
    def cells: () -> self

    private

    # assigns the owning worksheet for this row
    def worksheet=: (untyped v) -> untyped

    # Converts values, types, and style options into cells and associates them with this row.
    # A new cell is created for each item in the values array.
    # If value option is defined and is a symbol it is applied to all the cells created.
    # If the value option is an array, cell types are applied by index for each cell
    # If the style option is defined and is an Integer, it is applied to all cells created.
    # If the style option is an array, style is applied by index for each cell.
    # @option options [Array] values
    # @option options [Array, Symbol] types
    # @option options [Array, Integer] style
    # @option options [Array, Boolean] escape_formulas
    def array_to_cells: (untyped values, ?::Hash[untyped, untyped] options) -> untyped
  end
end

module ::Axlsx
  class ::Axlsx::RowBreaks < ::Axlsx::SimpleTypedList
    def initialize: () -> void

    # Adds a row break
    # @param [Hash] options The options for the break to be created.
    # max and man values are fixed.
    # @see Break
    def add_break: (untyped options) -> untyped

    # <rowBreaks count="3" manualBreakCount="3">
    # <brk id="1" max="16383" man="1"/>
    # <brk id="7" max="16383" man="1"/>
    # <brk id="13" max="16383" man="1"/>
    # </rowBreaks>
    def to_xml_string: (?untyped str) -> (nil | untyped)
  end
end

module ::Axlsx
  # Selection options for worksheet panes.
  #
  # @note The recommended way to manage the selection pane options is via SheetView#add_selection
  # @see SheetView#add_selection
  class ::Axlsx::Selection
    include ::Axlsx::OptionsParser

    include ::Axlsx::SerializedAttributes

    # Creates a new {Selection} object
    # @option options [Cell, String] active_cell Active Cell Location
    # @option options [Integer] active_cell_id Active Cell Index
    # @option options [Symbol] pane Pane
    # @option options [String] sqref Sequence of References
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # Active Cell Location
    # Location of the active cell.
    # @see type
    # @return [String]
    # default nil
    attr_reader active_cell: untyped

    # Active Cell Index
    # 0-based index of the range reference (in the array of references listed in sqref)
    # containing the active cell. Only used when the selection in sqref is not contiguous.
    # Therefore, this value needs to be aware of the order in which the range references are
    # written in sqref.
    # When this value is out of range then activeCell can be used.
    # @see type
    # @return [Integer]
    # default nil
    attr_reader active_cell_id: untyped

    # Pane
    # The pane to which this selection belongs.
    # Options are
    #  * bottom_left:  Bottom left pane, when both vertical and horizontal
    #                  splits are applied. This value is also used when only
    #                  a horizontal split has been applied, dividing the pane
    #                  into upper and lower regions. In that case, this value
    #                  specifies the bottom pane.
    #  * bottom_right: Bottom right pane, when both vertical and horizontal
    #                  splits are applied.
    #  * top_left:     Top left pane, when both vertical and horizontal splits
    #                  are applied. This value is also used when only a horizontal
    #                  split has been applied, dividing the pane into upper and lower
    #                  regions. In that case, this value specifies the top pane.
    #                  This value is also used when only a vertical split has
    #                  been applied, dividing the pane into right and left
    #                  regions. In that case, this value specifies the left pane
    #  * top_right:    Top right pane, when both vertical and horizontal
    #                  splits are applied. This value is also used when only
    #                  a vertical split has been applied, dividing the pane
    #                  into right and left regions. In that case, this value
    #                  specifies the right pane.
    # @see type
    # @return [Symbol]
    # default nil
    attr_reader pane: untyped

    # Sequence of References
    # Range of the selection. Can be non-contiguous set of ranges.
    # @see type
    # @return [String]
    # default nil
    attr_reader sqref: untyped

    # @see active_cell
    def active_cell=: (untyped v) -> untyped

    # @see active_cell_id
    def active_cell_id=: (untyped v) -> untyped

    # @see pane
    def pane=: (untyped v) -> untyped

    # @see sqref
    def sqref=: (untyped v) -> untyped

    # Serializes the data validation
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

