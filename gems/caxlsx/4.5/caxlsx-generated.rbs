    # @raise [ArgumentError] If axi_id or cross_ax are not unsigned integers
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # the fill color to use in the axis shape properties. This should be a 6 character long hex string
    # e.g. FF0000 for red
    # @return [String]
    attr_reader color: untyped

    # the id of the axis.
    # @return [Integer]
    attr_reader id: untyped

    alias axID id

    # The perpendicular axis
    # @return [Integer]
    attr_reader cross_axis: untyped

    alias crossAx cross_axis

    # The scaling of the axis
    # @see Scaling
    # @return [Scaling]
    attr_reader scaling: untyped

    # The position of the axis
    # must be one of [:l, :r, :t, :b]
    # @return [Symbol]
    attr_reader ax_pos: untyped

    alias axPos ax_pos

    # the position of the tick labels
    # must be one of [:nextTo, :high, :low]
    # @return [Symbol]
    attr_reader tick_lbl_pos: untyped

    alias tickLblPos tick_lbl_pos

    # the type of major tick mark
    # must be one of [:cross, :in, :none, :out]
    # @return [Symbol]
    attr_reader major_tick_mark: untyped

    alias majorTickMark major_tick_mark

    # the type of minor tick mark
    # must be one of [:cross, :in, :none, :out]
    # @return [Symbol]
    attr_reader minor_tick_mark: untyped

    alias minorTickMark minor_tick_mark

    # The number format format code for this axis
    # default :General
    # @return [String]
    attr_reader format_code: untyped

    # specifies how the perpendicular axis is crossed
    # must be one of [:autoZero, :min, :max]
    # @return [Symbol]
    attr_reader crosses: untyped

    # specifies how the degree of label rotation
    # @return [Integer]
    attr_reader label_rotation: untyped

    # specifies if gridlines should be shown in the chart
    # @return [Boolean]
    attr_reader gridlines: untyped

    # specifies if gridlines should be shown in the chart
    # @return [Boolean]
    attr_reader delete: untyped

    # the title for the axis. This can be a cell or a fixed string.
    attr_reader title: untyped

    # The color for this axis. This value is used when rendering the axis line in the chart.
    # colors should be in 6 character rbg format
    # @return [String] the rbg color assigned.
    # @see color
    def color=: (untyped color_rgb) -> untyped

