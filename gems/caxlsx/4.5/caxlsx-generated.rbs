module ::Axlsx
  # 3D attributes for a chart.
  class ::Axlsx::View3D
    include ::Axlsx::OptionsParser

    # Creates a new View3D for charts
    # @option options [Integer] rot_x
    # @option options [String] h_percent
    # @option options [Integer] rot_y
    # @option options [String] depth_percent
    # @option options [Boolean] r_ang_ax
    # @option options [Integer] perspective
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # Validation for hPercent
    ::Axlsx::View3D::H_PERCENT_REGEX: ::Regexp

    # validation for depthPercent
    ::Axlsx::View3D::DEPTH_PERCENT_REGEX: ::Regexp

    # x rotation for the chart
    # must be between -90 and 90
    # @return [Integer]
    attr_reader rot_x: untyped

    alias rotX rot_x

    # height of chart as % of chart width
    # must be between 5% and 500%
    # @return [String]
    attr_reader h_percent: untyped

    alias hPercent h_percent

    # y rotation for the chart
    # must be between 0 and 360
    # @return [Integer]
    attr_reader rot_y: untyped

    alias rotY rot_y

    # depth or chart as % of chart width
    # must be between 20% and 2000%
    # @return [String]
    attr_reader depth_percent: untyped

    alias depthPercent depth_percent

    # Chart axis are at right angles
    # @return [Boolean]
    attr_reader r_ang_ax: untyped

    alias rAngAx r_ang_ax

    # field of view angle
    # @return [Integer]
    attr_reader perspective: untyped

    # @see rot_x
    def rot_x=: (untyped v) -> untyped

    alias rotX= rot_x=

    # @see h_percent
    def h_percent=: (untyped v) -> untyped

    alias hPercent= h_percent=

    # @see rot_y
    def rot_y=: (untyped v) -> untyped

    alias rotY= rot_y=

    # @see depth_percent
    def depth_percent=: (untyped v) -> untyped

    alias depthPercent= depth_percent=

    # @see r_ang_ax
    def r_ang_ax=: (untyped v) -> untyped

    alias rAngAx= r_ang_ax=

    # @see perspective
    def perspective=: (untyped v) -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped

    private

    # NOTE: move this to Axlsx module if we find the same pattern elsewhere.
    def element_for_attribute: (untyped name, ?::String namespace) -> ("" | untyped)
  end
end

