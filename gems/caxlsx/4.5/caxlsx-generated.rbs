module ::Axlsx
  # The Xf class defines a formatting record for use in Styles. The recommended way to manage styles for your workbook is with Styles#add_style
  # @see Styles#add_style
  class ::Axlsx::Xf
    include ::Axlsx::SerializedAttributes

    include ::Axlsx::OptionsParser

    # Creates a new Xf object
    # @option options [Integer] numFmtId
    # @option options [Integer] fontId
    # @option options [Integer] fillId
    # @option options [Integer] borderId
    # @option options [Integer] xfId
    # @option options [Boolean] quotePrefix
    # @option options [Boolean] pivotButton
    # @option options [Boolean] applyNumberFormat
    # @option options [Boolean] applyFont
    # @option options [Boolean] applyFill
    # @option options [Boolean] applyBorder
    # @option options [Boolean] applyAlignment
    # @option options [Boolean] applyProtection
    # @option options [CellAlignment] alignment
    # @option options [CellProtection] protection
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # The cell alignment for this style
    # @return [CellAlignment]
    # @see CellAlignment
    attr_reader alignment: untyped

    # The cell protection for this style
    # @return [CellProtection]
    # @see CellProtection
    attr_reader protection: untyped

    # id of the numFmt to apply to this style
    # @return [Integer]
    attr_reader numFmtId: untyped

    # index (0 based) of the font to be used in this style
    # @return [Integer]
    attr_reader fontId: untyped

    # index (0 based) of the fill to be used in this style
    # @return [Integer]
    attr_reader fillId: untyped

    # index (0 based) of the border to be used in this style
    # @return [Integer]
    attr_reader borderId: untyped

    # index (0 based) of cellStylesXfs item to be used in this style. Only applies to cellXfs items
    # @return [Integer]
    attr_reader xfId: untyped

    # indicates if text should be prefixed by a single quote in the cell
    # @return [Boolean]
    attr_reader quotePrefix: untyped

    # indicates if the cell has a pivot table drop down button
    # @return [Boolean]
    attr_reader pivotButton: untyped

    # indicates if the numFmtId should be applied
    # @return [Boolean]
    attr_reader applyNumberFormat: untyped

    # indicates if the fontId should be applied
    # @return [Boolean]
    attr_reader applyFont: untyped

    # indicates if the fillId should be applied
    # @return [Boolean]
    attr_reader applyFill: untyped

    # indicates if the borderId should be applied
    # @return [Boolean]
    attr_reader applyBorder: untyped

    # Indicates if the alignment options should be applied
    # @return [Boolean]
    attr_reader applyAlignment: untyped

    # Indicates if the protection options should be applied
    # @return [Boolean]
    attr_reader applyProtection: untyped

    # @see Xf#alignment
    def alignment=: (untyped v) -> untyped

    # @see protection
    def protection=: (untyped v) -> untyped

    # @see numFmtId
    def numFmtId=: (untyped v) -> untyped

    # @see fontId
    def fontId=: (untyped v) -> untyped

    # @see fillId
    def fillId=: (untyped v) -> untyped

    # @see borderId
    def borderId=: (untyped v) -> untyped

    # @see xfId
    def xfId=: (untyped v) -> untyped

    # @see quotePrefix
    def quotePrefix=: (untyped v) -> untyped

    # @see pivotButton
    def pivotButton=: (untyped v) -> untyped

    # @see applyNumberFormat
    def applyNumberFormat=: (untyped v) -> untyped

    # @see applyFont
    def applyFont=: (untyped v) -> untyped

    # @see applyFill
    def applyFill=: (untyped v) -> untyped

    # @see applyBorder
    def applyBorder=: (untyped v) -> untyped

    # @see applyAlignment
    def applyAlignment=: (untyped v) -> untyped

    # @see applyProtection
    def applyProtection=: (untyped v) -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # This module defines some of the more common validating attribute
  # accessors that we use in Axlsx
  #
  # When this module is included in your class you can simply call
  #
  # string_attr_access :foo
  #
  # To generate a new, validating set of accessors for foo.
  module ::Axlsx::Accessors
    def self.included: (untyped base) -> untyped

    # Defines the class level xxx_attr_accessor methods
    module ::Axlsx::Accessors::ClassMethods
      # Creates one or more string validated attr_accessors
      # @param [Array] symbols An array of symbols representing the
      # names of the attributes you will add to your class.
      def string_attr_accessor: (*untyped symbols) -> untyped

      # Creates one or more unsigned integer attr_accessors
      # @param [Array] symbols An array of symbols representing the
      # names of the attributes you will add to your class
      def unsigned_int_attr_accessor: (*untyped symbols) -> untyped

      # Creates one or more float (double?) attr_accessors
      # @param [Array] symbols An array of symbols representing the
      # names of the attributes you will add to your class
      def float_attr_accessor: (*untyped symbols) -> untyped

      # Creates on or more boolean validated attr_accessors
      # @param [Array] symbols An array of symbols representing the
      # names of the attributes you will add to your class.
      def boolean_attr_accessor: (*untyped symbols) -> untyped

      # Creates the reader and writer access methods
      # @param [Array<Symbol, String>] symbols The names of the attributes to create
      # @param [Symbol|String] validator The axlsx validation method to use when
      # validating assignation.
      # @see lib/axlsx/util/validators.rb
      def validated_attr_accessor: (untyped symbols, untyped validator) -> untyped
    end
  end
end

module ::Axlsx
  # The BufferedZipOutputStream buffers the output in order to avoid appending many small strings directly to the
  # the `Zip::OutputStream`.
  #
  # The methods provided here mimic `Zip::OutputStream` so that this class can be used a drop-in replacement.
  class ::Axlsx::BufferedZipOutputStream
    # The 4_096 was chosen somewhat arbitrary, however, it was difficult to see any obvious improvement with larger
    # buffer sizes.
    ::Axlsx::BufferedZipOutputStream::BUFFER_SIZE: 4096

    # The suppress_extra_fields method was introduced in rubyzip 3.2
    # Between rubyzip 3.0 and 3.2, it automatically writes zip64 support to the xlsx files
    # See: https://github.com/caxlsx/caxlsx/issues/481
    ::Axlsx::BufferedZipOutputStream::SUPPRESS_ZIP64: untyped

    def initialize: (untyped zos) -> void

    # Create a temporary directory for writing files to.
    #
    # The directory and its contents are removed at the end of the block.
    def self.open: (untyped file_name, ?untyped? encrypter) { (untyped) -> untyped } -> untyped

    def self.write_buffer: (?untyped io, ?untyped? encrypter) { (untyped) -> untyped } -> untyped

    # Closes the current entry and opens a new for writing.
    def put_next_entry: (untyped entry) -> untyped

    # Write to a buffer that will be written to the current entry
    def write: (untyped content) -> self

    alias << write

    def flush: () -> (nil | untyped)
  end
end

