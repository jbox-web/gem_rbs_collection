  # digital signature xml content type
  ::Axlsx::DIGITAL_SIGNATURE_XML_CT: "application/vnd.openxmlformats-package.digital-signature-xmlsignature+xml"

  # digital signature origin content type
  ::Axlsx::DIGITAL_SIGNATURE_ORIGIN_CT: "application/vnd.openxmlformats-package.digital-signature-origin"

