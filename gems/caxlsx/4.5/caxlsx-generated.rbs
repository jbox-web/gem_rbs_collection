  end
end

module ::Axlsx
  # A CatAxis object defines a chart category axis
  class ::Axlsx::CatAxis < ::Axlsx::Axis
    # Creates a new CatAxis object
    # @option options [Integer, nil] tick_lbl_skip
    # @option options [Integer, nil] tick_mark_skip
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # From the docs: This element specifies that this axis is a date or text axis based on the data that is used for the axis labels, not a specific choice.
    # @return [Boolean]
    attr_reader auto: untyped

    # specifies how the perpendicular axis is crossed
    # must be one of [:ctr, :l, :r]
    # @return [Symbol]
    attr_reader lbl_algn: untyped

    alias lblAlgn lbl_algn

    # The offset of the labels
    # must be between a string between 0 and 1000
    # @return [Integer]
    attr_reader lbl_offset: untyped

    alias lblOffset lbl_offset

    # The number of tick labels to skip between labels
    # @return [Integer, nil]
    attr_reader tick_lbl_skip: untyped

    alias tickLblSkip tick_lbl_skip

    # The number of tickmarks to be skipped before the next one is rendered.
    # @return [Integer, nil]
    attr_reader tick_mark_skip: untyped

    alias tickMarkSkip tick_mark_skip

    # regex for validating label offset
    ::Axlsx::CatAxis::LBL_OFFSET_REGEX: ::Regexp

    # @see tick_lbl_skip
    def tick_lbl_skip=: (untyped v) -> untyped

    alias tickLblSkip= tick_lbl_skip=

    # @see tick_mark_skip
    def tick_mark_skip=: (untyped v) -> untyped

    alias tickMarkSkip= tick_mark_skip=

    # From the docs: This element specifies that this axis is a date or text axis based on the data that is used for the axis labels, not a specific choice.
    def auto=: (untyped v) -> untyped

    # specifies how the perpendicular axis is crossed
    # must be one of [:ctr, :l, :r]
    def lbl_algn=: (untyped v) -> untyped

    alias lblAlgn= lbl_algn=

    # The offset of the labels
    # must be between a string between 0 and 1000
    def lbl_offset=: (untyped v) -> untyped

    alias lblOffset= lbl_offset=

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # A Chart is the superclass for specific charts
  # @note Worksheet#add_chart is the recommended way to create charts for your worksheets.
  # @see README for examples
  class ::Axlsx::Chart
    include ::Axlsx::OptionsParser

    # Creates a new chart object
    # @param [GraphicalFrame] frame The frame that holds this chart.
    # @option options [Cell, String] title
    # @option options [Boolean] show_legend
    # @option options [Symbol] legend_position
    # @option options [Array|String|Cell] start_at The X, Y coordinates defining the top left corner of the chart.
    # @option options [Array|String|Cell] end_at The X, Y coordinates defining the bottom right corner of the chart.
    # @option options [Boolean] plot_visible_only (true) Whether only data from visible cells should be plotted.
    # @option options [Boolean] rounded_corners (true) Whether the chart area shall have rounded corners.
    def initialize: (untyped frame, ?::Hash[untyped, untyped] options) ?{ (untyped) -> untyped } -> void

    # The 3D view properties for the chart
    attr_reader view_3D: untyped

    alias view3D view_3D

    # A reference to the graphic frame that owns this chart
    # @return [GraphicFrame]
    attr_reader graphic_frame: untyped

    # A collection of series objects that are applied to the chart
    # @return [SimpleTypedList]
    attr_reader series: untyped

    # The type of series to use for this chart.
    # @return [Series]
    attr_reader series_type: untyped

    # TODO: data labels!
    def d_lbls: () -> untyped

    # Indicates that colors should be varied by datum
    # @return [Boolean]
    attr_reader vary_colors: untyped

    # Configures the vary_colors options for this chart
    # @param [Boolean] v The value to set
    def vary_colors=: (untyped v) -> untyped

    # The title object for the chart.
    # @return [Title]
    attr_reader title: untyped

    # The style for the chart.
    # see ECMA Part 1 §21.2.2.196
    # @return [Integer]
    attr_reader style: untyped

    # Show the legend in the chart
    # @return [Boolean]
    attr_reader show_legend: untyped

    # Set the location of the chart's legend
    # @return [Symbol] The position of this legend
    # @note
    #  The following are allowed
    #    :b
    #    :l
    #    :r
    #    :t
    #    :tr
    attr_reader legend_position: untyped

    # How to display blank values
    # Options are
    # * gap:  Display nothing
    # * span: Not sure what this does
    # * zero: Display as if the value were zero, not blank
    # @return [Symbol]
    # Default :gap (although this really should vary by chart type and grouping)
    attr_reader display_blanks_as: untyped

    # Background color for the chart
    # @return [String]
    attr_reader bg_color: untyped

    # Whether only data from visible cells should be plotted.
    # @return [Boolean]
    attr_reader plot_visible_only: untyped

    # Whether the chart area shall have rounded corners.
    # @return [Boolean]
    attr_reader rounded_corners: untyped

    # The relationship object for this chart.
    # @return [Relationship]
    def relationship: () -> untyped

    # The index of this chart in the workbooks charts collection
    # @return [Integer]
    def index: () -> untyped

    # The part name for this chart
    # @return [String]
    def pn: () -> ::String

    # The title object for the chart.
    # @param [String, Cell] v
    # @return [Title]
    def title=: (untyped v) -> (::Axlsx::Cell | ::String | nil)

    # The size of the Title object of the chart.
    # @param [String] v The size for the title object
    # @see Title
    def title_size=: (untyped v) -> (untyped | nil)

    # Show the legend in the chart
    # @param [Boolean] v
    # @return [Boolean]
    def show_legend=: (untyped v) -> untyped

    # How to display blank values
    # @see display_blanks_as
    # @param [Symbol] v
    # @return [Symbol]
    def display_blanks_as=: (untyped v) -> untyped

    # The style for the chart.
    # see ECMA Part 1 §21.2.2.196
    # @param [Integer] v must be between 1 and 48
    def style=: (untyped v) -> untyped

    # @see legend_position
    def legend_position=: (untyped v) -> untyped

    # backwards compatibility to allow chart.to and chart.from access to anchor markers
    # @note This will be disconinued in version 2.0.0. Please use the end_at method
    def to: () -> untyped

    # backwards compatibility to allow chart.to and chart.from access to anchor markers
    # @note This will be disconinued in version 2.0.0. please use the start_at method
    def from: () -> untyped

    # Adds a new series to the chart's series collection.
    # @return [Series]
    # @see Series
    def add_series: (?::Hash[untyped, untyped] options) -> untyped

    # Assigns a background color to chart area
    def bg_color=: (untyped v) -> untyped

    # Whether only data from visible cells should be plotted.
    # @param [Boolean] v
    # @return [Boolean]
    def plot_visible_only=: (untyped v) -> untyped

    # Whether the chart area shall have rounded corners.
    # @param [Boolean] v
    # @return [Boolean]
    def rounded_corners=: (untyped v) -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) ?{ () -> untyped } -> untyped

    # This is a short cut method to set the anchor start marker position
    # If you need finer granularity in positioning use
    #
    # This helper method acceps a fairly wide range of inputs exampled
    # below
    #
    # @example
    #
    #      start_at 0, 5 # The anchor start marker is set to 6th row of
    #      the first column
    #
    #      start_at [0, 5] # The anchor start marker is set to start on the 6th row
    #      of the first column
    #
    #      start_at "C1" # The anchor start marker is set to start on the first row
    #      of the third column
    #
    #      start_at sheet.rows.first.cells.last # The anchor start
    #      marker is set to the location of a specific cell.
    #
    # @param [Array|String|Cell] x the column, coordinates, string
    # reference or cell to use in setting the start marker position.
    # @param [Integer] y The row
    # @return [Marker]
    def start_at: (?::Integer x, ?::Integer y) -> untyped

    # This is a short cut method to set the end anchor position
    # If you need finer granularity in positioning use
    # graphic_frame.anchor.to.colOff / rowOff
    # @param [Integer] x The column - default 10
    # @param [Integer] y The row - default 10
    # @return [Marker]
    # @see start_at
    def end_at: (?::Integer x, ?::Integer y) -> untyped

    # sets the view_3D object for the chart
    def view_3D=: (untyped v) -> untyped

    alias view3D= view_3D=
  end
end

module ::Axlsx
  # There are more elements in the dLbls spec that allow for
  # customizations and formatting. For now, I am just implementing the
  # basics.
  # The DLbls class manages serialization of data labels
  # showLeaderLines and leaderLines are not currently implemented
  class ::Axlsx::DLbls
    include ::Axlsx::Accessors

    include ::Axlsx::OptionsParser

    # creates a new DLbls object
    def initialize: (untyped chart_type, ?::Hash[untyped, untyped] options) -> void

    # Initialize all the values to false as Excel requires them to
    # explicitly be disabled or all will show.
    def initialize_defaults: () -> ::Array[::Symbol]

    # The chart type that is using this data labels instance.
    # This affects the xml output as not all chart types support the
    # same data label attributes.
    attr_reader chart_type: untyped

    # The position of the data labels in the chart
    # @see d_lbl_pos= for a list of allowed values
    # @return [Symbol]
    def d_lbl_pos: () -> (nil | untyped)

    # @see DLbls#d_lbl_pos
    # Assigns the label position for this data labels on this chart.
    # Allowed positions are :bestFit, :b, :ctr, :inBase, :inEnd, :l,
    # :outEnd, :r and :t
    # The default is :bestFit
    # @param [Symbol] label_position the position you want to use.
    def d_lbl_pos=: (untyped label_position) -> (nil | untyped)

    # serializes the data labels
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped

    # nills out d_lbl_pos and show_leader_lines as these attributes, while valid in the spec actually crash Excel for any chart type other than pie charts.
    def validate_attributes_for_chart_type: () -> (nil | untyped)
  end
end

module ::Axlsx
  # A Drawing is a canvas for charts and images. Each worksheet has a single drawing that manages anchors.
  # The anchors reference the charts or images via graphical frames. This is not a trivial relationship so please do follow the advice in the note.
  # @note The recommended way to manage drawings is to use the Worksheet.add_chart and Worksheet.add_image methods.
  # @see Worksheet#add_chart
  # @see Worksheet#add_image
  # @see Chart
  # see examples/example.rb for an example of how to create a chart.
  class ::Axlsx::Drawing
    # The worksheet that owns the drawing
    # @return [Worksheet]
    attr_reader worksheet: untyped

    # A collection of anchors for this drawing
    # only TwoCellAnchors are supported in this version
    # @return [SimpleTypedList]
    attr_reader anchors: untyped

    # Creates a new Drawing object
    # @param [Worksheet] worksheet The worksheet that owns this drawing
    def initialize: (untyped worksheet) -> void

    # Adds an image to the chart If th end_at option is specified we create a two cell anchor. By default we use a one cell anchor.
    # @note The recommended way to manage images is to use Worksheet.add_image. Please refer to that method for documentation.
    # @see Worksheet#add_image
    # @return [Pic]
    def add_image: (?::Hash[untyped, untyped] options) -> untyped

    # Adds a chart to the drawing.
    # @note The recommended way to manage charts is to use Worksheet.add_chart. Please refer to that method for documentation.
    # @see Worksheet#add_chart
    def add_chart: (untyped chart_type, ?::Hash[untyped, untyped] options) -> untyped

    # An array of charts that are associated with this drawing's anchors
    # @return [Array]
    def charts: () -> untyped

    # An array of hyperlink objects associated with this drawings images
    # @return [Array]
    def hyperlinks: () -> untyped

    # An array of image objects that are associated with this drawing's anchors
    # @return [Array]
    def images: () -> untyped

    # The index of this drawing in the owning workbooks's drawings collection.
    # @return [Integer]
    def index: () -> untyped

    # The part name for this drawing
    # @return [String]
    def pn: () -> ::String

    # The relational part name for this drawing
    # #NOTE This should be rewritten to return an Axlsx::Relationship object.
    # @return [String]
    def rels_pn: () -> ::String

    # A list of objects this drawing holds.
    # @return [Array]
    def child_objects: () -> untyped

    # The drawing's relationships.
    # @return [Relationships]
    def relationships: () -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # A graphic frame defines a container for a chart object
  # @note The recommended way to manage charts is Worksheet#add_chart
  # @see Worksheet#add_chart
  class ::Axlsx::GraphicFrame
    # A reference to the chart object associated with this frame
    # @return [Chart]
    attr_reader chart: untyped

    # A anchor that holds this frame
    # @return [TwoCellAnchor]
    attr_reader anchor: untyped

    # Creates a new GraphicFrame object
    # @param [TwoCellAnchor] anchor
    # @param [Class] chart_type
    def initialize: (untyped anchor, untyped chart_type, untyped options) -> void

    # The relationship id for this graphic frame.
    # @return [String]
    def rId: () -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # a hyperlink object adds an action to an image when clicked so that when the image is clicked the link is fecthed.
  # @note using the hyperlink option when calling add_image on a drawing object is the recommended way to manage hyperlinks
  # @see {file:README} README
  class ::Axlsx::Hyperlink
    include ::Axlsx::SerializedAttributes

    include ::Axlsx::OptionsParser

    # Creates a hyperlink object
    # parent must be a Pic for now, although I expect that other object support this tag and its cNvPr parent
    # @param [Pic] parent
    # @option options [String] tooltip message shown when hyperlinked object is hovered over with mouse.
    # @option options [String] tgtFrame Target frame for opening hyperlink
    # @option options [String] invalidUrl supposedly use to store the href when we know it is an invalid resource.
    # @option options [String] href the target resource this hyperlink links to. This is actually stored on the relationship.
    # @option options [String] action A string that can be used to perform specific actions. For Excel please see this reference: https://msdn.microsoft.com/en-us/library/ff532419%28v=office.12%29.aspx
    # @option options [Boolean] endSnd terminate any sound events when processing this link
    # @option options [Boolean] history include this link in the list of visited links for the applications history.
    # @option options [Boolean] highlightClick indicate that the link has already been visited.
    def initialize: (untyped parent, ?::Hash[untyped, untyped] options) ?{ (untyped) -> untyped } -> void

    # The destination of the hyperlink stored in the drawing's relationships document.
    # @return [String]
    attr_accessor href: untyped

    # The spec says: Specifies the URL when it has been determined by the generating application that the URL is invalid. That is the generating application can still store the URL but it is known that this URL is not correct.
    #
    # What exactly that means is beyond me so if you ever use this, let me know!
    # @return [String]
    attr_accessor invalid_url: untyped

    alias invalidUrl invalid_url
    def invalidUrl=: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped

    # An action to take when the link is clicked. The specification says "This can be used to specify a slide to be navigated to or a script of code to be run." but in most cases you will not need to do anything with this. MS does reserve a few interesting strings. @see https://msdn.microsoft.com/en-us/library/ff532419%28v=office.12%29.aspx
    # @return [String]
    attr_accessor action: untyped

    # Specifies if all sound events should be terminated when this link is clicked.
    # @return [Boolean]
    attr_reader end_snd: untyped

    alias endSnd end_snd

    # @see endSnd
    # @param [Boolean] v The boolean value indicating the termination of playing sounds on click
    # @return [Boolean]
    def end_snd=: (untyped v) -> untyped

    alias endSnd= end_snd=

    # indicates that the link has already been clicked.
    # @return [Boolean]
    attr_reader highlight_click: untyped

    alias highlightClick highlight_click

    # @see highlightClick
    # @param [Boolean] v The value to assign
    def highlight_click=: (untyped v) -> untyped

    alias highlightClick= highlight_click=

    # From the specs: Specifies whether to add this URI to the history when navigating to it. This allows for the viewing of this presentation without the storing of history information on the viewing machine. If this attribute is omitted, then a value of 1 or true is assumed.
    # @return [Boolean]
    attr_reader history: untyped

    # @see history
    # param [Boolean] v The value to assign
    def history=: (untyped v) -> untyped

    # From the specs: Specifies the target frame that is to be used when opening this hyperlink. When the hyperlink is activated this attribute is used to determine if a new window is launched for viewing or if an existing one can be used. If this attribute is omitted, than a new window is opened.
    # @return [String]
    attr_accessor tgt_frame: untyped

    alias tgtFrame tgt_frame
    def tgtFrame=: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped

    # Text to show when you mouse over the hyperlink. If you do not set this, the href property will be shown.
    # @return [String]
    attr_accessor tooltip: untyped

    # The relationship object for this hyperlink.
    # @return [Relationship]
    def relationship: () -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # The Line3DChart is a three dimensional line chart (who would have guessed?) that you can add to your worksheet.
  # @example Creating a chart
  #   # This example creates a line in a single sheet.
  #   require "rubygems" # if that is your preferred way to manage gems!
  #   require "axlsx"
  #
  #   p = Axlsx::Package.new
  #   ws = p.workbook.add_worksheet
  #   ws.add_row ["This is a chart with no data in the sheet"]
  #
  #   chart = ws.add_chart(Axlsx::Line3DChart, :start_at=> [0,1], :end_at=>[0,6], :t#itle=>"Most Popular Pets")
  #   chart.add_series :data => [1, 9, 10], :labels => ["Slimy Reptiles", "Fuzzy Bunnies", "Rottweiler"]
  #
  # @see Worksheet#add_chart
  # @see Worksheet#add_row
  # @see Chart#add_series
  # @see Series
  # @see Package#serialize
  class ::Axlsx::Line3DChart < ::Axlsx::LineChart
    # space between bar or column clusters, as a percentage of the bar or column width.
    # @return [String]
    attr_reader gap_depth: untyped

    alias gapDepth gap_depth

    # validation regex for gap amount percent
    ::Axlsx::Line3DChart::GAP_AMOUNT_PERCENT: ::Regexp

    # the category axis
    # @return [Axis]
    def ser_axis: () -> untyped

    alias serAxis ser_axis

    # Creates a new line chart object
    # @option options [String] gap_depth
    # @see Chart
    # @see lineChart
    # @see View3D
    def initialize: (untyped frame, ?::Hash[untyped, untyped] options) -> void

    # @see gapDepth
    def gap_depth=: (untyped v) -> untyped

    alias gapDepth= gap_depth=

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # The LineChart is a two dimensional line chart (who would have guessed?) that you can add to your worksheet.
  # @example Creating a chart
  #   # This example creates a line in a single sheet.
  #   require "rubygems" # if that is your preferred way to manage gems!
  #   require "axlsx"
  #
  #   p = Axlsx::Package.new
  #   ws = p.workbook.add_worksheet
  #   ws.add_row ["This is a chart with no data in the sheet"]
  #
  #   chart = ws.add_chart(Axlsx::LineChart, :start_at=> [0,1], :end_at=>[0,6], :title=>"Most Popular Pets")
  #   chart.add_series :data => [1, 9, 10], :labels => ["Slimy Reptiles", "Fuzzy Bunnies", "Rottweiler"]
  #
  # @see Worksheet#add_chart
  # @see Worksheet#add_row
  # @see Chart#add_series
  # @see Series
  # @see Package#serialize
  class ::Axlsx::LineChart < ::Axlsx::Chart
    # the category axis
    # @return [CatAxis]
    def cat_axis: () -> untyped

    alias catAxis cat_axis

    # the category axis
    # @return [ValAxis]
    def val_axis: () -> untyped

    alias valAxis val_axis

    # must be one of  [:percentStacked, :clustered, :standard, :stacked]
    # @return [Symbol]
    attr_reader grouping: untyped

    # Creates a new line chart object
    # @param [GraphicFrame] frame The workbook that owns this chart.
    # @option options [Cell, String] title
    # @option options [Boolean] show_legend
    # @option options [Symbol] grouping
    # @see Chart
    def initialize: (untyped frame, ?::Hash[untyped, untyped] options) -> void

    # @see grouping
    def grouping=: (untyped v) -> untyped

    # The node name to use in serialization. As LineChart is used as the
    # base class for Liine3DChart we need to be sure to serialize the
    # chart based on the actual class type and not a fixed node name.
    # @return [String]
    def node_name: () -> (::String | nil)

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) ?{ () -> untyped } -> untyped

    # The axes for this chart. LineCharts have a category and value
    # axis.
    # @return [Axes]
    def axes: () -> untyped
  end
end

module ::Axlsx
  # A LineSeries defines the title, data and labels for line charts
  # @note The recommended way to manage series is to use Chart#add_series
  # @see Worksheet#add_chart
  # @see Chart#add_series
  class ::Axlsx::LineSeries < ::Axlsx::Series
    # The data for this series.
    # @return [ValAxisData]
    attr_reader data: untyped

    # The labels for this series.
    # @return [CatAxisData]
    attr_reader labels: untyped

    # The fill color for this series.
    # Red, green, and blue is expressed as sequence of hex digits, RRGGBB. A perceptual gamma of 2.2 is used.
    # @return [String]
    attr_reader color: untyped

    # show markers on values
    # @return [Boolean]
    attr_reader show_marker: untyped

    # custom marker symbol
    # @return [String]
    attr_reader marker_symbol: untyped

    # line smoothing on values
    # @return [Boolean]
    attr_reader smooth: untyped

    # Creates a new series
    # @option options [Array, SimpleTypedList] data
    # @option options [Array, SimpleTypedList] labels
    # @param [Chart] chart
    def initialize: (untyped chart, ?::Hash[untyped, untyped] options) -> void

    # @see color
    def color=: (untyped v) -> untyped

    # @see show_marker
    def show_marker=: (untyped v) -> untyped

    # @see marker_symbol
    def marker_symbol=: (untyped v) -> untyped

    # @see smooth
    def smooth=: (untyped v) -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped

    private

    # assigns the data for this series
    def data=: (untyped v) -> untyped

    # assigns the labels for this series
    def labels=: (untyped v) -> untyped
  end
end

module ::Axlsx
  # The Marker class defines a point in the worksheet that drawing anchors attach to.
  # @note The recommended way to manage markers is Worksheet#add_chart Markers are created for a two cell anchor based on the :start and :end options.
  # @see Worksheet#add_chart
  class ::Axlsx::Marker
    include ::Axlsx::OptionsParser

    # Creates a new Marker object
    # @option options [Integer] col
    # @option options [Integer] colOff
    # @option options [Integer] row
    # @option options [Integer] rowOff
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # The column this marker anchors to
    # @return [Integer]
    attr_reader col: untyped

    # The offset distance from this marker's column
    # @return [Integer]
    attr_reader colOff: untyped

    # The row this marker anchors to
    # @return [Integer]
    attr_reader row: untyped

    # The offset distance from this marker's row
    # @return [Integer]
    attr_reader rowOff: untyped

    # @see col
    def col=: (untyped v) -> untyped

    # @see colOff
    def colOff=: (untyped v) -> untyped

    # @see row
    def row=: (untyped v) -> untyped

    # @see rowOff
    def rowOff=: (untyped v) -> untyped

    # shortcut to set the column, row position for this marker
    # @param col the column for the marker, a Cell object or a string reference like "B7"
    # or an Array.
    # @param row the row of the marker. This is ignored if the col parameter is a Cell or
    # String or Array.
    def coord: (untyped col, ?::Integer row) -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> ::Array[::Symbol]

    private

    # handles multiple inputs for setting the position of a marker
    # @see Chart#start_at
    def parse_coord_args: (untyped x, ?::Integer y) -> ::Array[untyped]
  end
end

module ::Axlsx
  # This class specifies data for a particular data point. It is used for both numCache and numLit object
  class ::Axlsx::NumData
    include ::Axlsx::OptionsParser

    # creates a new NumVal object
    # @option options [String] formatCode
    # @option options [Array] :data
    # @see StrData
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # A string representing the format code to apply. For more information see see the SpreadsheetML numFmt element's (§18.8.30) formatCode attribute.
    # @return [String]
    attr_reader format_code: untyped

    # Creates the val objects for this data set. I am not overly confident this is going to play nicely with time and data types.
    # @param [Array] values An array of cells or values.
    def data=: (?untyped values) -> untyped

    # @see format_code
    def format_code=: (?::String v) -> untyped

    # serialize the object
    def to_xml_string: (?untyped str) -> untyped
  end
end

module ::Axlsx
  # A numeric data source for use by charts.
  class ::Axlsx::NumDataSource
    include ::Axlsx::OptionsParser

    # creates a new NumDataSource object
    # @option options [Array] data An array of Cells or Numeric objects
    # @option options [Symbol] tag_name see tag_name
    def initialize: (?::Hash[untyped, untyped] options) -> void

    # The tag name to use when serializing this data source.
    # Only items defined in allowed_tag_names are allowed
    # @return [Symbol]
    attr_reader tag_name: untyped

    attr_reader data: untyped

    # allowed element tag names
