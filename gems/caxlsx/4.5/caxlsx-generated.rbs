module ::Axlsx
  # This class details a single cell anchor for drawings.
  # @note The recommended way to manage drawings, images and charts is Worksheet#add_chart or Worksheet#add_image.
  # @see Worksheet#add_chart
  # @see Worksheet#add_image
  class ::Axlsx::OneCellAnchor
    include ::Axlsx::OptionsParser

    # Creates a new OneCellAnchor object and an Pic associated with it.
    # @param [Drawing] drawing
    # @option options [Array] start_at the col, row to start at
    # @option options [Integer] width
    # @option options [Integer] height
    # @option options [String] image_src the file location of the image you will render
    # @option options [String] name the name attribute for the rendered image
    # @option options [String] descr the description of the image rendered
    def initialize: (untyped drawing, ?::Hash[untyped, untyped] options) -> void

    # A marker that defines the from cell anchor. The default from column and row are 0 and 0 respectively
    # @return [Marker]
    attr_reader from: untyped

    # The object this anchor hosts
    # @return [Pic]
    attr_reader object: untyped

    # The drawing that holds this anchor
    # @return [Drawing]
    attr_reader drawing: untyped

    # the width of the graphic object in pixels.
    # this is converted to EMU at a 92 ppi resolution
    # @return [Integer]
    attr_reader width: untyped

    # the height of the graphic object in pixels
    # this is converted to EMU at a 92 ppi resolution
    # @return [Integer]
    attr_reader height: untyped

    # sets the starting position for the anchor.
    # You can provide a String like "A1", an array like [0,0] or a cell object for the x parameter.
    # We just 'figure it out' for you.
    # @param [Array, String, Cell, Integer] x Accepts many inputs for defining the starting position of the cell.
    # @param [Integer] y When x is an integer, this value is used for the row index at which the anchor starts.
    def start_at: (untyped x, ?::Integer y) -> untyped

    #
    # @see height
    def height=: (untyped v) -> untyped

    # @see width
    def width=: (untyped v) -> untyped

    # The index of this anchor in the drawing
    # @return [Integer]
    def index: () -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped

    private

    # converts the pixel width and height to EMU units and returns a hash of
    # !{:cx=>[Integer], :cy=>[Integer]
    # @return [Hash]
    def ext: () -> { cy: untyped, cx: untyped }
  end
end

module ::Axlsx
  # a Pic object represents an image in your worksheet
  # Worksheet#add_image is the recommended way to manage images in your sheets
  # @see Worksheet#add_image
  class ::Axlsx::Pic
    include ::Axlsx::OptionsParser

    # Creates a new Pic(ture) object
    # @param [Anchor] anchor the anchor that holds this image
    # @option options [Boolean] :remote indicates if image_src is a remote URI
    # @option options [String] :name
    # @option options [String] :descr
    # @option options [String] :image_src
    # @option options [Array] :start_at
    # @option options [Integer] :width
    # @option options [Integer] :height
    # @option options [Float] :opacity - set the picture opacity, accepts a value between 0.0 and 1.0
    def initialize: (untyped anchor, ?::Hash[untyped, untyped] options) ?{ (untyped) -> untyped } -> void

    # allowed mime types
    ::Axlsx::Pic::ALLOWED_MIME_TYPES: ::Array["image/jpeg" | "image/png" | "image/gif"]

    # The name to use for this picture
    # @return [String]
    attr_reader name: untyped

    # A description of the picture
    # @return [String]
    attr_reader descr: untyped

    # The path to the image you want to include
    # Only local images are supported at this time.
    # @return [String]
    attr_reader image_src: untyped

    # The anchor for this image
    # @return [OneCellAnchor]
    attr_reader anchor: untyped

    # The picture locking attributes for this picture
    attr_reader picture_locking: untyped

    attr_reader hyperlink: untyped

    # Picture opacity
    # @return [Integer]
    attr_reader opacity: untyped

    # Flag for remote picture (from URI)
    # @return [Boolean]
    attr_reader remote: untyped

    # sets or updates a hyperlink for this image.
    # @param [String] v The href value for the hyper link
    # @option options @see Hyperlink#initialize All options available to the Hyperlink class apply - however href will be overridden with the v parameter value.
    def hyperlink=: (untyped v, ?::Hash[untyped, untyped] options) -> untyped

    def image_src=: (untyped v) -> untyped

    # @see name
    def name=: (untyped v) -> untyped

    # @see descr
    def descr=: (untyped v) -> untyped

    # @see remote
    def remote=: (untyped v) -> untyped

    def remote?: () -> untyped

    # The file name of image_src without any path information
    # @return [String]
    def file_name: () -> (untyped | nil)

    # returns the extension of image_src without the preceding '.'
    # @return [String]
    def extname: () -> (untyped | nil)

    # The index of this image in the workbooks images collections
    # @return [Index]
    def index: () -> untyped

    # The part name for this image used in serialization and relationship building
    # @return [String]
    def pn: () -> ::String

    # The relationship object for this pic.
    # @return [Relationship]
    def relationship: () -> untyped

    # providing access to the anchor's width attribute
    # @see OneCellAnchor.width
    def width: () -> (nil | untyped)

    # @see width
    def width=: (untyped v) -> untyped

    # providing access to update the anchor's height attribute
    # @see OneCellAnchor.width
    # @note this is a noop if you are using a TwoCellAnchor
    def height: () -> untyped

    # @see height
    # @note This is a noop if you are using a TwoCellAnchor
    def height=: (untyped v) -> untyped

    # This is a short cut method to set the start anchor position
    # If you need finer granularity in positioning use
    # graphic_frame.anchor.from.colOff / rowOff
    # @param [Integer] x The column
    # @param [Integer] y The row
    # @return [Marker]
    def start_at: (untyped x, ?untyped? y) -> untyped

    # noop if not using a two cell anchor
    # @param [Integer] x The column
    # @param [Integer] y The row
    # @return [Marker]
    def end_at: (untyped x, ?untyped? y) -> untyped

    # Serializes the object
    # @param [String] str
    # @return [String]
    def to_xml_string: (?untyped str) -> untyped

    private

    # Return correct xml relationship string portion
    def relationship_xml_portion: () -> ::String

    # Changes the anchor to a one cell anchor.
    def use_one_cell_anchor: () -> (nil | untyped)

    # changes the anchor type to a two cell anchor
    def use_two_cell_anchor: () -> (nil | untyped)

    # refactoring of swapping code, law of demeter be damned!
    def swap_anchor: (untyped new_anchor) -> untyped
  end
end

