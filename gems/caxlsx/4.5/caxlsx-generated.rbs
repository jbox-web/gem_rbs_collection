  # worksheet content type
  ::Axlsx::WORKSHEET_CT: "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"

  # shared strings content type
  ::Axlsx::SHARED_STRINGS_CT: "application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"

  # theme content type
