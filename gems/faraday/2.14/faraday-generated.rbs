      ::Faraday::Request::Json::MIME_TYPE: "application/json"

      ::Faraday::Request::Json::MIME_TYPE_REGEX: ::Regexp

      def on_request: (untyped env) -> untyped

      private

      def encode: (untyped data) -> untyped

