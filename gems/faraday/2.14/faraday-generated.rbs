module ::Faraday
  # Middleware is the basic base class of any Faraday middleware.
  class ::Faraday::Middleware
    extend ::Faraday::MiddlewareRegistry

    attr_reader app: untyped

    attr_reader options: untyped

    ::Faraday::Middleware::DEFAULT_OPTIONS: ::Hash[untyped, untyped]

    ::Faraday::Middleware::LOCK: untyped

    def initialize: (?untyped? app, ?::Hash[untyped, untyped] options) -> void

    # Faraday::Middleware::default_options= allows user to set default options at the Faraday::Middleware
    # class level.
    #
    # @example Set the Faraday::Response::RaiseError option, `include_request` to `false`
    # my_app/config/initializers/my_faraday_middleware.rb
    #
    # Faraday::Response::RaiseError.default_options = { include_request: false }
    #
    def self.default_options=: (?::Hash[untyped, untyped] options) -> untyped

    # default_options attr_reader that initializes class instance variable
    # with the values of any Faraday::Middleware defaults, and merges with
    # subclass defaults
    def self.default_options: () -> ::Hash[untyped, untyped]

    private

    def self.validate_default_options: (untyped options) -> (nil | untyped)

    public

    def call: (untyped env) -> untyped

    def close: () -> untyped
  end
end

module ::Faraday
  # Adds the ability for other modules to register and lookup
  # middleware classes.
  module ::Faraday::MiddlewareRegistry
    def registered_middleware: () -> (::Hash[untyped, untyped] | ::Hash[untyped, untyped])

    # Register middleware class(es) on the current module.
    #
    # @param mappings [Hash] Middleware mappings from a lookup symbol to a middleware class.
    # @return [void]
    #
    # @example Lookup by a constant
    #
    #   module Faraday
    #     class Whatever < Middleware
    #       # Middleware looked up by :foo returns Faraday::Whatever::Foo.
    #       register_middleware(foo: Whatever)
    #     end
    #   end
    def register_middleware: (**untyped mappings) -> untyped

    # Unregister a previously registered middleware class.
    #
    # @param key [Symbol] key for the registered middleware.
    def unregister_middleware: (untyped key) -> untyped

    # Lookup middleware class with a registered Symbol shortcut.
    #
    # @param key [Symbol] key for the registered middleware.
    # @return [Class] a middleware Class.
    # @raise [Faraday::Error] if given key is not registered
    #
    # @example
    #
    #   module Faraday
    #     class Whatever < Middleware
    #       register_middleware(foo: Whatever)
    #     end
    #   end
    #
    #   Faraday::Middleware.lookup_middleware(:foo)
    #   # => Faraday::Whatever
    def lookup_middleware: (untyped key) -> untyped

    private

    def middleware_mutex: () { (?) -> untyped } -> untyped

    def load_middleware: (untyped key) -> untyped
  end
end

