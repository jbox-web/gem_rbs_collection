      module ::Mobility::Plugins::ActiveModel::Dirty
        extend ::Mobility::Plugin

        private

        # Overridden in AR::Dirty plugin to define a different HandlerMethods module
        def dirty_handler_methods: () -> ::Mobility::Plugins::ActiveModel::Dirty::HandlerMethodsBuilder

        def active_model_dirty_class?: (untyped klass) -> untyped

        def define_dirty_methods: (untyped attribute_names) -> untyped

        def self.append_locale: (untyped attr_name) -> untyped

        # Module builder which mimics dirty method handlers on a given dirty class.
        # Used to mimic ActiveModel::Dirty and ActiveRecord::Dirty, which have
        # similar but slightly different sets of handler methods. Doing it this
        # way with introspection allows us to support basically all AR/AM
        # versions without changes here.
        class ::Mobility::Plugins::ActiveModel::Dirty::HandlerMethodsBuilder < ::Module
          attr_reader klass: untyped

          ::Mobility::Plugins::ActiveModel::Dirty::HandlerMethodsBuilder::PATTERNS_WITH_KWARGS: ::Array["%s_changed?" | "%s_previously_changed?" | "will_save_change_to_%s?" | "saved_change_to_%s?"]

          # @param [Class] klass Dirty class to mimic
          def initialize: (untyped klass) -> void

          def each_pattern: (untyped attr_name) { (untyped, untyped) -> untyped } -> untyped

          def define_handler_methods: () -> untyped

          # Get method suffixes. Creating an object just to get the list of
          # suffixes is simplest given they change from Rails version to version.
          def patterns: () -> untyped

          private

          def public_patterns: () -> untyped

          def excluded_patterns: () -> ::Array["%s" | "restore_%s!"]
        end

        # Module which defines generic handler methods like
        # +attribute_changed?+ that are patched to work with translated
        # attributes.
        ::Mobility::Plugins::ActiveModel::Dirty::HandlerMethods: untyped

        module ::Mobility::Plugins::ActiveModel::Dirty::InstanceMethods
          def changed_attributes: () -> untyped

          def changes_applied: () -> untyped

          def changes: () -> untyped

          def changed: () -> untyped

          def changed?: () -> untyped

          def previous_changes: () -> untyped

          def clear_changes_information: () -> untyped

          def clear_attribute_changes: (untyped attr_names) -> untyped

          private

          def mutations_from_mobility: () -> ::Mobility::Plugins::ActiveModel::Dirty::MobilityMutationTracker
        end

        # @note Seriously, I really don't want to reproduce all of
        #   ActiveModel::Dirty here, but having fought with upstream changes
        #   many many times I finally decided it's more future-proof to just
        #   re-implement the stuff we need here, to avoid weird breakage.
        #
        #   Although this is somewhat ugly, at least it's explicit and since
        #   it's self-defined (rather than hooking into fickle private methods
        #   in Rails), it won't break all of a sudden. We just need to ensure
        #   that specs are up-to-date with the latest weird dirty method
        #   pattern Rails has decided to support.
        class ::Mobility::Plugins::ActiveModel::Dirty::MobilityMutationTracker
          ::Mobility::Plugins::ActiveModel::Dirty::MobilityMutationTracker::OPTION_NOT_GIVEN: untyped

          attr_reader previous_changes: untyped

          def initialize: (untyped model) -> void

          def finalize_changes: () -> untyped

          def changed: () -> untyped

          def changed_attributes: () -> untyped

          def changes: () -> untyped

          def changed?: () -> untyped

          def attribute_change: (untyped attr_name) -> (::Array[untyped] | nil)

          def attribute_previous_change: (untyped attr_name) -> untyped

          def attribute_previously_was: (untyped attr_name) -> (untyped | nil)

          def attribute_changed?: (untyped attr_name, ?from: untyped, ?to: untyped) -> untyped

          def attribute_previously_changed?: (untyped attr_name, ?from: untyped, ?to: untyped) -> untyped

          def attribute_was: (untyped attr_name) -> untyped

          def attribute_will_change!: (untyped attr_name) -> (untyped | nil)

          def restore_attribute!: (untyped attr_name) -> untyped

          # These are for ActiveRecord, but we'll define them here.
          alias saved_change_to_attribute? attribute_previously_changed?

          alias saved_change_to_attribute attribute_previous_change

          alias attribute_before_last_save attribute_previously_was

          alias will_save_change_to_attribute? attribute_changed?

          alias attribute_change_to_be_saved attribute_change

          alias attribute_in_database attribute_was

          private

          attr_reader model: untyped

          attr_reader current_changes: untyped

          def attr_names: () -> untyped

          def fetch_value: (untyped attr_name) -> untyped
        end

        module ::Mobility::Plugins::ActiveModel::Dirty::BackendMethods
          # @!group Backend Accessors
          # @!macro backend_writer
          # @param [Hash] options
          def write: (untyped locale, untyped value, **untyped options) -> untyped

          private

          def mutations_from_mobility: () -> untyped
        end
      end
    end
  end
