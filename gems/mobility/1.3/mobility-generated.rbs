module ::Mobility
  module ::Mobility::Util
    ::Mobility::Util::VALID_CONSTANT_NAME_REGEXP: ::Regexp

    def self.included: (untyped klass) -> untyped

    # Converts strings to UpperCamelCase.
    # @param [String] str
    # @return [String]
    def camelize: (untyped str) -> untyped

    # Tries to find a constant with the name specified in the argument string.
    # @param [String] str
    # @return [Object]
    def constantize: (untyped str) -> untyped

    # Returns the singular form of a word in a string.
    # @param [String] str
    # @return [String]
    # @note If +singularize+ is not defined on +String+, falls back to simply
    #   stripping the trailing 's' from the string.
    def singularize: (untyped str) -> untyped

    # Removes the module part from the expression in the string.
    # @param [String] str
    # @return [String]
    def demodulize: (untyped str) -> untyped

    # Creates a foreign key name from a class name
    # @param [String] str
    # @return [String]
    def foreign_key: (untyped str) -> untyped

    # Makes an underscored, lowercase form from the expression in the string.
    # @param [String] str
    # @return [String]
    def underscore: (untyped str) -> untyped

    def present?: (untyped object) -> (false | true)

    def blank?: (untyped object) -> (true | untyped)

    def presence: (untyped object) -> (untyped | nil)

    private

    # Calls caller method on object if defined, otherwise yields to block
    def call_or_yield: (untyped object) { () -> untyped } -> untyped

    extend ::Mobility::Util
  end
end

