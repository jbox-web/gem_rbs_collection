class ::Shrine
  module ::Shrine::Plugins
    # Documentation can be found on https://shrinerb.com/docs/plugins/validation_helpers
    module ::Shrine::Plugins::ValidationHelpers
      ::Shrine::Plugins::ValidationHelpers::DEFAULT_MESSAGES: { max_size: untyped, min_size: untyped, max_width: untyped, min_width: untyped, max_height: untyped, min_height: untyped, max_dimensions: untyped, min_dimensions: untyped, mime_type_inclusion: untyped, mime_type_exclusion: untyped, extension_inclusion: untyped, extension_exclusion: untyped }

      ::Shrine::Plugins::ValidationHelpers::FILESIZE_UNITS: ::Array["B" | "KB" | "MB" | "GB" | "TB" | "PB" | "EB" | "ZB" | "YB"]

      # Returns filesize in a human readable format with units.
      # Uses the binary JEDEC unit system, i.e. 1.0 KB = 1024 bytes
      ::Shrine::Plugins::ValidationHelpers::PRETTY_FILESIZE: untyped

      def self.load_dependencies: (untyped uploader, **untyped) -> untyped

      def self.configure: (untyped uploader, ?default_messages: ::Hash[untyped, untyped], **untyped opts) -> untyped

      module ::Shrine::Plugins::ValidationHelpers::AttacherClassMethods
        def default_validation_messages: () -> untyped
      end

      module ::Shrine::Plugins::ValidationHelpers::AttacherMethods
        # Validates that the `size` metadata is not larger than `max`.
        #
        #     validate_max_size 5*1024*1024
        def validate_max_size: (untyped max, ?message: untyped?) -> (false | true)

        # Validates that the `size` metadata is not smaller than `min`.
        #
        #     validate_min_size 1024
        def validate_min_size: (untyped min, ?message: untyped?) -> (false | true)

        # Validates that the `size` metadata is in the given range.
        #
        #     validate_size 1024..5*1024*1024
        def validate_size: (untyped size_range) -> (false | true)

        # Validates that the `width` metadata is not larger than `max`.
        # Requires the `store_dimensions` plugin.
        #
        #     validate_max_width 5000
        def validate_max_width: (untyped max, ?message: untyped?) -> (false | true)

        # Validates that the `width` metadata is not smaller than `min`.
        # Requires the `store_dimensions` plugin.
        #
        #     validate_min_width 100
        def validate_min_width: (untyped min, ?message: untyped?) -> (false | true)

        # Validates that the `width` metadata is in the given range.
        #
        #     validate_width 100..5000
        def validate_width: (untyped width_range) -> (false | true)

        # Validates that the `height` metadata is not larger than `max`.
        # Requires the `store_dimensions` plugin.
        #
        #     validate_max_height 5000
        def validate_max_height: (untyped max, ?message: untyped?) -> (false | true)

        # Validates that the `height` metadata is not smaller than `min`.
        # Requires the `store_dimensions` plugin.
        #
        #     validate_min_height 100
        def validate_min_height: (untyped min, ?message: untyped?) -> (false | true)

        # Validates that the `height` metadata is in the given range.
        #
        #     validate_height 100..5000
        def validate_height: (untyped height_range) -> (false | true)

        # Validates that the dimensions are not larger than specified.
        #
        #     validate_max_dimensions [5000, 5000]
        def validate_max_dimensions: (untyped, ?message: untyped?) -> (false | true)

        # Validates that the dimensions are not smaller than specified.
        #
        #     validate_min_dimensions [100, 100]
        def validate_min_dimensions: (untyped, ?message: untyped?) -> (false | true)

        # Validates that the dimensions are in the given range.
        #
        #     validate_dimensions [100..5000, 100..5000]
        def validate_dimensions: (untyped) -> (false | true)

        # Validates that the `mime_type` metadata is included in the given
        # list.
        #
        #     validate_mime_type_inclusion %w[audio/mp3 audio/flac]
        def validate_mime_type_inclusion: (untyped types, ?message: untyped?) -> (false | true)

        alias validate_mime_type validate_mime_type_inclusion

        # Validates that the `mime_type` metadata is not included in the given
        # list.
        #
        #     validate_mime_type_exclusion %w[text/x-php]
        def validate_mime_type_exclusion: (untyped types, ?message: untyped?) -> (false | true)

        # Validates that the extension is included in the given list.
        # Comparison is case insensitive.
        #
        #     validate_extension_inclusion %w[jpg jpeg png gif]
        def validate_extension_inclusion: (untyped extensions, ?message: untyped?) -> (false | true)

        alias validate_extension validate_extension_inclusion

        # Validates that the extension is not included in the given list.
        # Comparison is case insensitive.
        #
        #     validate_extension_exclusion %[php jar]
        def validate_extension_exclusion: (untyped extensions, ?message: untyped?) -> (false | true)

        private

        # Adds an error if result is false and returns the result.
        def validate_result: (untyped result, untyped type, untyped message, *untyped args) -> (true | false)

        # Generates an error message and appends it to errors array.
        def add_error: (*untyped args) -> untyped

        # Returns the direct message if given, otherwise uses the default error
        # message.
        def error_message: (untyped type, untyped message, untyped object) -> untyped
      end
    end
  end
end

