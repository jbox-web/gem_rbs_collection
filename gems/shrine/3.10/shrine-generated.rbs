class ::Shrine
  module ::Shrine::Storage
    class ::Shrine::Storage::FileSystem
      attr_reader directory: untyped

      attr_reader prefix: untyped

      attr_reader permissions: untyped

      attr_reader directory_permissions: untyped

      # Initializes a storage for uploading to the filesystem.
      #
      # :prefix
      # :  The directory relative to `directory` to which files will be stored,
      #    and it is included in the URL.
      #
      # :permissions
      # :  The UNIX permissions applied to created files. Can be set to `nil`,
      #    in which case the default permissions will be applied. Defaults to
      #    `0644`.
      #
      # :directory_permissions
      # :  The UNIX permissions applied to created directories. Can be set to
      #    `nil`, in which case the default permissions will be applied. Defaults
      #    to `0755`.
      #
      # :clean
      # :  By default empty folders inside the directory are automatically
      #    deleted, but if it happens that it causes too much load on the
      #    filesystem, you can set this option to `false`.
      def initialize: (untyped directory, ?prefix: untyped?, ?clean: bool, ?permissions: ::Integer, ?directory_permissions: ::Integer) -> void

      # Copies the file into the given location.
      def upload: (untyped io, untyped id, ?move: bool, **untyped) -> untyped

      # Opens the file on the given location in read mode. Accepts additional
      # `File.open` arguments.
      def open: (untyped id, **untyped) -> untyped

      # Returns true if the file exists on the filesystem.
      def exists?: (untyped id) -> untyped

      # If #prefix is not present, returns a path composed of #directory and
      # the given `id`. If #prefix is present, it excludes the #directory part
      # from the returned path (e.g. #directory can be set to "public" folder).
      # Both cases accept a `:host` value which will be prefixed to the
      # generated path.
      def url: (untyped id, ?host: untyped?, **untyped) -> untyped

      # Delets the file, and by default deletes the containing directory if
      # it's empty.
      def delete: (untyped id) -> untyped

      # Deletes the specified directory on the filesystem.
      #
      #    file_system.delete_prefixed("somekey/derivatives/")
      def delete_prefixed: (untyped delete_prefix) -> top

      # Deletes all files from the #directory. If a block is passed in, deletes
      # only the files for which the block evaluates to true.
      #
      #     file_system.clear! # deletes all files and subdirectories in the storage directory
      #     file_system.clear! { |path| path.mtime < Time.now - 7*24*60*60 } # deletes only files older than 1 week
      def clear!: () ?{ (?) -> untyped } -> untyped

      # Returns the full path to the file. Raises Shrine::Error if the id would
      # resolve to a location outside of the storage #directory (e.g. an id
      # containing `../` path traversal sequences in attacker-controlled data).
      def path: (untyped id) -> untyped

      # Cleans all empty subdirectories up the hierarchy.
      def clean: (untyped path) -> untyped

      def clean?: () -> untyped

      private

      # Moves the file to the given location. This gets called by the `moving`
      # plugin.
      def move: (untyped io, untyped path) -> top

      # Returns true if the file is a `File` or a UploadedFile uploaded by the
      # FileSystem storage.
      def movable?: (untyped io) -> (false | true)

      # Creates all intermediate directories for that location.
      def path!: (untyped id) -> untyped

      def relative_path: (untyped id) -> ::String

      def relative: (untyped path) -> untyped

      def list_files: (untyped directory) { (untyped) -> untyped } -> nil
    end
  end
end

class ::Shrine
  # Error which is thrown when Storage::Linter fails.
  class ::Shrine::LintError < ::Shrine::Error
  end

  module ::Shrine::Storage
    # Checks if the storage conforms to Shrine's specification.
    #
    #   Shrine::Storage::Linter.new(storage).call
    #
    # If the check fails, by default it raises a `Shrine::LintError`, but you
    # can also specify `action: :warn`:
    #
    #   Shrine::Storage::Linter.new(storage, action: :warn).call
    #
    # You can also specify an IO factory which the storage will use:
    #
    #   Shrine::Storage::Linter.new(storage).call(->{File.open("test/fixtures/image.jpg")})
    class ::Shrine::Storage::Linter
      def self.call: (*untyped) -> true

      def initialize: (untyped storage, ?action: ::Symbol, ?nonexisting: untyped) -> void

      def call: (?untyped io_factory) -> true

      def lint_open: (untyped id) -> nil

      def lint_exists: (untyped id) -> (untyped | nil)

      def lint_url: (untyped id) -> nil

      def lint_delete: (untyped id) -> untyped

      def lint_clear: (untyped id) -> nil

      def lint_presign: (untyped id) -> nil

      def lint_delete_prefixed: (prefix: untyped, expect_deleted: untyped, expect_remaining: untyped) -> untyped

      private

      attr_reader storage: untyped

      def uploader: () -> ::Shrine

      def io?: (untyped object) -> true

      def error: (untyped method_name, untyped message) -> nil

      def full_message: (untyped method_name, untyped message) -> ::String

      def default_io_factory: () -> ::Proc

      class ::Shrine::Storage::Linter::FakeIO
        def initialize: (untyped content) -> void

        extend ::Forwardable
      end
    end
  end
end

class ::Shrine
  module ::Shrine::Storage
    class ::Shrine::Storage::Memory
      attr_reader store: untyped

      def initialize: (?::Hash[untyped, untyped] store) -> void

