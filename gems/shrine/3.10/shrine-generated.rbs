class ::Shrine
  module ::Shrine::Plugins
    # Documentation can be found on https://shrinerb.com/docs/plugins/sequel
    module ::Shrine::Plugins::Sequel
      def self.load_dependencies: (untyped uploader, **untyped) -> untyped

      def self.configure: (untyped uploader, **untyped opts) -> untyped

      module ::Shrine::Plugins::Sequel::AttachmentMethods
        def included: (untyped model) -> (nil | untyped)
      end

      # The _persistence plugin uses #sequel_persist, #sequel_reload and
      # #sequel? to implement the following methods:
      #
      #   * Attacher#persist
      #   * Attacher#atomic_persist
      #   * Attacher#atomic_promote
      module ::Shrine::Plugins::Sequel::AttacherMethods
        private

        # Adds file validation errors to the model. Called on model validation.
        def sequel_validate: () -> (nil | untyped)

        # Calls Attacher#save. Called before model save. Remembers whether
        # the record is new, since by the time `#sequel_after_save` runs,
        # Sequel has already flipped `#new?` to false.
        def sequel_before_save: () -> untyped

        # Finalizes attachment and persists changes. Called after model save.
        def sequel_after_save: () -> untyped

        # Deletes attached files. Called after model destroy.
        def sequel_after_destroy: () -> untyped

        # Saves changes to the model instance, skipping validations. Used by
        # the _persistence plugin.
        def sequel_persist: () -> untyped

        # Locks the database row and yields the reloaded record. Used by the
        # _persistence plugin.
        def sequel_reload: () { (untyped) -> untyped } -> untyped

        # Returns true if the data attribute represents a JSON or JSONB column.
        # Used by the _persistence plugin to determine whether serialization
        # should be skipped.
        def sequel_hash_attribute?: () -> untyped

        # Returns whether the record is a Sequel model. Used by the
        # _persistence plugin.
        def sequel?: () -> (false | true)

        # Prevents the previous file from being destroyed when this save
        # created the record (as opposed to updating an existing one), since
        # a record being created can't yet have its own confirmed attachment
        # to safely replace (e.g. when it was duplicated from another,
        # still-persisted record).
        def destroy_previous?: () -> untyped
      end
    end
  end
end

