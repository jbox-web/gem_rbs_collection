        def mirror_upload_block: () ?{ (?) -> untyped } -> untyped

        def mirror_delete_block: () ?{ (?) -> untyped } -> untyped

        def mirror_upload?: () -> untyped

        def mirror_delete?: () -> untyped
      end

      module ::Shrine::Plugins::Mirroring::InstanceMethods
        # Mirrors upload to other mirror storages.
