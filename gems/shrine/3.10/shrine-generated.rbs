class ::Shrine
  module ::Shrine::Plugins
    # Documentation can be found on https://shrinerb.com/docs/plugins/rack_response
    module ::Shrine::Plugins::RackResponse
      module ::Shrine::Plugins::RackResponse::FileMethods
        # Returns a Rack response triple for the uploaded file.
        def to_rack_response: (**untyped) -> untyped
      end

      class ::Shrine::Plugins::RackResponse::FileResponse
        attr_reader file: untyped

        def initialize: (untyped file) -> void

        # Returns a Rack response triple for the uploaded file.
        def call: (**untyped options) -> ::Array[untyped]

        private

        # Returns "200 OK" on full request, and "206 Partial Content" on ranged
        # request.
        def rack_status: (?range: untyped?, **untyped) -> (206 | 200)

        # Returns a hash of "Content-Length", "Content-Type" and
        # "Content-Disposition" headers, whose values are extracted from
        # metadata. Also returns the correct "Content-Range" header on ranged
        # requests.
        def rack_headers: (?filename: untyped?, ?type: untyped?, ?disposition: ::String, ?range: bool, ?etag: untyped?) -> ::Hash[untyped, untyped]

        # Value for the "Content-Length" header.
        def content_length: (untyped range) -> untyped

        # Value for the "Content-Type" header.
        def content_type: (untyped type) -> untyped

        # Value for the "Content-Disposition" header.
        def content_disposition: (untyped disposition, untyped filename) -> untyped

        # Value for the "Content-Range" header.
        def content_range: (untyped range) -> (::String | nil)

        # Value for the "Accept-Ranges" header.
        def accept_ranges: (untyped range) -> ("bytes" | nil)

        # Value for the "ETag" header.
        def etag: () -> ::String

        # Returns an object that responds to #each and #close, which yields
        # contents of the file.
        def rack_body: (?range: untyped?, **untyped) -> ::Shrine::Plugins::RackResponse::FileBody

        # Retrieves a range value parsed from HTTP "Range" header.
        def parse_content_range: (untyped range_header) -> untyped

        def get_byte_ranges: (untyped range_header) -> untyped
      end

      # Implements the interface of a Rack response body object.
      class ::Shrine::Plugins::RackResponse::FileBody
        attr_reader file: untyped

        attr_reader range: untyped

        def initialize: (untyped file, ?range: untyped?) -> void

        # Streams the uploaded file directly from the storage.
        def each: () { (?) -> untyped } -> untyped

        # Closes the file when response body is closed by the web server.
        def close: () -> untyped

        def bytesize: () -> untyped

        # Rack::Sendfile is activated when response body responds to #to_path.
        def respond_to_missing?: (untyped name, ?bool include_private) -> untyped

        # Rack::Sendfile is activated when response body responds to #to_path.
        def method_missing: (untyped name, *untyped args) { (?) -> untyped } -> untyped

        private

        # Yields reasonably sized chunks of uploaded file's partial content
        # specified by the given index range.
        def read_partial_chunks: () { (untyped) -> untyped } -> (nil | untyped)

        # Yields reasonably sized chunks of uploaded file's content.
        def read_chunks: () { (untyped) -> untyped } -> untyped

        # Returns actual path on disk when FileSystem storage is used.
        def path: () -> (untyped | nil)
      end
    end
  end
end

