        def extract_with_filemagic: (untyped io, untyped options) -> (nil | untyped)

        def extract_with_mimemagic: (untyped io, untyped options) -> untyped

        def extract_with_marcel: (untyped io, untyped options) -> (nil | untyped)

        def extract_with_mime_types: (untyped io, untyped options) -> untyped

        def extract_with_mini_mime: (untyped io, untyped options) -> untyped

        def extract_with_content_type: (untyped io, untyped options) -> (untyped | nil)

        def extract_filename: (untyped io) -> (untyped | untyped | nil)
      end
    end
  end
end

class ::Shrine
  module ::Shrine::Plugins
    # Documentation can be found on https://shrinerb.com/docs/plugins/download_endpoint
    module ::Shrine::Plugins::DownloadEndpoint
      def self.load_dependencies: (untyped uploader, **untyped) -> untyped

      def self.configure: (untyped uploader, **untyped opts) -> untyped

      module ::Shrine::Plugins::DownloadEndpoint::ClassMethods
        # Returns the Rack application that retrieves requested files.
        def download_endpoint: (**untyped) -> ::Shrine::DownloadEndpoint

        # Calls the download endpoint passing the request information, and
        # returns the Rack response triple.
        #
        # It uses a trick where it removes the download path prefix from the
        # path info before calling the Rack app, which is what web framework
        # routers do before they're calling a mounted Rack app.
        def download_response: (untyped env, **untyped) -> untyped
      end

      module ::Shrine::Plugins::DownloadEndpoint::FileMethods
        # Returns file URL on the download endpoint.
        def download_url: (**untyped) -> untyped
      end

      class ::Shrine::Plugins::DownloadEndpoint::FileUrl
        attr_reader file: untyped

        def initialize: (untyped file) -> void

        def call: (?host: untyped, ?expires_in: untyped?) -> ::String

        def signature_as_query: (path: untyped, expires_in: untyped) -> (nil | untyped)

        def host: () -> untyped

        def prefix: () -> untyped

        def default_expires_in: () -> untyped

        def secret_key: () -> untyped

        def options: () -> untyped
      end
    end
  end

  # Routes incoming requests. It first asserts that the storage is existent
  # and allowed. Afterwards it proceeds with the file download using
  # streaming.
  class ::Shrine::DownloadEndpoint
    # Writes given options to instance variables.
    def initialize: (untyped options) -> void

    def call: (untyped env) -> ::Array[untyped]

    def inspect: () -> ::String

    alias to_s inspect

    private

    def handle_request: (untyped request) -> untyped

    # Streams or redirects to the uploaded file.
    def serve_file: (untyped uploaded_file, untyped request) -> untyped

    # Streams the uploaded file content.
    def stream_file: (untyped uploaded_file, untyped request) -> untyped

    # Redirects to the uploaded file's direct URL or the specified URL proc.
    def redirect_to_file: (untyped uploaded_file, untyped request) -> ::Array[302 | { "Location" => untyped } | ::Array[untyped]]

    def open_file: (untyped uploaded_file, untyped request) -> untyped

    # Deserializes a Shrine::UploadedFile from a URL component. Returns 404 if
    # storage is not found.
    def get_uploaded_file: (untyped serialized) -> untyped

    def check_signature!: (untyped serialized, untyped signature, untyped expires_at) -> nil

    def not_found!: () -> bot

    def bad_request!: (untyped message) -> bot

    # Halts the request with the error message.
    def error!: (untyped status, untyped message) -> bot
  end
end

