      end

      class ::Shrine::Plugins::DetermineMimeType::MimeTypeAnalyzer
        ::Shrine::Plugins::DetermineMimeType::MimeTypeAnalyzer::SUPPORTED_TOOLS: ::Array[:fastimage | :file | :filemagic | :mimemagic | :marcel | :mime_types | :mini_mime | :content_type]

        ::Shrine::Plugins::DetermineMimeType::MimeTypeAnalyzer::MAGIC_NUMBER: untyped

        def initialize: (untyped tool) -> void

