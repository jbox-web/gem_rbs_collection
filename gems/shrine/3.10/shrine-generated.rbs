class ::Shrine
  module ::Shrine::Plugins
    # Documentation can be found on https://shrinerb.com/docs/plugins/instrumentation
    module ::Shrine::Plugins::Instrumentation
      ::Shrine::Plugins::Instrumentation::EVENTS: ::Array[:upload | :download | :open | :exists | :delete | :metadata]

      # We use a proc in order to be able identify listeners.
      ::Shrine::Plugins::Instrumentation::LOG_SUBSCRIBER: untyped

      def self.configure: (untyped uploader, ?log_subscriber: untyped, **untyped opts) -> untyped

      module ::Shrine::Plugins::Instrumentation::ClassMethods
        # Sends a `*.shrine` event.
        #
        #     # sends a `my_event.shrine` event
        #     Shrine.instrument(:my_event) do
        #       # work
        #     end
        def instrument: (untyped event_name, ?::Hash[untyped, untyped] payload) { (?) -> untyped } -> untyped

        # Subscribes to a `*.shrine` event. It rejects duplicate subscribers.
        #
        #     # subscribes to the `storage_upload.shrine` event
        #     Shrine.subscribe(:storage_upload) do |event|
        #       event.name #=> :storage_upload
        #       event.payload #=> { location: "...", ... }
        #       event[:location] #=> "..."
        #       event.duration #=> 50 (in milliseconds)
        #     end
        def subscribe: (untyped event_name) { (?) -> untyped } -> (nil | untyped)

        private

        def notifications: () -> ::Shrine::Plugins::Instrumentation::Notifications

        def subscribers: () -> untyped
      end

      module ::Shrine::Plugins::Instrumentation::InstanceMethods
        private

        # Sends a `upload.shrine` event.
        def _upload: (untyped io, location: untyped, metadata: untyped, ?upload_options: ::Hash[untyped, untyped], **untyped options) -> untyped

        # Sends a `metadata.shrine` event.
        def get_metadata: (untyped io, ?metadata: untyped?, **untyped options) -> untyped
      end

      module ::Shrine::Plugins::Instrumentation::FileMethods
        # Sends a `download.shrine` event.
        def stream: (untyped destination, **untyped options) -> untyped

        # Sends a `exists.shrine` event.
        def exists?: () -> untyped

        # Sends a `delete.shrine` event.
        def delete: () -> untyped

        private

        # Sends an `open.shrine` event.
        def _open: (?instrument: bool, **untyped options) -> untyped
      end

      # Abstracts away different types of notifications objects
      # (`ActiveSupport::Notifications` and `Dry::Monitor::Notifications`).
      class ::Shrine::Plugins::Instrumentation::Notifications
        attr_reader notifications: untyped

        def initialize: (untyped notifications) -> void

        def subscribe: (untyped event_name) { (untyped) -> untyped } -> untyped

        def instrument: (untyped event_name, untyped payload) { (?) -> untyped } -> untyped

        private

        def dry_monitor_subscribe: (untyped event_name) { (?) -> untyped } -> untyped

        def active_support_subscribe: (untyped event_name) { (untyped) -> untyped } -> untyped

        def library_send: (untyped method_name, *untyped, **untyped) ?{ (?) -> untyped } -> untyped
      end

      # Abstracts away different kind of event objects
      # (`ActiveSupport::Notifications::Event` and `Dry::Events::Event`).
      class ::Shrine::Plugins::Instrumentation::Event
        attr_reader event: untyped

        def initialize: (untyped event) -> void

        def name: () -> untyped

        def payload: () -> untyped

        def []: (untyped name) -> untyped

        def duration: () -> untyped

        private

        def dry_events_name: () -> untyped

        def active_support_name: () -> untyped

        def dry_events_duration: () -> untyped

        def active_support_duration: () -> untyped

        def library_send: (untyped method_name, *untyped, **untyped) ?{ (?) -> untyped } -> untyped
      end

      # Logs received events.
      class ::Shrine::Plugins::Instrumentation::LogSubscriber
        # Entry point for logging.
        def self.call: (untyped event) -> untyped

        def on_upload: (untyped event) -> untyped

        def on_download: (untyped event) -> untyped

        def on_open: (untyped event) -> untyped

        def on_exists: (untyped event) -> untyped

        def on_delete: (untyped event) -> untyped

        def on_metadata: (untyped event) -> untyped

        private

        def format: (?::Hash[untyped, untyped] properties) -> ::String

        def log: (untyped message) -> untyped

        def logger: () -> untyped
      end
    end
  end
end

