module ::Flipper
  class ::Flipper::Expression
    include ::Flipper::Expression::Builder

    def self.build: (untyped object) -> untyped

    attr_reader name: untyped

    attr_reader function: untyped

    attr_reader args: untyped

    def initialize: (untyped name, ?untyped args) -> void

    def evaluate: (?::Hash[untyped, untyped] context) -> untyped

    def eql?: (untyped other) -> untyped

    alias == eql?

    def value: () -> ::Hash[untyped, untyped]

