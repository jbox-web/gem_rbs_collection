module ::Flipper
  module ::Flipper::Cloud
    class ::Flipper::Cloud::MessageVerifier
      class ::Flipper::Cloud::MessageVerifier::InvalidSignature < ::StandardError
      end

      ::Flipper::Cloud::MessageVerifier::DEFAULT_VERSION: "v1"

      def self.header: (untyped signature, untyped timestamp, ?untyped version) -> ::String

      def initialize: (secret: untyped, ?version: untyped) -> void

      def generate: (untyped payload, untyped timestamp) -> untyped

      def header: (untyped signature, untyped timestamp) -> ::String

      # Public: Verifies the signature header for a given payload.
      #
      # Raises a InvalidSignature in the following cases:
      # - the header does not match the expected format
      # - no signatures found with the expected scheme
      # - no signatures matching the expected signature
      # - a tolerance is provided and the timestamp is not within the
      #   tolerance
      #
      # Returns true otherwise.
      def verify: (untyped payload, untyped header, ?tolerance: untyped?) -> true

      private

      # Extracts the timestamp and the signature(s) with the desired version
      # from the header
      def get_timestamp_and_signatures: (untyped header) -> ::Array[untyped]

      # Private
      def fixed_length_secure_compare: (untyped a, untyped b) -> untyped

      # Private
      def secure_compare: (untyped a, untyped b) -> untyped
    end
  end
end

module ::Flipper
  module ::Flipper::Cloud
    class ::Flipper::Cloud::Middleware
      # Internal: The path to match for webhook requests.
      ::Flipper::Cloud::Middleware::WEBHOOK_PATH: ::Regexp

      # Internal: The root path to match for requests.
      ::Flipper::Cloud::Middleware::ROOT_PATH: ::Regexp

      def initialize: (untyped app, ?::Hash[untyped, untyped] options) -> void

