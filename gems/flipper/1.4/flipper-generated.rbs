module ::Flipper
  module ::Flipper::Cloud
    ::Flipper::Cloud::MigrateResult: untyped

    ::Flipper::Cloud::DEFAULT_CLOUD_URL: "https://www.flippercloud.io"

    # Public: Migrate features to Flipper Cloud.
    #
    # flipper  - The Flipper instance to export features from (default: Flipper).
    # app_name - Optional String name of the application.
    #
    # Returns a MigrateResult with code, url, and message.
    def self.migrate: (?untyped flipper, ?app_name: untyped?) -> untyped

    # Public: Push features to an existing Flipper Cloud project.
    #
    # token   - The String token for the Cloud environment.
    # flipper - The Flipper instance to export features from (default: Flipper).
    #
    # Returns a MigrateResult with code and message.
    def self.push: (untyped token, ?untyped flipper) -> untyped

    # Private: Build an HTTP client for Cloud API requests.
    def self.build_client: (untyped path, ?headers: ::Hash[untyped, untyped]) -> untyped
  end
end

module ::Flipper
  module ::Flipper::Cloud
    class ::Flipper::Cloud::Telemetry
      # Internal: Map of instances of telemetry.
      def self.instances: () -> untyped

      def self.reset: () -> untyped

      # Internal: Fetch an instance of telemetry once per process per url +
      # token (aka cloud endpoint). Should only ever be one instance unless you
      # are doing some funky stuff.
      def self.instance_for: (untyped cloud_configuration) -> untyped

      # Public: The cloud configuration to use for this telemetry instance.
      attr_reader cloud_configuration: untyped

      # Internal: Where the metrics are stored between cloud submissions.
      attr_reader metric_storage: untyped

      # Internal: The pool of background threads that submits metrics to cloud.
      attr_reader pool: untyped

      # Internal: The timer that triggers draining the metrics to the pool.
      attr_reader timer: untyped

      # Internal: The interval in seconds for how often telemetry should be sent to cloud.
      attr_reader interval: untyped

      # Internal: The timeout in seconds for how long to wait for the pool to shutdown.
      attr_reader shutdown_timeout: untyped

      # Internal: The proc that is called to submit metrics to cloud.
      attr_accessor submitter: untyped

      def initialize: (untyped cloud_configuration) -> void

      # Public: Records telemetry events based on active support notifications.
      def record: (untyped name, untyped payload) -> (nil | untyped)

      # Public: Start all the tasks and setup new metric storage.
      def start: () -> untyped

      # Public: Shuts down all the tasks and tries to flush any remaining info to Cloud.
      def stop: () -> untyped

      # Public: Restart all the tasks and reset the storage.
      def restart: () -> untyped

      # Internal: Sets the interval in seconds for how often telemetry should be sent to cloud.
      def interval=: (untyped value) -> untyped

      # Internal: Sets the timeout in seconds for how long to wait for the pool to shutdown.
      def shutdown_timeout=: (untyped value) -> untyped

      private

      def detect_forking: () -> (untyped | nil)

      # Drains the metric storage and enqueues the metrics to be posted to cloud.
      def post_to_pool: () -> untyped

      # Posts the drained metrics to cloud.
      def post_to_cloud: (untyped drained) -> untyped

      def error: (untyped message) -> untyped

      def info: (untyped message) -> untyped

      def debug: (untyped message) -> untyped
    end
  end
end

module ::Flipper
  module ::Flipper::Cloud
    class ::Flipper::Cloud::Telemetry
      class ::Flipper::Cloud::Telemetry::BackoffPolicy
        # Private: The default minimum timeout between intervals in milliseconds.
        ::Flipper::Cloud::Telemetry::BackoffPolicy::MIN_TIMEOUT_MS: 30000

        # Private: The default maximum timeout between intervals in milliseconds.
        ::Flipper::Cloud::Telemetry::BackoffPolicy::MAX_TIMEOUT_MS: 120000

        # Private: The value to multiply the current interval with for each
        # retry attempt.
        ::Flipper::Cloud::Telemetry::BackoffPolicy::MULTIPLIER: ::Float

        # Private: The randomization factor to use to create a range around the
        # retry interval.
        ::Flipper::Cloud::Telemetry::BackoffPolicy::RANDOMIZATION_FACTOR: ::Float

        # Private
        attr_reader min_timeout_ms: untyped

        # Private
        attr_reader max_timeout_ms: untyped

        # Private
        attr_reader multiplier: untyped

        # Private
        attr_reader randomization_factor: untyped

        # Private
        attr_reader attempts: untyped

        # Public: Create new instance of backoff policy.
        #
        # options - The Hash of options.
        #   :min_timeout_ms - The minimum backoff timeout.
        #   :max_timeout_ms - The maximum backoff timeout.
        #   :multiplier - The value to multiply the current interval with for each
        #                 retry attempt.
        #   :randomization_factor - The randomization factor to use to create a range
        #                           around the retry interval.
        def initialize: (?::Hash[untyped, untyped] options) -> void

        # Public: Returns the next backoff interval in milliseconds.
        def next_interval: () -> untyped

        def reset: () -> 0

        private

        def add_jitter: (untyped base, untyped randomization_factor) -> untyped
      end
    end
  end
end

