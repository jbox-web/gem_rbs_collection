    def call_with_context?: () -> (false | true)
  end
end

module ::Flipper
  class ::Flipper::Expression
    module ::Flipper::Expression::Builder
      def build: (untyped object) -> untyped

      def add: (*untyped expressions) -> untyped

      def remove: (*untyped expressions) -> untyped

      def any: () -> (self | untyped)

      def all: () -> (self | untyped)

      def equal: (untyped object) -> untyped

      alias eq equal

      def not_equal: (untyped object) -> untyped

      alias neq not_equal

      def greater_than: (untyped object) -> untyped

      alias gt greater_than

      def greater_than_or_equal_to: (untyped object) -> untyped

      alias gte greater_than_or_equal_to

      alias greater_than_or_equal greater_than_or_equal_to

      def less_than: (untyped object) -> untyped

      alias lt less_than

      def less_than_or_equal_to: (untyped object) -> untyped

      alias lte less_than_or_equal_to

      alias less_than_or_equal less_than_or_equal_to

      def percentage_of_actors: (untyped object) -> untyped

      def any?: () -> untyped

      def all?: () -> untyped

      def group?: () -> untyped
    end
  end
end

