module ::Zip
  class ::Zip::OutputStream
    include ::Zip::IOExtras::AbstractOutputStream

    attr_accessor comment: untyped

    # Opens the indicated zip file. If a file with that name already
    # exists it will be overwritten.
    def initialize: (untyped file_name, ?bool dep_stream, ?untyped? dep_encrypter, ?stream: bool, ?encrypter: untyped?) -> void

    def self.open: (untyped file_name, ?untyped? dep_encrypter, ?encrypter: untyped?) ?{ (untyped) -> untyped } -> untyped

