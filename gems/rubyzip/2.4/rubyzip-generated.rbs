    def get_compressor: (untyped entry, untyped level) -> untyped

    def update_local_headers: () -> untyped

    def write_central_directory: () -> untyped

    def finish: () -> untyped

    public

    # Modeled after IO.<<
    def <<: (untyped data) -> self
  end
end

