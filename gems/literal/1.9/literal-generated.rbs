  def store: (untyped key, untyped result) -> untyped

  def acquire: (untyped key) -> (false | true)

  def release: (untyped key) -> untyped
end

class ::Literal::Success < ::Literal::Result
  class ::Literal::Success::Generic
    include ::Literal::Type

    def initialize: (untyped type) -> void

