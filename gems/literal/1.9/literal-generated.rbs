    def success: (untyped value) -> bot

    def failure: (untyped error) -> bot
  end

  class ::Literal::Result::Generic
    include ::Literal::Type

    def initialize: (untyped success_type, untyped failure_type) -> void

    attr_reader success_type: untyped

    attr_reader failure_type: untyped

    def ===: (untyped object) -> untyped

    def success: (untyped value) -> untyped

    def failure: (untyped error) -> untyped
  end

  def handle: () { (?) -> untyped } -> untyped
end

class ::Literal::ResultHandler
  def initialize: (untyped result) -> void

  def handle: () ?{ (untyped) -> untyped } -> untyped

  def success: (?untyped type) { (?) -> untyped } -> ::Array[untyped]

  def failure: (?untyped type) { (?) -> untyped } -> ::Array[untyped]

  private

  def covered_type: (untyped cases) -> untyped
end

class ::Literal::Set
  class ::Literal::Set::Generic
    def initialize: (untyped type) -> void

    def new: (*untyped value) -> ::Literal::Set

    alias [] new

    def ===: (untyped value) -> untyped

    def inspect: () -> ::String
  end

  include ::Enumerable[untyped]

  def initialize: (untyped value, type: untyped) -> void

  attr_reader __type__: untyped

  attr_reader __value__: untyped

  def freeze: () -> untyped

  def each: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped
end

class ::Literal::Struct < ::Literal::DataStructure
  def self.prop: (untyped name, untyped type, ?::Symbol kind, ?reader: ::Symbol, ?writer: ::Symbol, ?default: untyped?, ?description: untyped?) -> untyped

  def []: (untyped key) -> untyped

  def []=: (untyped key, untyped value) -> untyped
end

class ::Literal::SubtypeContext
  def initialize: () -> void

  attr_reader memo: untyped

  attr_reader in_progress: untyped

  def memoized?: (untyped key) -> (false | true)

