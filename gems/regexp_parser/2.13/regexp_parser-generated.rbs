  end

  # Invalid sequence format. Used for escape sequences, mainly.
  class ::Regexp::Scanner::InvalidSequenceError < ::Regexp::Scanner::ValidationError
    def initialize: (?::String what, ?::String where) -> void
  end

  # Invalid group. Used for named groups.
  class ::Regexp::Scanner::InvalidGroupError < ::Regexp::Scanner::ValidationError
    def initialize: (untyped what, untyped reason) -> void
  end

  # Invalid groupOption. Used for inline options.
  # TODO: should become InvalidGroupOptionError in v3.0.0 for consistency
  class ::Regexp::Scanner::InvalidGroupOption < ::Regexp::Scanner::ValidationError
    def initialize: (untyped option, untyped text) -> void
  end

  # Invalid back reference. Used for name a number refs/calls.
  class ::Regexp::Scanner::InvalidBackrefError < ::Regexp::Scanner::ValidationError
    def initialize: (untyped what, untyped reason) -> void
  end

  # The property name was not recognized by the scanner.
  class ::Regexp::Scanner::UnknownUnicodePropertyError < ::Regexp::Scanner::ValidationError
    def initialize: (untyped name, untyped _) -> void
  end

  # The POSIX class name was not recognized by the scanner.
  class ::Regexp::Scanner::UnknownPosixClassError < ::Regexp::Scanner::ValidationError
    def initialize: (untyped text, untyped _) -> void
  end
end

module ::Regexp::Syntax
  class ::Regexp::Syntax::SyntaxError < ::Regexp::Parser::Error
  end
end

module ::Regexp::Syntax
  # A syntax that always returns true, passing all tokens as implemented. This
  # is useful during development, testing, and should be useful for some types
  # of transformations as well.
  class ::Regexp::Syntax::Any < ::Regexp::Syntax::Base
    def self.implements?: (untyped _type, untyped _token) -> true
  end
end

module ::Regexp::Syntax
  class ::Regexp::Syntax::NotImplementedError < ::Regexp::Syntax::SyntaxError
    def initialize: (untyped syntax, untyped type, untyped token) -> void
  end

  # A lookup map of supported types and tokens in a given syntax
  class ::Regexp::Syntax::Base
    include ::Regexp::Syntax::Token

    attr_accessor self.features: untyped

    # automatically inherit features through the syntax class hierarchy
    def self.inherited: (untyped subclass) -> untyped

    def self.implements: (untyped type, untyped tokens) -> untyped

    def self.excludes: (untyped type, untyped tokens) -> untyped

    def self.implements?: (untyped type, untyped token) -> untyped

    alias self.check? self.implements?

    def self.implementations: (untyped type) -> untyped

    def self.implements!: (untyped type, untyped token) -> (untyped | nil)

    alias self.check! self.implements!

    def self.added_features: () -> ::Hash[untyped, untyped]

    def self.removed_features: () -> ::Hash[untyped, untyped]

    def self.normalize: (untyped type, untyped token) -> ([ :backref, :name_call ] | [ :backref, :name_recursion_ref ] | [ :backref, :name_ref ] | [ :backref, :number_call ] | [ :backref, :number_recursion_ref ] | [ :backref, :number_ref ] | [ :backref, :number_rel_call ] | [ :backref, :number_rel_ref ] | [ :group, :named ] | [ untyped, untyped ])

    def self.normalize_group: (untyped type, untyped token) -> ([ :group, :named ] | [ untyped, untyped ])

    def self.normalize_backref: (untyped type, untyped token) -> ([ :backref, :name_call ] | [ :backref, :name_recursion_ref ] | [ :backref, :name_ref ] | [ :backref, :number_call ] | [ :backref, :number_recursion_ref ] | [ :backref, :number_ref ] | [ :backref, :number_rel_call ] | [ :backref, :number_rel_ref ] | [ untyped, untyped ])

    # TODO: drop this backwards compatibility code in v3.0.0, do `private :new`
    def initialize: () -> void

    def method_missing: (untyped name, *untyped args) -> untyped

    def respond_to_missing?: (untyped name, ?bool include_private) -> untyped
  end
end

