# A very thin wrapper around the scanner that breaks quantified literal runs,
# collects emitted tokens into an array, calculates their nesting depth, and
# normalizes tokens for the parser, and checks if they are implemented by the
# given syntax flavor.
class ::Regexp::Lexer
  ::Regexp::Lexer::OPENING_TOKENS: ::Array[:capture | :passive | :lookahead | :nlookahead | :lookbehind | :nlookbehind | :atomic | :options | :options_switch | :named | :absence | :open]

  ::Regexp::Lexer::CONDITION_TOKENS: ::Array[:condition | :condition_close]

  def self.lex: (untyped input, ?untyped? syntax, ?options: untyped?, ?collect_tokens: bool) { (?) -> untyped } -> untyped

  alias self.scan self.lex

  def lex: (untyped input, ?untyped? syntax, ?options: untyped?, ?collect_tokens: bool) { (?) -> untyped } -> untyped

  def emit: (untyped token) -> untyped

  private

  attr_accessor block: untyped

  attr_accessor collect_tokens: untyped

  attr_accessor tokens: untyped

  attr_accessor prev_token: untyped

  attr_accessor preprev_token: untyped

  attr_accessor nesting: untyped

  attr_accessor set_nesting: untyped

  attr_accessor conditional_nesting: untyped

  attr_accessor shift: untyped

  def ascend: (untyped type, untyped token) -> (nil | untyped)

  def descend: (untyped type, untyped token) -> (nil | untyped)

  # called by scan to break a literal run that is longer than one character
  # into two separate tokens when it is followed by a quantifier
  def break_literal_run: (untyped token) -> (nil | ::Array[untyped])

  # if a codepoint list is followed by a quantifier, that quantifier applies
  # to the last codepoint, e.g. /\u{61 62 63}{3}/ =~ 'abccc'
  # c.f. #break_literal_run.
  def break_codepoint_list: (untyped token) -> (nil | ::Array[untyped])

  def merge_condition: (untyped current, untyped last) -> untyped
end

