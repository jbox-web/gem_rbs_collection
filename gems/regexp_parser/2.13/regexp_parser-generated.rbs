    def base_length: () -> ::Integer

    def full_length: () -> ::Integer

    # #to_s reproduces the original source, as an unparser would.
    #
    # It takes an optional format argument.
    #
    # Example:
    #
    # lit = Regexp::Parser.parse(/a +/x)[0]
    #
    # lit.to_s            # => 'a+'  # default; with quantifier
    # lit.to_s(:full)     # => 'a+'  # default; with quantifier
    # lit.to_s(:base)     # => 'a'   # without quantifier
    # lit.to_s(:original) # => 'a +' # with quantifier AND intermittent decorations
    #
    def to_s: (?::Symbol format) -> ::String

    alias to_str to_s

    def pre_quantifier_decoration: (?::Symbol expression_format) -> (untyped | nil)

    def quantifier_affix: (?::Symbol expression_format) -> (untyped | nil)

    def offset: () -> ::Array[untyped]

    def coded_offset: () -> ::String
  end
