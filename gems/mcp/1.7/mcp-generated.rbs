module ::MCP
  module ::MCP::Methods
    ::MCP::Methods::INITIALIZE: "initialize"

    ::MCP::Methods::PING: "ping"

    ::MCP::Methods::LOGGING_SET_LEVEL: "logging/setLevel"

    # Sessionless capability discovery (MCP 2026-07-28 draft, SEP-2575).
    ::MCP::Methods::SERVER_DISCOVER: "server/discover"

    # Long-lived notification subscription stream (MCP 2026-07-28, SEP-2575),
    # replacing the legacy HTTP GET listening stream. Served at the transport layer
    # (Streamable HTTP modern path); transports without streaming support answer `-32601`.
    ::MCP::Methods::SUBSCRIPTIONS_LISTEN: "subscriptions/listen"

    ::MCP::Methods::PROMPTS_GET: "prompts/get"

    ::MCP::Methods::PROMPTS_LIST: "prompts/list"

    ::MCP::Methods::COMPLETION_COMPLETE: "completion/complete"

    ::MCP::Methods::RESOURCES_LIST: "resources/list"

    ::MCP::Methods::RESOURCES_READ: "resources/read"

    ::MCP::Methods::RESOURCES_TEMPLATES_LIST: "resources/templates/list"

    ::MCP::Methods::RESOURCES_SUBSCRIBE: "resources/subscribe"

    ::MCP::Methods::RESOURCES_UNSUBSCRIBE: "resources/unsubscribe"

    ::MCP::Methods::TOOLS_CALL: "tools/call"

    ::MCP::Methods::TOOLS_LIST: "tools/list"

    # RPC methods the stateless modern lifecycle removes (MCP 2026-07-28, SEP-2575):
    # `initialize` is replaced by the per-request `_meta` envelope plus `server/discover`,
    # `logging/setLevel` by the envelope's `logLevel` member, and `ping` and the resource
    # subscription pair by the connectionless model, which leaves nothing to keep alive
    # or subscribe on. A modern-era request naming one of these answers with `-32601`
    # Method not found (HTTP 404 on Streamable HTTP).
    ::MCP::Methods::MODERN_REMOVED_METHODS: ::Array[untyped]

    ::MCP::Methods::ROOTS_LIST: "roots/list"

    ::MCP::Methods::SAMPLING_CREATE_MESSAGE: "sampling/createMessage"

    ::MCP::Methods::ELICITATION_CREATE: "elicitation/create"

    # Notification methods
    ::MCP::Methods::NOTIFICATIONS_INITIALIZED: "notifications/initialized"

    ::MCP::Methods::NOTIFICATIONS_TOOLS_LIST_CHANGED: "notifications/tools/list_changed"

    ::MCP::Methods::NOTIFICATIONS_PROMPTS_LIST_CHANGED: "notifications/prompts/list_changed"

    ::MCP::Methods::NOTIFICATIONS_RESOURCES_LIST_CHANGED: "notifications/resources/list_changed"

    ::MCP::Methods::NOTIFICATIONS_RESOURCES_UPDATED: "notifications/resources/updated"

    ::MCP::Methods::NOTIFICATIONS_ROOTS_LIST_CHANGED: "notifications/roots/list_changed"

    ::MCP::Methods::NOTIFICATIONS_MESSAGE: "notifications/message"

    ::MCP::Methods::NOTIFICATIONS_PROGRESS: "notifications/progress"

    ::MCP::Methods::NOTIFICATIONS_CANCELLED: "notifications/cancelled"

    ::MCP::Methods::NOTIFICATIONS_ELICITATION_COMPLETE: "notifications/elicitation/complete"

    # First message on a `subscriptions/listen` stream (SEP-2575): reports the subset
    # of requested notification types the server agreed to honor.
    ::MCP::Methods::NOTIFICATIONS_SUBSCRIPTIONS_ACKNOWLEDGED: "notifications/subscriptions/acknowledged"

    class ::MCP::Methods::MissingRequiredCapabilityError < ::StandardError
      attr_reader method: untyped

      attr_reader capability: untyped

      def initialize: (untyped method, untyped capability) -> void
    end

    def self.notification?: (untyped method) -> (false | true)

    def self.ensure_capability!: (untyped method, untyped capabilities) -> nil

    private

    def self.require_capability!: (untyped method, untyped capabilities, *untyped keys) -> (nil | untyped)
  end
end

