module ::MCP
  class ::MCP::Configuration
    ::MCP::Configuration::LATEST_STABLE_PROTOCOL_VERSION: "2026-07-28"

    ::MCP::Configuration::ROOTS_SAMPLING_LOGGING_DEPRECATED_PROTOCOL_VERSION: "2026-07-28"

    ::MCP::Configuration::SUPPORTED_STABLE_PROTOCOL_VERSIONS: ::Array[untyped | "2025-11-25" | "2025-06-18" | "2025-03-26" | "2024-11-05"]

    ::MCP::Configuration::DEFAULT_NEGOTIATED_PROTOCOL_VERSION: "2025-03-26"

    # Protocol versions of the stateless "modern" lifecycle introduced by the MCP 2026-07-28 spec release (SEP-2575),
    # where each request carries its own version in `_meta` and is validated against this list independently,
    # with no handshake. These are reachable only through `server/discover` and the per-request envelope.
    # https://github.com/modelcontextprotocol/modelcontextprotocol/pull/2575
    ::MCP::Configuration::LATEST_MODERN_PROTOCOL_VERSION: "2026-07-28"

    ::MCP::Configuration::SUPPORTED_MODERN_PROTOCOL_VERSIONS: ::Array[untyped]

    # Protocol versions reachable through the legacy `initialize` handshake, derived so the era partition
    # (handshake = stable minus modern) cannot drift when a new revision lands.
    # Per the SEP-2575 era model, an era is a property of the protocol version itself: legacy versions establish
    # a session via `initialize` (2025-11-25 and earlier), and modern versions carry the version on every request
    # in `_meta` with no handshake at all. The handshake therefore never negotiates a modern version:
    # a client asking `initialize` for one is counter-offered
    # `LATEST_HANDSHAKE_PROTOCOL_VERSION`, matching the TypeScript and Python SDKs.
    ::MCP::Configuration::SUPPORTED_HANDSHAKE_PROTOCOL_VERSIONS: untyped

    ::MCP::Configuration::LATEST_HANDSHAKE_PROTOCOL_VERSION: untyped

    def self.modern_protocol_version?: (untyped version) -> (false | true)

    def self.handshake_protocol_version?: (untyped version) -> untyped

    # The one statement of the client-side handshake contract, shared by every transport:
    # a modern version cannot ride the legacy `initialize` handshake.
    def self.reject_modern_handshake_version!: (untyped version) -> (nil | untyped)

    attr_writer exception_reporter: untyped

    attr_writer around_request: untyped

    # @deprecated Use {#around_request=} instead. `instrumentation_callback`
    #   fires only after a request completes and cannot wrap execution in a
    #   surrounding block (e.g. for Application Performance Monitoring (APM) spans).
    # @see #around_request=
    attr_writer instrumentation_callback: untyped

    def initialize: (?exception_reporter: untyped?, ?around_request: untyped?, ?instrumentation_callback: untyped?, ?protocol_version: untyped?, ?validate_tool_call_arguments: bool, ?validate_tool_call_results: bool, ?instrument_server_context: bool) -> void

    def protocol_version=: (untyped protocol_version) -> untyped

    def validate_tool_call_arguments=: (untyped validate_tool_call_arguments) -> untyped

    # Opt in to exposing the user-defined `server_context` in the
    # `around_request` / `instrumentation_callback` data hash. Off by default:
    # the hash is application-supplied and may hold values a tracing backend
    # should not receive, so surfacing it has to be a deliberate choice.
    def instrument_server_context=: (untyped instrument_server_context) -> untyped

    def validate_tool_call_results=: (untyped validate_tool_call_results) -> untyped

    # The pin scopes the `initialize` handshake, so an unset pin reads as the version that handshake
    # settles on by default. Reading the newest version of any era here would hand back a value
    # the writer rejects, and no caller wants the modern revision: a modern connection carries
    # its version on every request instead of consulting configuration.
    def protocol_version: () -> untyped

    def protocol_version?: () -> (false | true)

    def exception_reporter: () -> untyped

    def exception_reporter?: () -> (false | true)

    def around_request: () -> untyped

    def around_request?: () -> (false | true)

    # @deprecated Use {#around_request} instead. `instrumentation_callback`
    #   fires only after a request completes and cannot wrap execution in a
    #   surrounding block (e.g. for Application Performance Monitoring (APM) spans).
    # @see #around_request
    def instrumentation_callback: () -> untyped

    # @deprecated Use {#around_request?} instead.
    # @see #around_request?
    def instrumentation_callback?: () -> (false | true)

    attr_reader validate_tool_call_arguments: untyped

    attr_reader validate_tool_call_results: untyped

    def instrument_server_context?: () -> (false | true)

    def validate_tool_call_arguments?: () -> (false | true)

    def validate_tool_call_results?: () -> (false | true)

    def merge: (untyped other) -> (self | untyped)

    private

    # A pin scopes the `initialize` handshake, so only handshake versions are accepted:
    # a modern version has no handshake to pin (its version rides every request in `_meta`),
    # and accepting one here would configure nothing. Failing at construction beats
    # a setting that silently does not apply.
    def validate_protocol_version!: (untyped protocol_version) -> (nil | untyped)

    def validate_value_of_validate_tool_call_arguments!: (untyped validate_tool_call_arguments) -> (untyped | nil)

    def validate_value_of_validate_tool_call_results!: (untyped validate_tool_call_results) -> (untyped | nil)

    def validate_value_of_instrument_server_context!: (untyped instrument_server_context) -> (untyped | nil)

    def default_exception_reporter: () -> ::Proc

    def default_around_request: () -> ::Proc

    # @deprecated Use {#default_around_request} instead.
    def default_instrumentation_callback: () -> ::Proc
  end
end

