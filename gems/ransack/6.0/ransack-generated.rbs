module ::Ransack
  module ::Ransack::Nodes
    class ::Ransack::Nodes::Condition < ::Ransack::Nodes::Node
      attr_accessor predicate: untyped

      # The effective null sentinel, captured when the condition is built. A
      # Context can be shared by several searches, each with its own
      # per-search override; reading the context lazily at SQL generation or
      # form rendering time would let a later search's setting rewrite an
      # earlier search's conditions.
      attr_reader null_sentinel: untyped

      def initialize: (untyped context) -> void

      def self.extract: (untyped context, untyped key, untyped values) -> (::Ransack::Nodes::Condition | nil)

      private

      def self.extract_values_for_condition: (untyped key, ?untyped? context) -> ::Array[untyped]

      # A condition name carries one combinator: `a_or_b_or_c` or
      # `a_and_b`. There is no grammar for precedence between the two,
      # so a name using both is rejected under a strict search rather
      # than silently applying whichever came first to every attribute
      # (#1019). Mixed logic is what groupings are for.
      def self.combinator_in: (untyped str, untyped context) -> untyped

      public

      def valid?: () -> untyped

      def valid_arity?: () -> untyped

      def attributes: () -> ::Array[untyped]

      alias a attributes

      def attributes=: (untyped args) -> (::Array[untyped] | ::Hash[untyped, untyped])

      alias a= attributes=

      def values: () -> ::Array[untyped]

      alias v values

      def values=: (untyped args) -> (::Array[untyped] | ::Hash[untyped, untyped])

      alias v= values=

      # A supplied combinator wins; the one an expanded alias carried is the
      # fallback, so `a: { '0' => { name: 'term' } }` with `term` aliasing
      # `name_or_email` ORs its two attributes without an `m` in the params.
      # The fallback covers a missing or blank `m` only: an unknown one that
      # `Node#combinator=` normalised to nil still fails `valid_combinator?`,
      # as it does for any other multi-attribute condition.
      def combinator: () -> (nil | untyped)

      def combinator=: (untyped val) -> (false | true)

      alias m= combinator=

      alias m combinator

      # == build_attribute
      #
      #  This method was originally called from Nodes::Grouping#new_condition
      #  only, without arguments, without #valid? checking, to build a new
      #  grouping condition.
      #
      #  After refactoring in 235eae3, it is now called from 2 places:
      #
      #  1. Nodes::Condition#attributes=, with +name+ argument passed or +name+
      #     and +ransacker_args+. Attributes are included only if #valid?.
      #
      #  2. Nodes::Grouping#new_condition without arguments. In this case, the
      #     #valid? conditional needs to be bypassed, otherwise nothing is
      #     built. The `name.nil?` conditional below currently does this.
      #
      #  TODO: Add test coverage for this behavior and ensure that `name.nil?`
      #  isn't fixing issue #701 by introducing untested regressions.
      #
      # An attribute named in advanced-search params (`a: { '0' => { name:
      # 'term' } }`) arrives raw, unlike a simple key, which `Condition.extract`
      # resolves before it gets here. So a `ransack_alias` is expanded here the
      # same way: an alias to one attribute is built under that name, and an
      # alias to a compound becomes one attribute per segment, joined by the
      # compound's combinator (#1728). Left alone, the alias passed `valid?`
      # by being allowlisted and bound a column that does not exist.
      def build_attributes: (untyped name, ?untyped ransacker_args) -> untyped

      def build_attribute: (?untyped? name, ?untyped ransacker_args) -> untyped

      def build_value: (?untyped? val) -> untyped

      def value: () -> untyped

      # Casting the sentinel here would turn it into a real value on a
      # typed column (e.g. an integer column casts it to 0), so a form
      # re-rendering this condition's current value would resubmit that
      # literal instead of the sentinel.
      def cast_unless_null_sentinel: (untyped v) -> untyped

      # The long spellings route through the short setters: `p=` resolves a
      # Predicate object, whereas the `predicate=` attribute writer would store
      # the bare name. `predicate_name` is the spelling the ransacker docs
      # used for years, so it is accepted too (#1009).
      ::Ransack::Nodes::Condition::LONG_KEYS: { "attributes" => "a", "values" => "v", "predicate" => "p", "predicate_name" => "p", "combinator" => "m" }

      def build: (untyped params) -> self

      def persisted?: () -> false

      def key: () -> untyped

      def eql?: (untyped other) -> untyped

      alias == eql?

      def hash: () -> ::Integer

      def predicate_name=: (untyped name) -> untyped

      alias p= predicate_name=

      def predicate_name: () -> (untyped | nil)

      alias p predicate_name

      def validated_values: () -> untyped

      def null_sentinel_requested?: () -> untyped

      def casted_values_for_attribute: (untyped attr) -> untyped

      def formatted_values_for_attribute: (untyped attr) -> untyped

      def arel_predicate_for_attribute: (untyped attr) -> untyped

      # The column (or ransacker expression) a predicate compares against.
      # A case-insensitive predicate lowers it, unless the dialect has a
      # case-insensitive LIKE of its own (ILIKE), in which case the lowering
      # is left to the database. LOWER() is applied as a function rather than
      # through Arel's Attribute#lower so that a ransacker returning any Arel
      # node — a SQL literal, an infix operation — is lowered too (#1357).
      def attr_value_for_attribute: (untyped attr) -> untyped

      def default_type: () -> untyped

      def inspect: () -> ::String

      def negative?: () -> untyped

      def arel_predicate: () -> untyped

      def not_nested_condition: (untyped attribute, untyped parent_table) -> untyped

      private

      def combinator_method: () -> (:or | :and)

      def format_predicate: (untyped attribute) -> untyped

      # `validated_values` has already excluded the sentinel above, so
      # `predicate` here is built from the real values alone (or, when
      # the sentinel was the only value submitted, from an empty
      # array). An empty IN or eq_any/in_any is not `IS NULL` on its
      # own terms (an empty `IN` is a literal false, and an empty
      # `eq_any` builds a broken Grouping), so that case is replaced
      # outright rather than OR'd.
      def apply_null_sentinel: (untyped predicate, untyped attr_value) -> untyped

      def in_predicate?: (untyped predicate) -> (nil | untyped)

      ::Ransack::Nodes::Condition::LIKE_PREDICATES: ::Array["matches" | "matches_any" | "matches_all" | "does_not_match" | "does_not_match_any" | "does_not_match_all"]

      def like_predicate?: (untyped arel_predicate) -> (false | true)

      # Builds a LIKE / NOT LIKE node (or the _any / _all forms).
      #
      # The value is wrapped in Arel::Nodes.build_quoted so that Active
      # Record's `normalizes` cannot rewrite the wildcards, and the escape
      # character is passed so the escaping done by `escape_wildcards` is
      # honoured: without an explicit ESCAPE clause SQLite treats a backslash
      # as a literal character (#1581). The compound forms iterate over an
      # Array of patterns, so each element is quoted on its own.
      #
      # Only the `i_` predicates ask for a case-insensitive match. Arel's
      # PostgreSQL visitor renders a case-sensitive `matches` as LIKE and the
      # other kind as ILIKE; before 6.0 the flag was never passed and every
      # LIKE on PostgreSQL became ILIKE (#1421).
      def like_predicate: (untyped attribute, untyped arel_predicate, ?untyped values) -> untyped

      ::Ransack::Nodes::Condition::STRING_LIKE_TYPES: ::Array[:string | :text | :citext]

      def string_like_attribute?: (untyped attribute) -> (false | true)

      def casted_array?: (untyped predicate) -> (false | true)

      def format_values_for: (untyped predicate) -> untyped

      # Walks a predicate node for the shapes `#arel_predicate` can produce
      # (a single Binary, an In/NotIn holding an Array, or several of these
      # combined with Grouping/And/Or) and replaces each integer Casted
      # value it finds with the plain integer, in place.
      def unwrap_oversized_integers: (untyped node) -> untyped

      def unwrap_binary_right: (untyped node) -> (::Integer | nil)

      def plain_integer: (untyped arel_node) -> (nil | untyped)

      def length_predicate?: () -> untyped

      def length_function_for_attribute: (untyped attribute) -> untyped

      def valid_combinator?: () -> untyped
    end
  end
end

module ::Ransack
  module ::Ransack::Nodes
    class ::Ransack::Nodes::Grouping < ::Ransack::Nodes::Node
      attr_reader combinator: untyped

      # The writer is inherited from Node, which normalises the value. Defining
      # it here as well — or aliasing before the definition is in place — would
      # bind `m=` to the plain attribute writer and skip that normalisation,
      # which is how `g: [{ m: 'OR' }]` silently fell back to AND.
      alias m combinator
      def m=: (*untyped, **untyped) ?{ (*untyped) -> untyped } -> untyped

      def initialize: (untyped context, ?untyped? combinator) -> void

      def persisted?: () -> false

      def translate: (untyped key, ?::Hash[untyped, untyped] options) -> untyped

      def conditions: () -> ::Array[untyped]

      alias c conditions

      def conditions=: (untyped conditions) -> untyped

      alias c= conditions=

      def []: (untyped key) -> untyped

      def []=: (untyped key, untyped value) -> untyped

      def values: () -> untyped

      def respond_to?: (untyped method_id) -> untyped

      def build_condition: (?::Hash[untyped, untyped] opts) -> untyped

      def new_condition: (?::Hash[untyped, untyped] opts) -> untyped

      def groupings: () -> ::Array[untyped]

      alias g groupings

      def groupings=: (untyped groupings) -> (::Array[untyped] | ::Hash[untyped, untyped])

      alias g= groupings=

      def method_missing: (untyped method_id, *untyped args) -> untyped

      def attribute_method?: (untyped name) -> (false | true | untyped)

      def build_grouping: (?::Hash[untyped, untyped] params) -> ::Ransack::Nodes::Grouping

      def new_grouping: (?::Hash[untyped, untyped] params) -> ::Ransack::Nodes::Grouping

      def build: (untyped params) -> self

      def inspect: () -> ::String

      private

      def write_attribute: (untyped name, untyped val) -> (untyped | nil)

      def read_attribute: (untyped name) -> untyped

      # Drops a multiparameter index (`created_at(1i)`) and then the predicate
      # from a key. The index is found by a plain scan. The `/(.+?)\(/` this
      # replaces let its lazy group re-run from every position of a long key,
      # which CodeQL reports as polynomial (rb/polynomial-redos); Ruby's engine
      # short-circuits that in practice, but one pass needs no such help.
      def strip_predicate_and_index: (untyped str) -> untyped

      # A condition is dropped when it fails validation, as an unknown
      # attribute or predicate would be. One failure is worth naming: a
      # single-value predicate given several values. A strict search raises
      # for it, so the caller learns why the filter vanished (#1724). The
      # check only applies once the predicate and an attribute have resolved;
      # a condition that is invalid for another reason keeps its behaviour.
      def add_condition: (untyped attrs) -> untyped

      def arity_failure?: (untyped condition) -> untyped

      def remove_duplicate_conditions!: () -> untyped
    end
  end
