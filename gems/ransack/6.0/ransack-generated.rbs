    # This does not bypass `ransackable_attributes`: `NULL` on an exposed
    # attribute is already reachable through the built-in `null` predicate.
    #
    # See https://github.com/activerecord-hackery/ransack/issues/940
    #
    def null_sentinel=: (untyped value) -> untyped

    def arel_predicate_with_suffix: (untyped arel_predicate, untyped suffix) -> (untyped | ::String)
  end
end

module ::Ransack
  module ::Ransack::Constants
    ::Ransack::Constants::OR: "or"

    ::Ransack::Constants::AND: "and"

    ::Ransack::Constants::CAP_SEARCH: "Search"

    ::Ransack::Constants::SEARCH: "search"

    ::Ransack::Constants::SEARCHES: "searches"

    ::Ransack::Constants::ATTRIBUTE: "attribute"

    ::Ransack::Constants::ATTRIBUTES: "attributes"

    ::Ransack::Constants::COMBINATOR: "combinator"

    ::Ransack::Constants::TWO_COLONS: "::"

    ::Ransack::Constants::UNDERSCORE: "_"

    ::Ransack::Constants::LEFT_PARENTHESIS: "("

    ::Ransack::Constants::Q: "q"

    ::Ransack::Constants::I: "i"

    ::Ransack::Constants::DOT_ASTERIX: ".*"

    ::Ransack::Constants::STRING_JOIN: "string_join"

    ::Ransack::Constants::ASSOCIATION_JOIN: "association_join"

    ::Ransack::Constants::STASHED_JOIN: "stashed_join"

    ::Ransack::Constants::JOIN_NODE: "join_node"

    ::Ransack::Constants::TRUE_VALUES: untyped

    ::Ransack::Constants::FALSE_VALUES: untyped

    ::Ransack::Constants::BOOLEAN_VALUES: untyped

    ::Ransack::Constants::AND_OR: ::Array["and" | "or"]

    ::Ransack::Constants::IN_NOT_IN: ::Array["in" | "not_in"]

    ::Ransack::Constants::SUFFIXES: ::Array["_any" | "_all"]

    ::Ransack::Constants::AREL_PREDICATES: ::Array["eq" | "not_eq" | "matches" | "does_not_match" | "lt" | "lteq" | "gt" | "gteq" | "in" | "not_in"]

    ::Ransack::Constants::A_S_I: ::Array["a" | "s" | "i"]

    # The predicates `Ransack.options[:null_sentinel]` applies to. Limited to
    # the positive equality family (`eq`, `in`, and their `_any` compounds)
    # because these are the only predicates where "or is null" is
    # unambiguous. The `_all` compounds are excluded because they are
    # conjunctive: `eq_all`/`in_all` require a single column to equal every
    # supplied value at once, so ORing in `IS NULL` would widen a query that
    # already matches nothing (or almost nothing) rather than narrow it. A
    # negative predicate treats the sentinel as a literal value for the same
    # reason of unambiguity: `not_eq` matching the sentinel would otherwise
    # mean "is not unassigned", which reads as the opposite of what a caller
    # submitting it alone almost certainly wants.
    ::Ransack::Constants::NULL_SENTINEL_PREDICATES: ::Array["eq" | "in" | "eq_any" | "in_any"]

    ::Ransack::Constants::EQ: "eq"

    ::Ransack::Constants::NOT_EQ: "not_eq"

    ::Ransack::Constants::EQ_ANY: "eq_any"

    ::Ransack::Constants::NOT_EQ_ALL: "not_eq_all"

    ::Ransack::Constants::CONT: "cont"

    ::Ransack::Constants::RANSACK_SLASH_SEARCHES: "ransack/searches"

    ::Ransack::Constants::RANSACK_SLASH_SEARCHES_SLASH_SEARCH: "ransack/searches/search"

    ::Ransack::Constants::DISTINCT: "DISTINCT "

    # The most `_`-separated segments a single condition or sort key may have
    # before Ransack rejects it as invalid instead of parsing it. Working out
    # whether a key is an attribute, an `_and_`/`_or_` compound or a path
    # through associations is superlinear in this count, and the key comes
    # straight from the query string, so an unbounded one is a CPU-exhaustion
    # denial of service (GHSA-j3f8-w227-4hh8). No real search key is this
    # long: OR-ing every column of a very wide table stays well under it.
    ::Ransack::Constants::MAX_KEY_DEPTH: 200

    ::Ransack::Constants::DERIVED_PREDICATES: ::Array[::Array[untyped | { arel_predicate: "matches", formatter: untyped }] | ::Array["not_cont" | { arel_predicate: "does_not_match", formatter: untyped }] | ::Array["i_cont" | { arel_predicate: "matches", formatter: untyped, case_insensitive: true }] | ::Array["not_i_cont" | { arel_predicate: "does_not_match", formatter: untyped, case_insensitive: true }] | ::Array["start" | { arel_predicate: "matches", formatter: untyped }] | ::Array["not_start" | { arel_predicate: "does_not_match", formatter: untyped }] | ::Array["i_start" | { arel_predicate: "matches", formatter: untyped, case_insensitive: true }] | ::Array["not_i_start" | { arel_predicate: "does_not_match", formatter: untyped, case_insensitive: true }] | ::Array["end" | { arel_predicate: "matches", formatter: untyped }] | ::Array["not_end" | { arel_predicate: "does_not_match", formatter: untyped }] | ::Array["i_end" | { arel_predicate: "matches", formatter: untyped, case_insensitive: true }] | ::Array["not_i_end" | { arel_predicate: "does_not_match", formatter: untyped, case_insensitive: true }] | ::Array["true" | { arel_predicate: untyped, compounds: false, type: :boolean, validator: untyped, formatter: untyped }] | ::Array["not_true" | { arel_predicate: untyped, compounds: false, type: :boolean, validator: untyped, formatter: untyped }] | ::Array["false" | { arel_predicate: untyped, compounds: false, type: :boolean, validator: untyped, formatter: untyped }] | ::Array["not_false" | { arel_predicate: untyped, compounds: false, type: :boolean, validator: untyped, formatter: untyped }] | ::Array["present" | { arel_predicate: untyped, compounds: false, type: :boolean, validator: untyped, formatter: untyped }] | ::Array["blank" | { arel_predicate: untyped, compounds: false, type: :boolean, validator: untyped, formatter: untyped }] | ::Array["null" | { arel_predicate: untyped, compounds: false, type: :boolean, validator: untyped, formatter: untyped }] | ::Array["not_null" | { arel_predicate: untyped, compounds: false, type: :boolean, validator: untyped, formatter: untyped }] | ::Array["length_eq" | { arel_predicate: "eq", type: :integer }] | ::Array["length_lt" | { arel_predicate: "lt", type: :integer }] | ::Array["length_lteq" | { arel_predicate: "lteq", type: :integer }] | ::Array["length_gt" | { arel_predicate: "gt", type: :integer }] | ::Array["length_gteq" | { arel_predicate: "gteq", type: :integer }]]

    # The character used to escape LIKE wildcards. Emitted as an explicit
    # `ESCAPE` clause alongside every LIKE / NOT LIKE predicate, so the
    # behaviour does not depend on a backend's default escape character —
    # MySQL and PostgreSQL default to backslash, SQLite has no default at all.
    ::Ransack::Constants::LIKE_ESCAPE_CHARACTER: "\\"

    # Escapes the LIKE wildcards `%` and `_`, and the escape character itself,
    # so they are matched literally. Paired with the `ESCAPE` clause added in
    # `Condition#format_predicate`; escaping without it silently does nothing
    # on SQLite. See https://github.com/activerecord-hackery/ransack/issues/1581
    def self?.escape_wildcards: (untyped unescaped) -> untyped

    def self?.null_sentinel_predicate?: (untyped predicate_name, untyped sentinel) -> untyped

    def self?.null_sentinel_value?: (untyped value, untyped sentinel) -> untyped

    def self?.null_sentinel_requested?: (untyped predicate_name, untyped values, untyped sentinel) -> untyped
  end
end

module ::Ransack
  class ::Ransack::Context
    attr_reader search: untyped

    attr_reader object: untyped

    attr_reader klass: untyped

    attr_reader base: untyped

    attr_reader engine: untyped

    attr_reader arel_visitor: untyped

    attr_accessor auth_object: untyped

    attr_accessor search_key: untyped

    attr_accessor ignore_unknown_conditions: untyped

    attr_writer null_sentinel: untyped

    # True when the search was built from `ActionController::Parameters` the
    # controller permitted. A model with no allowlist of its own then lets
    # that permit list be the boundary (see `allowlist` below).
    attr_accessor permitted: untyped

    # An ORM integration registers a block that returns a Context for the
    # objects it understands and nil for anything else. Ransack ships the
    # Active Record integration (see Ransack::ActiveRecord::Context); an
    # integration for another ORM registers its own resolver here.
    def self.register: () { (?) -> untyped } -> untyped

    def self.resolvers: () -> ::Array[untyped]

    def self.for: (untyped object, ?::Hash[untyped, untyped] options) -> untyped

    # Unknown attributes, predicates and combinators raise rather than being
    # ignored when either the global option or this search's own option says so.
    def strict_conditions?: () -> untyped

    # Falls back to the global option unless this search's own option was
    # set, including to `false` to turn the feature off for one search. A
    # Condition captures this when it is built, so a later search reusing
    # this context does not change the conditions of an earlier one.
    def null_sentinel: () -> untyped

    def initialize: (untyped object, ?::Hash[untyped, untyped] options) -> void

    # False when a key has more `_`-separated segments than Ransack will
    # parse. The attribute / association / predicate parsing that follows is
    # superlinear in the segment count and the key is attacker-controlled, so
    # an over-long key is treated as unknown rather than parsed
    # (GHSA-j3f8-w227-4hh8).
    def key_within_depth_limit?: (untyped key) -> untyped

    def bind_pair_for: (untyped key) -> ([ untyped, untyped ] | nil)

    # The SQL dialect the search will be rendered in, for the few places
    # where generated SQL differs by database. See
    # Ransack::ActiveRecord::Dialect for the questions it answers.
    def dialect: () -> untyped

    # The model class behind a search object, an association node or a class.
    # Each ORM integration decides what counts as a model, so this is defined
    # on the integration's Context subclass.
    def klassify: (untyped obj) -> untyped

    # Whether a class can be the base of a search. An ORM integration refines
    # this; by default any class Ransack has been mixed into qualifies.
    def searchable_class?: (untyped klass) -> untyped

    # Convert a string representing a chain of associations and an attribute
    # into the attribute itself
    def contextualize: (untyped str) -> untyped

    # A bare `false` normally means "this checkbox was not ticked" and the
    # scope is not applied at all. A scope listed in
    # `ransackable_scopes_skip_sanitize_args` has asked to see its values as
    # given, so `false` reaches it like any other value and it can be driven
    # by a yes / no / any select (#1375).
    def chain_scope: (untyped scope, untyped args) -> (nil | untyped)

    def scope_arity: (untyped scope) -> untyped

    def sanitize_scope_args: (untyped key, untyped args) -> untyped

    def bind: (untyped object, untyped str) -> (nil | untyped)

    def traverse: (untyped str, ?untyped base) -> bot

    def association_path: (untyped str, ?untyped base) -> ("" | untyped)

    def unpolymorphize_association: (untyped str) -> (::Array[untyped] | ::Array[untyped | nil])

    # The class named in an `_of_Model_type` suffix comes from the query
    # string, so it can name anything: a constant that does not exist, a
    # lowercase word, a module, a class with no table, a path through
    # something that is no module at all (`ENV::Person`). None of those is a
    # model to search, so the suffix is then no polymorphic reference at all
    # and the whole key fails as any other unknown attribute does, ignored or
    # raised as `InvalidSearchError` under `ignore_unknown_conditions`.
    # `Kernel.const_get` used to raise `NameError` straight from the URL
    # (#1738).
    def polymorphic_class: (untyped name) -> (::Class | nil)

    def ransackable_alias: (untyped str) -> untyped

    # Expands every `ransack_alias` in a condition name: the whole name, each
    # `_or_` / `_and_` segment of a compound, and an alias defined on an
    # associated model and reached through an association path
    # (`person_term` when Person aliases `term`). An alias that expands to a
    # compound is joined with that compound's own combinator, so
    # `term_or_daddy` with `term => name_or_email` becomes
    # `name_or_email_or_parent_name`. Returns the name unchanged when it
    # holds no alias.
    def resolve_aliases: (untyped str) -> untyped

    def ransackable_attribute?: (untyped str, untyped klass) -> untyped

    def ransortable_attribute?: (untyped str, untyped klass) -> untyped

    def ransackable_association?: (untyped str, untyped klass) -> untyped

    def ransackable_scope?: (untyped str, untyped klass) -> untyped

    def ransackable_scope_skip_sanitize_args?: (untyped str, untyped klass) -> untyped

    def searchable_attributes: (?untyped str) -> untyped

    def sortable_attributes: (?untyped str) -> untyped

    def searchable_associations: (?untyped str) -> untyped

    private

    def attributes_for: (untyped klass) -> untyped

    # `ransortable_attributes` defaults to `ransackable_attributes`, so a
    # model that defines either one has a sort list of its own.
    def sortable_attributes_for: (untyped klass) -> untyped

    def associations_for: (untyped klass) -> untyped

    # The allowlist a search consults on `klass`. A model that defines its
    # own `method` is always asked, so its list applies on top of whatever
    # the controller permitted. A model that defines none has left the
    # decision to the controller: when the parameters were permitted, the
    # block's list of everything that exists is used, and otherwise the
    # model's default runs, which raises asking for a list (#1403).
    def allowlist: (untyped klass, untyped method, *untyped fallbacks) { () -> untyped } -> untyped

    def resolve_alias_segment: (untyped segment) -> (untyped | ::String)

    def cast_scope_args: (untyped args) -> untyped
  end
end

::RANSACK_FORM_BUILDER: "RANSACK_FORM_BUILDER"

module ::Ransack
  module ::Ransack::Helpers
    class ::Ransack::Helpers::FormBuilder
      def label: (untyped method, *untyped args) { (?) -> untyped } -> untyped

      def submit: (?untyped? value, ?::Hash[untyped, untyped] options) -> untyped

      def attribute_select: (?untyped? options, ?untyped? html_options, ?untyped? action) -> untyped

      def sort_direction_select: (?::Hash[untyped, untyped] options, ?::Hash[untyped, untyped] html_options) -> untyped

      def sort_select: (?::Hash[untyped, untyped] options, ?::Hash[untyped, untyped] html_options) -> untyped

      def sort_fields: (*untyped args) { (?) -> untyped } -> untyped

      def sort_link: (untyped attribute, *untyped args) -> untyped

      def sort_url: (untyped attribute, *untyped args) -> untyped

      def condition_fields: (*untyped args) { (?) -> untyped } -> untyped

      def grouping_fields: (*untyped args) { (?) -> untyped } -> untyped

      def attribute_fields: (*untyped args) { (?) -> untyped } -> untyped

      def predicate_fields: (*untyped args) { (?) -> untyped } -> untyped

      def value_fields: (*untyped args) { (?) -> untyped } -> untyped

      def search_fields: (untyped name, untyped args, untyped block) -> untyped

      def predicate_select: (?::Hash[untyped, untyped] options, ?::Hash[untyped, untyped] html_options) -> untyped

      def combinator_select: (?::Hash[untyped, untyped] options, ?::Hash[untyped, untyped] html_options) -> untyped

      private

      # Rails reads a select's current value back through the field name, which
      # for the predicate select is +p+. Only a Condition has a public +p+, and
      # +Kernel#p+ is private, so a builder for a Search or Grouping would
      # raise instead of finding nothing. Resolve the value here instead.
      def selected_predicate: () -> (untyped | nil)

      def template_grouped_collection_select: (untyped collection, untyped options, untyped html_options) -> untyped

      def template_collection_select: (untyped name, untyped collection, untyped options, untyped html_options) -> untyped

      def can_use_default?: (untyped default, untyped attribute, untyped values) -> untyped

      def mapped_values: (untyped values) -> untyped

      def sort_array: () -> ::Array[::Array["asc" | untyped] | ::Array["desc" | untyped]]

      def combinator_choices: () -> ::Array[::Array[untyped]]

      # Expands the +associations:+ option of +attribute_select+ into the flat
      # list of association paths ransack understands. A String or Symbol
      # names one association; an Array lists several; a Hash reaches through
      # an association to its own associations, so +{ articles: :comments }+
      # yields +articles+ and +articles_comments+. Shapes nest freely.
      def association_array: (untyped obj, ?untyped? prefix) -> untyped

      def association_hash: (untyped obj, ?untyped? prefix) -> untyped

      def attribute_collection_for_bases: (untyped action, untyped bases) -> untyped

      def get_attribute_element: (untyped action, untyped base) -> ([ untyped, untyped ] | nil)

      def attribute_collection_for_base: (untyped attributes, ?untyped? base) -> untyped

      def collection_for_base: (untyped action, untyped base) -> untyped

      def attr_from_base_and_column: (untyped base, untyped column) -> ::String

      def formbuilder_error_message: (untyped action) -> ::String
    end
  end
end

module ::Ransack
  module ::Ransack::Helpers
    module ::Ransack::Helpers::FormHelper
      # +search_form_for+
