      def parse_record: (untyped object) -> untyped

      def html_option_for: (untyped option, untyped search) -> (untyped | ::String)

      def extract_search_and_routing_proxy: (untyped search) -> (::Array[untyped] | ::Array[untyped | nil])

      def url: (untyped routing_proxy, untyped options_for_url) -> untyped

      class ::Ransack::Helpers::FormHelper::SortLink
        def initialize: (untyped search, untyped attribute, untyped args, untyped params) -> void

        def up_arrow: () -> untyped

        def down_arrow: () -> untyped

