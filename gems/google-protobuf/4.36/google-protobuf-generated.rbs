      def []=: (untyped index, untyped value) -> nil

      def push: (*untyped elements) -> ::Google::Protobuf::RepeatedField

      def <<: (untyped element) -> ::Google::Protobuf::RepeatedField

      def replace: (untyped replacements) -> ::Google::Protobuf::RepeatedField

