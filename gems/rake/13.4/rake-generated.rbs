    include ::Rake::DSL

    ::Rake::MakefileLoader::SPACE_MARK: "\u0000"

    # Load the makefile dependencies in +fn+.
    def load: (untyped fn) -> ::String

    private

    # Process one logical line of makefile data.
    def process_line: (untyped line) -> (nil | untyped)

    def respace: (untyped str) -> untyped
  end
end

