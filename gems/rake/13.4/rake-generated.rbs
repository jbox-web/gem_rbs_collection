    # Are there any prerequisites with a later time than the given time stamp?
    def out_of_date?: (untyped stamp) -> untyped

    # Apply the scope to the task name according to the rules for this kind
    # of task.  File based tasks ignore the scope when creating the name.
    def self.scope_name: (untyped scope, untyped task_name) -> untyped
  end
end

# -
# This a FileUtils extension that defines several additional commands to be
# added to the FileUtils utility functions.
module ::FileUtils
  # Path to the currently running Ruby program
  ::FileUtils::RUBY: untyped

  # Run the system command +cmd+.  If multiple arguments are given the command
  # is run directly (without the shell, same semantics as Kernel::exec and
  # Kernel::system).
  #
  # It is recommended you use the multiple argument form over interpolating
  # user input for both usability and security reasons.  With the multiple
  # argument form you can easily process files with spaces or other shell
  # reserved characters in them.  With the multiple argument form your rake
  # tasks are not vulnerable to users providing an argument like
  # <code>; rm # -rf /</code>.
  #
  # If a block is given, upon command completion the block is called with an
  # OK flag (true on a zero exit status) and a Process::Status object.
  # Without a block a RuntimeError is raised when the command exits non-zero.
  #
  # Examples:
  #
  #   sh 'ls -ltr'
  #
  #   sh 'ls', 'file with spaces'
  #
  #   # check exit status after command runs
  #   sh %{grep pattern file} do |ok, res|
  #     if !ok
  #       puts "pattern not found (status = #{res.exitstatus})"
  #     end
  #   end
  #
  def sh: (*untyped cmd) ?{ (?) -> untyped } -> untyped

  private

  def create_shell_runner: (untyped cmd) -> ::Proc

  def sh_show_command: (untyped cmd, ?untyped? options) -> untyped

  def set_verbose_option: (untyped options) -> (untyped | nil)

  public

  # Run a Ruby interpreter with the given arguments.
  #
  # Example:
  #   ruby %{-pe '$_.upcase!' <README}
  #
  def ruby: (*untyped args, **untyped options) { (?) -> untyped } -> untyped

  ::FileUtils::LN_SUPPORTED: ::Array[true]

  #  Attempt to do a normal file link, but fall back to a copy if the link
  #  fails.
  def safe_ln: (*untyped args, **untyped options) -> top

  # Split a file path into individual directory names.
  #
  # Example:
  #   split_all("a/b/c") =>  ['a', 'b', 'c']
  #
  def split_all: (untyped path) -> (::Array[untyped] | untyped)
end

module ::Rake
  #
  # FileUtilsExt provides a custom version of the FileUtils methods
  # that respond to the <tt>verbose</tt> and <tt>nowrite</tt>
  # commands.
  #
  module ::Rake::FileUtilsExt
    include ::FileUtils

    attr_accessor self.verbose_flag: untyped

    attr_accessor self.nowrite_flag: untyped

    ::Rake::FileUtilsExt::DEFAULT: untyped

    # Get/set the verbose flag controlling output from the FileUtils
    # utilities.  If verbose is true, then the utility method is
    # echoed to standard output.
    #
    # Examples:
    #    verbose              # return the current value of the
    #                         # verbose flag
    #    verbose(v)           # set the verbose flag to _v_.
    #    verbose(v) { code }  # Execute code with the verbose flag set
    #                         # temporarily to _v_.  Return to the
    #                         # original value when code is done.
    def verbose: (?untyped? value) ?{ () -> untyped } -> untyped

    # Get/set the nowrite flag controlling output from the FileUtils
    # utilities.  If verbose is true, then the utility method is
    # echoed to standard output.
    #
    # Examples:
    #    nowrite              # return the current value of the
    #                         # nowrite flag
    #    nowrite(v)           # set the nowrite flag to _v_.
    #    nowrite(v) { code }  # Execute code with the nowrite flag set
    #                         # temporarily to _v_. Return to the
    #                         # original value when code is done.
    def nowrite: (?untyped? value) ?{ () -> untyped } -> untyped

    # Use this function to prevent potentially destructive ruby code
    # from running when the :nowrite flag is set.
    #
    # Example:
    #
    #   when_writing("Building Project") do
    #     project.build
    #   end
    #
    # The following code will build the project under normal
    # conditions. If the nowrite(true) flag is set, then the example
    # will print:
    #
    #      DRYRUN: Building Project
    #
    # instead of actually building the project.
    #
    def when_writing: (?untyped? msg) { () -> untyped } -> (untyped | nil | untyped)

    # Send the message to the default rake output (which is $stderr).
    def rake_output_message: (untyped message) -> untyped

    # Check that the options do not contain options not listed in
    # +optdecl+.  An ArgumentError exception is thrown if non-declared
    # options are found.
    def rake_check_options: (untyped options, *untyped optdecl) -> nil

    extend ::Rake::FileUtilsExt
  end
end

# frozen_string_literal: true
module ::Rake
  # InvocationChain tracks the chain of task invocations to detect
  # circular dependencies.
  class ::Rake::InvocationChain < ::Rake::LinkedList
    # Is the invocation already in the chain?
    def member?: (untyped invocation) -> untyped

    # Append an invocation to the chain of invocations. It is an error
    # if the invocation already listed.
    def append: (untyped invocation) -> untyped

    # Convert to string, ie: TOP => invocation => invocation
    def to_s: () -> ::String

    # Class level append.
    def self.append: (untyped invocation, untyped chain) -> untyped

    private

    def prefix: () -> ::String

    # Null object for an empty chain.
    class ::Rake::InvocationChain::EmptyInvocationChain < ::Rake::LinkedList::EmptyLinkedList
      def member?: (untyped obj) -> false

      def append: (untyped invocation) -> untyped

      def to_s: () -> "TOP"
    end

    ::Rake::InvocationChain::EMPTY: untyped
  end
end

# frozen_string_literal: true
module ::Rake
  module ::Rake::InvocationExceptionMixin
    # Return the invocation chain (list of Rake tasks) that were in
    # effect when this exception was detected by rake.  May be null if
    # no tasks were active.
    def chain: () -> untyped

    # Set the invocation chain in effect when this exception was
    # detected.
    def chain=: (untyped value) -> untyped
  end
end

# frozen_string_literal: true
module ::Rake
  # LateTime is a fake timestamp that occurs _after_ any other time value.
  class ::Rake::LateTime
    include ::Comparable

    include ::Singleton

    def <=>: (untyped other) -> 1

    def to_s: () -> "<LATE TIME>"
  end

  ::Rake::LATE: untyped
end

# frozen_string_literal: true
module ::Rake
  # Polylithic linked list structure used to implement several data
  # structures in Rake.
  class ::Rake::LinkedList
    include ::Enumerable[untyped]

    attr_reader head: untyped

    attr_reader tail: untyped

    # Polymorphically add a new element to the head of a list. The
    # type of head node will be the same list type as the tail.
    def conj: (untyped item) -> ::Rake::LinkedList

    # Is the list empty?
    # .make guards against a list being empty making any instantiated LinkedList
    # object not empty by default
    # You should consider overriding this method if you implement your own .make method
    def empty?: () -> false

    # Lists are structurally equivalent.
    def ==: (untyped other) -> (false | untyped)

    # Convert to string: LL(item, item...)
    def to_s: () -> ::String

    # Same as +to_s+, but with inspected items.
    def inspect: () -> ::String

    # For each item in the list.
    def each: () { (untyped) -> untyped } -> self

    # Make a list out of the given arguments. This method is
    # polymorphic
    def self.make: (*untyped args) -> untyped

    # Cons a new head onto the tail list.
    def self.cons: (untyped head, untyped tail) -> untyped

    # The standard empty list class for the given LinkedList class.
    def self.empty: () -> untyped

    def initialize: (untyped head, ?untyped tail) -> void

    # Represent an empty list, using the Null Object Pattern.
    #
    # When inheriting from the LinkedList class, you should implement
    # a type specific Empty class as well. Make sure you set the class
    # instance variable @parent to the associated list class (this
    # allows conj, cons and make to work polymorphically).
    class ::Rake::LinkedList::EmptyLinkedList < ::Rake::LinkedList
      def initialize: () -> void

      def empty?: () -> true

      def self.cons: (untyped head, untyped tail) -> untyped
    end

    ::Rake::LinkedList::EMPTY: untyped
  end
end

