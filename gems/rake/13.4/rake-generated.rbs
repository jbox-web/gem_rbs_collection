# frozen_string_literal: true
module ::Rake
  class ::Rake::Scope < ::Rake::LinkedList
    # Path for the scope.
    def path: () -> untyped

    # Path for the scope + the named path.
    def path_with_task_name: (untyped task_name) -> ::String

    # Trim +n+ innermost scope levels from the scope. In no case will
    # this trim beyond the toplevel scope.
    def trim: (untyped n) -> untyped

    # Scope lists always end with an EmptyScope object. See Null
    # Object Pattern)
    class ::Rake::Scope::EmptyScope
      def path: () -> ""

      def path_with_task_name: (untyped task_name) -> untyped
    end

    # Singleton null object for an empty scope.
    ::Rake::Scope::EMPTY: untyped
  end
end

module ::Rake
  #
  # A Task is the basic unit of work in a Rakefile.  Tasks have associated
  # actions (possibly more than one) and a list of prerequisites.  When
  # invoked, a task will first ensure that all of its prerequisites have an
  # opportunity to run and then it will execute its own actions.
  #
  # Tasks are not usually created directly using the new method, but rather
  # use the +file+ and +task+ convenience methods.
  #
  class ::Rake::Task
    # List of prerequisites for a task.
    attr_reader prerequisites: untyped

    alias prereqs prerequisites

    # List of order only prerequisites for a task.
    attr_reader order_only_prerequisites: untyped

    # List of actions attached to a task.
    attr_reader actions: untyped

    # Application owning this task.
    attr_accessor application: untyped

    # Array of nested namespaces names used for task lookup by this task.
    attr_reader scope: untyped

    # File/Line locations of each of the task definitions for this
    # task (only valid if the task was defined with the detect
    # location option set).
    attr_reader locations: untyped

    # Has this task already been invoked?  Already invoked tasks
    # will be skipped unless you reenable them.
    attr_reader already_invoked: untyped

    # Return task name
    def to_s: () -> untyped

    def inspect: () -> ::String

    # List of sources for task.
    attr_writer sources: untyped

    def sources: () -> untyped

    # List of prerequisite tasks
    def prerequisite_tasks: () -> untyped

    private

    def lookup_prerequisite: (untyped prerequisite_name) -> untyped

    public

    # List of all unique prerequisite tasks including prerequisite tasks'
    # prerequisites.
    # Includes self when cyclic dependencies are found.
    def all_prerequisite_tasks: () -> ::Array[untyped]

    def collect_prerequisites: (untyped seen) -> untyped

    # First source from a rule (nil if no sources)
    def source: () -> untyped

    # Create a task named +task_name+ with no actions or prerequisites. Use
    # +enhance+ to add actions and prerequisites.
    def initialize: (untyped task_name, untyped app) -> void

    # Enhance a task with prerequisites or actions.  Returns self.
    def enhance: (?untyped? deps) ?{ (?) -> untyped } -> self

    # Name of the task, including any namespace qualifiers.
    def name: () -> untyped

    # Name of task with argument list description.
    def name_with_args: () -> (::String | untyped)

    # Argument description (nil if none).
    def arg_description: () -> (::String | nil)

    # Name of arguments for this task.
    def arg_names: () -> untyped

    # Reenable the task, allowing its tasks to be executed if the task
    # is invoked again.
    def reenable: () -> nil

    # Clear the existing prerequisites, actions, comments, and arguments of a rake task.
    def clear: () -> self

    # Clear the existing prerequisites of a rake task.
    def clear_prerequisites: () -> self

    # Clear the existing actions on a rake task.
    def clear_actions: () -> self

    # Clear the existing comments on a rake task.
    def clear_comments: () -> self

    # Clear the existing arguments on a rake task.
    def clear_args: () -> self

    # Invoke the task if it is needed.  Prerequisites are invoked first.
    def invoke: (*untyped args) -> untyped

    # Same as invoke, but explicitly pass a call chain to detect
    # circular dependencies.
    #
    # If multiple tasks depend on this
    # one in parallel, they will all fail if the first execution of
    # this task fails.
    def invoke_with_call_chain: (untyped task_args, untyped invocation_chain) -> (nil | untyped)

    private

    def add_chain_to: (untyped exception, untyped new_chain) -> untyped

    public

    # Invoke all the prerequisites of a task.
    def invoke_prerequisites: (untyped task_args, untyped invocation_chain) -> untyped

    # Invoke all the prerequisites of a task in parallel.
    def invoke_prerequisites_concurrently: (untyped task_args, untyped invocation_chain) -> untyped

    private

    # Format the trace flags for display.
    def format_trace_flags: () -> ("" | ::String)

    public

    # Execute the actions associated with this task.
    def execute: (?untyped? args) -> (nil | untyped)

    # Is this task needed?
    def needed?: () -> true

    # Timestamp for this task.  Basic tasks return the current time for their
    # time stamp.  Other tasks can be more sophisticated.
    def timestamp: () -> untyped

    # Add a description to the task.  The description can consist of an option
    # argument list (enclosed brackets) and an optional comment.
    def add_description: (untyped description) -> (nil | untyped)

    def comment=: (untyped comment) -> untyped

    private

    def add_comment: (untyped comment) -> (nil | untyped)

    public

    # Full collection of comments. Multiple comments are separated by
    # newlines.
    def full_comment: () -> untyped

    # First line (or sentence) of all comments. Multiple comments are
    # separated by a "/".
    def comment: () -> untyped

    private

    # Transform the list of comments as specified by the block and
    # join with the separator.
    def transform_comments: (untyped separator) ?{ (?) -> untyped } -> (nil | untyped)

    # Get the first sentence in a string. The sentence is terminated
    # by the first period, exclamation mark, or the end of the line.
    # Decimal points do not count as periods.
    def first_sentence: (untyped string) -> untyped

    public

    # Set the names of the arguments for this task. +args+ should be
    # an array of symbols, one for each argument name.
    def set_arg_names: (untyped args) -> untyped

    # Return a string describing the internal state of a task.  Useful for
    # debugging.
    def investigation: () -> ::String

    # Format dependencies parameter to pass to task.
    def self.format_deps: (untyped deps) -> untyped

    # Add order only dependencies.
    def |: (untyped deps) -> self

    # Clear the task list.  This cause rake to immediately forget all the
    # tasks that have been assigned.  (Normally used in the unit tests.)
    def self.clear: () -> untyped

    # List of all defined tasks.
    def self.tasks: () -> untyped

    # Return a task with the given name.  If the task is not currently
    # known, try to synthesize one from the defined rules.  If no rules are
    # found, but an existing file matches the task name, assume it is a file
    # task with no dependencies or actions.
    def self.[]: (untyped task_name) -> untyped

    # TRUE if the task name is already defined.
    def self.task_defined?: (untyped task_name) -> untyped

    # Define a task given +args+ and an option block.  If a rule with the
    # given name already exists, the prerequisites and actions are added to
    # the existing task.  Returns the defined task.
    def self.define_task: (*untyped args) { (?) -> untyped } -> untyped

    # Define a rule for synthesizing tasks.
    def self.create_rule: (*untyped args) { (?) -> untyped } -> untyped

    # Apply the scope to the task name according to the rules for
    # this kind of task.  Generic tasks will accept the scope as
    # part of the name.
    def self.scope_name: (untyped scope, untyped task_name) -> untyped
  end
end

# frozen_string_literal: true
module ::Rake
  # Error indicating an ill-formed task declaration.
  class ::Rake::TaskArgumentError < ::ArgumentError
  end
end

# frozen_string_literal: true
module ::Rake
  #
  # TaskArguments manage the arguments passed to a task.
  #
  class ::Rake::TaskArguments
    include ::Enumerable[untyped]

    # Argument names
    attr_reader names: untyped

    # Create a TaskArgument object with a list of argument +names+ and a set
    # of associated +values+.  +parent+ is the parent argument object.
    def initialize: (untyped names, untyped values, ?untyped? parent) -> void

    # Retrieve the complete array of sequential values
    def to_a: () -> untyped

    # Retrieve the list of values not associated with named arguments
    def extras: () -> untyped

    # Create a new argument scope using the prerequisite argument
    # names.
    def new_scope: (untyped names) -> ::Rake::TaskArguments

    # Find an argument value by name or index.
    def []: (untyped index) -> untyped

    # Specify a hash of default values for task arguments. Use the
    # defaults only if there is no specific value for the given
    # argument.
    def with_defaults: (untyped defaults) -> untyped

    # Enumerates the arguments and their values
    def each: () { (?) -> untyped } -> untyped

    # Extracts the argument values at +keys+
    def values_at: (*untyped keys) -> untyped

    # Returns the value of the given argument via method_missing
    def method_missing: (untyped sym, *untyped args) -> untyped

    # Returns a Hash of arguments and their values
    def to_hash: () -> untyped

    def to_s: () -> ::String

    def inspect: () -> ::String

    # Returns true if +key+ is one of the arguments
    def has_key?: (untyped key) -> untyped

    alias key? has_key?

    def fetch: (*untyped args) { (?) -> untyped } -> untyped

    def deconstruct_keys: (untyped keys) -> untyped

    def lookup: (untyped name) -> (untyped | untyped | nil)
  end

  ::Rake::EMPTY_TASK_ARGS: untyped
end

# frozen_string_literal: true
module ::Rake
  # The TaskManager module is a mixin for managing tasks.
  module ::Rake::TaskManager
    # Track the last comment made in the Rakefile.
    attr_accessor last_description: untyped

    def initialize: () -> void

    def create_rule: (*untyped args) { (?) -> untyped } -> ::Array[untyped]

    def define_task: (untyped task_class, *untyped args) { (?) -> untyped } -> untyped

    # Lookup a task.  Return an existing task if found, otherwise
    # create a task of the current type.
    def intern: (untyped task_class, untyped task_name) -> untyped

    # Find a matching task for +task_name+.
    def []: (untyped task_name, ?untyped? scopes) -> untyped

    def generate_message_for_undefined_task: (untyped task_name) -> ::String

    def generate_did_you_mean_suggestions: (untyped task_name) -> ("" | untyped)

    def synthesize_file_task: (untyped task_name) -> (nil | untyped)

    # Resolve the arguments for a task/rule.  Returns a tuple of
    # [task_name, arg_name_list, prerequisites, order_only_prerequisites].
    def resolve_args: (untyped args) -> ([ untyped, untyped, untyped, untyped ] | [ untyped, untyped, [ ], nil ])

    private

    # Resolve task arguments for a task or rule when there are no
    # dependencies declared.
    #
    # The patterns recognized by this argument resolving function are:
    #
    #   task :t
    #   task :t, [:a]
    #
    def resolve_args_without_dependencies: (untyped args) -> ::Array[untyped | ::Array[untyped] | nil]

    # Resolve task arguments for a task or rule when there are
    # dependencies declared.
    #
    # The patterns recognized by this argument resolving function are:
    #
    #   task :t, order_only: [:e]
    #   task :t => [:d]
    #   task :t => [:d], order_only: [:e]
    #   task :t, [a] => [:d]
    #   task :t, [a] => [:d], order_only: [:e]
    #
    def resolve_args_with_dependencies: (untyped args, untyped hash) -> ::Array[untyped]

    public

    # If a rule can be found that matches the task name, enhance the
    # task with the prerequisites and actions from the rule.  Set the
    # source attribute of the task appropriately for the rule.  Return
    # the enhanced task or nil of no rule was found.
    def enhance_with_matching_rule: (untyped task_name, ?::Integer level) -> untyped

    # List of all defined tasks in this application.
    def tasks: () -> ::Array[untyped]

    # List of all the tasks defined in the given scope (and its
    # sub-scopes).
    def tasks_in_scope: (untyped scope) -> untyped

    # Clear all tasks in this application.
    def clear: () -> ::Array[untyped]

    # Lookup a task, using scope and the scope hints in the task name.
    # This method performs straight lookups without trying to
    # synthesize file tasks or rules.  Special scope names (e.g. '^')
    # are recognized.  If no scope argument is supplied, use the
    # current scope.  Return nil if the task cannot be found.
    def lookup: (untyped task_name, ?untyped? initial_scope) -> untyped

    private

    # Lookup the task name
    def lookup_in_scope: (untyped name, untyped scope) -> (untyped | nil)

    public

    # Return the list of scope names currently active in the task
    # manager.
    def current_scope: () -> untyped

    # Evaluate the block in a nested namespace named +name+.  Create
    # an anonymous namespace if +name+ is nil.
    def in_namespace: (untyped name) { (untyped) -> untyped } -> untyped

    private

    # Add a location to the locations field of the given task.
    def add_location: (untyped task) -> untyped

    # Find the location that called into the dsl layer.
    def find_location: () -> (untyped | nil)

    # Generate an anonymous namespace name.
    def generate_name: () -> ::String

    def trace_rule: (untyped level, untyped message) -> (untyped | nil)

    # Attempt to create a rule given the list of prerequisites.
    def attempt_rule: (untyped task_name, untyped task_pattern, untyped args, untyped extensions, untyped block, untyped level) -> (nil | untyped)

    # Make a list of sources from the list of file name extensions /
    # translation procs.
    def make_sources: (untyped task_name, untyped task_pattern, untyped extensions) -> untyped

    # Return the current description, clearing it in the process.
    def get_description: () -> untyped

    attr_accessor self.record_task_metadata: untyped
  end
end

module ::Rake
  # Base class for Task Libraries.
  class ::Rake::TaskLib
    include ::Rake::Cloneable

    include ::Rake::DSL
  end
end

module ::Rake
  # Create a task that runs a set of tests.
  #
  # Example:
  #   require "rake/testtask"
  #
  #   Rake::TestTask.new do |t|
  #     t.libs << "test"
  #     t.test_files = FileList['test/test*.rb']
  #     t.verbose = true
  #   end
  #
  # If rake is invoked with a "TEST=filename" command line option,
  # then the list of test files will be overridden to include only the
  # filename specified on the command line.  This provides an easy way
  # to run just one test.
  #
  # If rake is invoked with a "TESTOPTS=options" command line option,
  # then the given options are passed to the test process after a
  # '--'.  This allows Test::Unit options to be passed to the test
  # suite.
  #
  # Examples:
  #
  #   rake test                           # run tests normally
  #   rake test TEST=just_one_file.rb     # run just one test file.
  #   rake test TESTOPTS="-v"             # run in verbose mode
  #   rake test TESTOPTS="--runner=fox"   # use the fox test runner
  #
  class ::Rake::TestTask < ::Rake::TaskLib
    # Name of test task. (default is :test)
    attr_accessor name: untyped

    # List of directories added to $LOAD_PATH before running the
    # tests. (default is 'lib')
    attr_accessor libs: untyped

    # True if verbose test output desired. (default is false)
    attr_accessor verbose: untyped

    # Test options passed to the test suite.  An explicit
    # TESTOPTS=opts on the command line will override this. (default
    # is NONE)
    attr_accessor options: untyped

    # Request that the tests be run with the warning flag set.
    # E.g. warning=true implies "ruby -w" used to run the tests.
    # (default is true)
    attr_accessor warning: untyped

    # Glob pattern to match test files. (default is 'test/test*.rb')
    attr_accessor pattern: untyped

    # Style of test loader to use.  Options are:
    #
    # * :rake -- Rake provided test loading script (default).
    # * :testrb -- Ruby provided test loading script.
    # * :direct -- Load tests using command line loader.
    #
    attr_accessor loader: untyped

    # Array of command line options to pass to ruby when running test loader.
    attr_accessor ruby_opts: untyped

    # Description of the test task. (default is 'Run tests')
    attr_accessor description: untyped

    # Task prerequisites.
    attr_accessor deps: untyped

    # Explicitly define the list of test files to be included in a
    # test.  +list+ is expected to be an array of file names (a
    # FileList is acceptable).  If both +pattern+ and +test_files+ are
    # used, then the list of test files is the union of the two.
    def test_files=: (untyped list) -> untyped

    # Create a testing task.
    def initialize: (?::Symbol name) ?{ (untyped) -> untyped } -> void

    # Create the tasks defined by this task lib.
    def define: () -> self

    def option_list: (?verbose: untyped) -> untyped

    def ruby_opts_string: () -> untyped

    def lib_path: () -> untyped

    def file_list_string: () -> untyped

    def file_list: () -> untyped

    def ruby_version: () -> untyped

    def run_code: () -> untyped
  end
end

module ::Rake
  class ::Rake::ThreadHistoryDisplay
    include ::Rake::PrivateReader

    def initialize: (untyped stats) -> void

    def show: () -> untyped

    private

    def rename: (untyped hash, untyped key, untyped renames) -> (untyped | nil)

    extend ::Rake::PrivateReader::ClassMethods
  end
end

module ::Rake
  class ::Rake::ThreadPool
    # Creates a ThreadPool object.  The +thread_count+ parameter is the size
    # of the pool.
    def initialize: (untyped thread_count) -> void

    # Creates a future executed by the +ThreadPool+.
    #
    # The args are passed to the block when executing (similarly to
    # Thread#new) The return value is an object representing
    # a future which has been created and added to the queue in the
    # pool. Sending #value to the object will sleep the
    # current thread until the future is finished and will return the
    # result (or raise an exception thrown from the future)
    def future: (*untyped args) { (?) -> untyped } -> untyped

    # Waits until the queue of futures is empty and all threads have exited.
    def join: () -> untyped

    # Enable the gathering of history events.
    def gather_history: () -> (untyped | nil)

    # Return a array of history events for the thread pool.
    #
    # History gathering must be enabled to be able to see the events
    # (see #gather_history). Best to call this when the job is
    # complete (i.e. after ThreadPool#join is called).
    def history: () -> ::Array[untyped]

    # Return a hash of always collected statistics for the thread pool.
    def statistics: () -> { total_threads_in_play: untyped, max_active_threads: untyped }

    private

    # processes one item on the queue. Returns true if there was an
    # item to process, false if there was no item
    def process_queue_item: () -> (false | true)

    def start_thread: () -> (::Integer | nil)

    def stat: (untyped event, ?untyped? data) -> (nil | untyped)

    def __queue__: () -> ::Thread::Queue[untyped]
  end
end

# frozen_string_literal: true
module ::Rake
  module ::Rake::TraceOutput
    # Write trace output to output stream +out+.
    #
    # The write is done as a single IO call (to print) to lessen the
    # chance that the trace output is interrupted by other tasks also
    # producing output.
    def trace_on: (untyped out, *untyped strings) -> untyped
  end
end

