  def self.suggested_thread_count: () -> untyped

  # Return the original directory where the Rake application was started.
  def self.original_dir: () -> untyped

  # Load a rakefile.
  def self.load_rakefile: (untyped path) -> (false | true)

  # Add files to the rakelib list
  def self.add_rakelib: (*untyped files) -> untyped

  def self.with_application: (?untyped block_application) { (untyped) -> untyped } -> untyped
end

# frozen_string_literal: true
module ::Rake
  # Error indicating a recursion overflow error in task selection.
  class ::Rake::RuleRecursionOverflowError < ::StandardError
    def initialize: (*untyped args) -> void

    def add_target: (untyped target) -> ::Array[untyped]

