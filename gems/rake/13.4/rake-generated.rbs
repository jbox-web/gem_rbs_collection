module ::Rake
  # Create a packaging task that will package the project into
  # distributable files (e.g zip archive or tar files).
  #
  # The PackageTask will create the following targets:
  #
  # +:package+ ::
  #   Create all the requested package files.
  #
  # +:clobber_package+ ::
  #   Delete all the package files.  This target is automatically
  #   added to the main clobber target.
  #
  # +:repackage+ ::
  #   Rebuild the package files from scratch, even if they are not out
  #   of date.
  #
  # <tt>"<em>package_dir</em>/<em>name</em>-<em>version</em>.tgz"</tt> ::
  #   Create a gzipped tar package (if <em>need_tar</em> is true).
  #
  # <tt>"<em>package_dir</em>/<em>name</em>-<em>version</em>.tar.gz"</tt> ::
  #   Create a gzipped tar package (if <em>need_tar_gz</em> is true).
  #
  # <tt>"<em>package_dir</em>/<em>name</em>-<em>version</em>.tar.bz2"</tt> ::
  #   Create a bzip2'd tar package (if <em>need_tar_bz2</em> is true).
  #
  # <tt>"<em>package_dir</em>/<em>name</em>-<em>version</em>.zip"</tt> ::
  #   Create a zip package archive (if <em>need_zip</em> is true).
  #
  # Example:
  #
  #   Rake::PackageTask.new("rake", "1.2.3") do |p|
  #     p.need_tar = true
  #     p.package_files.include("lib/**/*.rb")
  #   end
  #
  class ::Rake::PackageTask < ::Rake::TaskLib
    # Name of the package (from the GEM Spec).
    attr_accessor name: untyped

    # Version of the package (e.g. '1.3.2').
    attr_accessor version: untyped

    # Directory used to store the package files (default is 'pkg').
    attr_accessor package_dir: untyped

    # True if a gzipped tar file (tgz) should be produced (default is
    # false).
    attr_accessor need_tar: untyped

    # True if a gzipped tar file (tar.gz) should be produced (default
    # is false).
    attr_accessor need_tar_gz: untyped

    # True if a bzip2'd tar file (tar.bz2) should be produced (default
    # is false).
    attr_accessor need_tar_bz2: untyped

    # True if a xz'd tar file (tar.xz) should be produced (default is false)
    attr_accessor need_tar_xz: untyped

    # True if a zip file should be produced (default is false)
    attr_accessor need_zip: untyped

    # List of files to be included in the package.
    attr_accessor package_files: untyped

    # Tar command for gzipped or bzip2ed archives.  The default is 'tar'.
    attr_accessor tar_command: untyped

    # Zip command for zipped archives.  The default is 'zip'.
    attr_accessor zip_command: untyped

    # True if parent directory should be omitted (default is false)
    attr_accessor without_parent_dir: untyped

    def initialize: (?untyped? name, ?untyped? version) ?{ (untyped) -> untyped } -> void

    # Initialization that bypasses the "yield self" and "define" step.
    def init: (untyped name, untyped version) -> untyped

    # Create the tasks defined by this task library.
    def define: () -> self

    def package_name: () -> (::String | untyped)

    def package_dir_path: () -> ::String

    def tgz_file: () -> ::String

    def tar_gz_file: () -> ::String

    def tar_bz2_file: () -> ::String

    def tar_xz_file: () -> ::String

    def zip_file: () -> ::String

    def working_dir: () -> untyped

    # target directory relative to working_dir
    def target_dir: () -> ("." | untyped)
  end
end

# frozen_string_literal: true
module ::Rake
  # Include PrivateReader to use +private_reader+.
  module ::Rake::PrivateReader
    def self.included: (untyped base) -> untyped

    module ::Rake::PrivateReader::ClassMethods
      # Declare a list of private accessors
      def private_reader: (*untyped names) -> untyped
    end
  end
end

# frozen_string_literal: true
module ::Rake
  # A Promise object represents a promise to do work (a chore) in the
  # future. The promise is created with a block and a list of
  # arguments for the block. Calling value will return the value of
  # the promised chore.
  #
  # Used by ThreadPool.
  #
  class ::Rake::Promise
    ::Rake::Promise::NOT_SET: untyped

    attr_accessor recorder: untyped

    # Create a promise to do the chore specified by the block.
    def initialize: (untyped args) { (?) -> untyped } -> void

    # Return the value of this promise.
    #
    # If the promised chore is not yet complete, then do the work
    # synchronously. We will wait.
    def value: () -> untyped

    # If no one else is working this promise, go ahead and do the chore.
    def work: () -> untyped

    private

    # Perform the chore promised
    def chore: () -> (nil | untyped)

    # Do we have a result for the promise
    def result?: () -> (false | true)

    # Did the promise throw an error
    def error?: () -> (false | true)

    # Are we done with the promise
    def complete?: () -> (false | true)

    # free up these items for the GC
    def discard: () -> nil

    # Record execution statistics if there is a recorder
    def stat: (*untyped args) -> (untyped | nil)
  end
end

# frozen_string_literal: true
module ::Rake
  #
  # Exit status class for times the system just gives us a nil.
  class ::Rake::PseudoStatus
    attr_reader exitstatus: untyped

    def initialize: (?::Integer code) -> void

    def to_i: () -> untyped

    def >>: (untyped n) -> untyped

    def stopped?: () -> false

    def exited?: () -> true
  end
end

module ::Rake
  # Current Rake Application
