module ::Rake
  ::Rake::VERSION: "13.4.2"

  module ::Rake::Version
    ::Rake::Version::MAJOR: untyped

    ::Rake::Version::MINOR: untyped

    ::Rake::Version::BUILD: untyped

    ::Rake::Version::OTHER: untyped

    ::Rake::Version::NUMBERS: untyped
  end
end

