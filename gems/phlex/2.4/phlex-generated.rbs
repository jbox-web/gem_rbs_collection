  # A Ruby expression that evaluates to the text to append, and may raise.
  ::Phlex::Compiler::Output::Expression: untyped

  # Statements that serialise attributes into locals, then the part to
  # append, with the closing text appended instead if the statements exit
  # early. The runtime closes an opening tag however serialisation exits.
  ::Phlex::Compiler::Output::Guarded: untyped

  # Stands in for a statement in the method's tree until it's emitted.
  module ::Phlex::Compiler::Output::Statement
    def start_line: () -> nil

    def accept: (untyped visitor) -> self
  end

  # Parts appended to the buffer in order.
  ::Phlex::Compiler::Output::Append: untyped

  # Statements whose output is followed by the closing text however they
  # exit, unless none of it can exit early.
  ::Phlex::Compiler::Output::Enclosed: untyped

  # Whether the statements can only append text that's known not to raise
  # or jump, so they need no guard.
  def self.static?: (untyped node) -> untyped
end

class ::Phlex::CSV
  ::Phlex::CSV::FORMULA_PREFIXES_MAP: untyped

  ::Phlex::CSV::UNDEFINED: untyped

  def initialize: (untyped collection) -> void

  attr_reader collection: untyped

  def call: (?untyped buffer, ?context: untyped?, ?delimiter: untyped) -> untyped

  def around_row: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def filename: () -> nil

  def content_type: () -> "text/csv"

  def delimiter: () -> ","

  private

  def column: (?untyped? header, untyped value) -> ::Array[untyped]

  def each_item: () { (?) -> untyped } -> untyped

  # Override and set to `false` to disable rendering headers.
  def render_headers?: () -> true

  # Override and set to `true` to strip leading and trailing whitespace from values.
  def trim_whitespace?: () -> false

  # Override and set to `false` to disable CSV injection escapes or `true` to enable.
  def escape_csv_injection?: () -> ::Object

  def __escape__: (untyped buffer, untyped value, escape_csv_injection: untyped, strip_whitespace: untyped, escape_regex: untyped) -> untyped

  # Handle legacy `view_template` method
  def respond_to_missing?: (untyped method_name, untyped include_private) -> untyped

  # Handle legacy `view_template` method
  def method_missing: (untyped method_name, *untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def ensure_escape_csv_injection_configured!: () -> (untyped | nil)
end

# @api private
module ::Phlex::Error
end

class ::Phlex::ArgumentError < ::ArgumentError
  include ::Phlex::Error
end

class ::Phlex::DoubleRenderError < ::RuntimeError
  include ::Phlex::Error
end

class ::Phlex::NameError < ::NameError[untyped]
  include ::Phlex::Error
end

class ::Phlex::RuntimeError < ::RuntimeError
  include ::Phlex::Error
end

# @api private
class ::Phlex::FIFO
  # The byte limits account for cached values, excluding keys and object overhead.
  def initialize: (?max_bytesize: ::Integer, ?max_value_bytesize: ::Integer) -> void

  attr_reader bytesize: untyped

  attr_reader max_bytesize: untyped

  def expand: (untyped bytes) -> untyped

  def []: (untyped key) -> untyped

  # Returns the cached value for `key`, or yields to generate it and caches the
  # result. Unlike `fifo[key] ||= value`, the key is only hashed once.
  def fetch: (untyped key) { () -> untyped } -> untyped

  def []=: (untyped key, untyped value) -> untyped

  private

  def store: (untyped digest, untyped key, untyped value) -> (nil | untyped)

  public

  def size: () -> ::Integer

  def clear: () -> 0
end

# An extremely fast in-memory cache store that evicts keys on a first-in-first-out basis.
class ::Phlex::FIFOCacheStore
  def initialize: (?max_bytesize: untyped) -> void

  # Options such as `expires_in:` are accepted for compatibility with `Rails.cache` but ignored.
  def fetch: (untyped key, **untyped) { () -> untyped } -> untyped

  def clear: () -> untyped

  private

  def map_key: (untyped value) -> untyped
end

# @api private
module ::Phlex::Helpers
  private

  def mix: (*untyped args) -> untyped

  def grab: (**untyped bindings) -> untyped
end

class ::Phlex::HTML < ::Phlex::SGML
  extend ::Phlex::SGML::Elements

  include ::Phlex::HTML::VoidElements

  include ::Phlex::HTML::StandardElements

  # Output an HTML doctype.
  def doctype: () -> nil

  # Outputs an `<svg>` tag.
  #
  # [MDN Docs](https://developer.mozilla.org/docs/Web/SVG/Element/svg)
  # [Spec](https://html.spec.whatwg.org/#the-svg-element)
  def svg: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  # Override to provide a filename for the HTML file
  def filename: () -> nil

  # Returns the string "text/html"
  def content_type: () -> "text/html"

  # Output an HTML tag dynamically, e.g:
  #
  # ```ruby
  # @tag_name = :h1
  # tag(@tag_name, class: "title")
  # ```
  def tag: (untyped name, **untyped attributes) ?{ (untyped) -> untyped } -> (nil | untyped)
end

