module ::Phlex::Kit
  module ::Phlex::Kit::LazyLoader
    def method_missing: (untyped name, *untyped, **untyped) ?{ (?) -> untyped } -> untyped

    def respond_to_missing?: (untyped name, ?bool include_private) -> untyped
  end

  def self.extended: (untyped mod) -> untyped

  def method_missing: (untyped name, *untyped, **untyped) ?{ (?) -> untyped } -> untyped

  def respond_to_missing?: (untyped name, ?bool include_private) -> untyped

  def const_added: (untyped name) -> (nil | untyped)
end

# **Standard Generalized Markup Language** for behaviour common to {HTML} and {SVG}.
class ::Phlex::SGML
  include ::Phlex::Helpers

  # Render the view to a String. Arguments are delegated to {.new}.
  def self.call: (*untyped, **untyped) ?{ (?) -> untyped } -> untyped

  # Create a new instance of the component.
  # @note The block will not be delegated to {#initialize}. Instead, it will be sent to {#view_template} when rendering.
  def self.new: (*untyped a, **untyped k) ?{ (?) -> untyped } -> untyped

  def view_template: () ?{ () -> untyped } -> untyped

  def to_proc: () -> ::Proc

  def call: (?untyped buffer, ?context: ::Hash[untyped, untyped], ?fragments: untyped?) { (?) -> untyped } -> untyped

  def internal_call: (?parent: untyped?, ?state: untyped?) ?{ (?) -> untyped } -> ("" | untyped)

  def context: () -> untyped

  # Returns `false` before rendering and `true` once the component has started rendering.
  # It will not reset back to false after rendering.
  def rendering?: () -> (false | true)

  # Output plain text.
  def plain: (untyped content) -> nil

  # Output a single space character. If a block is given, a space will be output before and after the block.
  def whitespace: () ?{ (?) -> untyped } -> nil

  # Wrap the output in an HTML comment.
  #
  # [MDN Docs](https://developer.mozilla.org/en-US/docs/Web/HTML/Comments)
  def comment: () { (?) -> untyped } -> nil

  # Output the given safe object as-is. You may need to use `safe` to mark a string as a safe object.
  def raw: (untyped content) -> nil

  # Capture the output of the block and returns it as a string.
  def capture: (*untyped args) ?{ (?) -> untyped } -> ("" | untyped)

  # Define a named fragment that can be selectively rendered.
  def fragment: (untyped name) { () -> untyped } -> nil

  # Mark the given string as safe for HTML output.
  def safe: (untyped value) -> untyped

  alias `🦺` safe

  # Flush the current state to the output buffer.
  def flush: () -> untyped

  def render: (?untyped? renderable) ?{ (?) -> untyped } -> nil

  # Cache a block of content.
  #
  # ```ruby
  # @products.each do |product|
  #   cache product do
  #     h1 { product.name }
  #   end
  # end
  # ```
  def cache: (*untyped cache_key, **untyped) { (?) -> untyped } -> nil

  # Cache a block of content where you control the entire cache key.
  # If you really know what you’re doing and want to take full control
  # and responsibility for the cache key, use this method.
  #
  # ```ruby
  # low_level_cache([Commonmarker::VERSION, Digest::MD5.hexdigest(@content)]) do
  #   markdown(@content)
  # end
  # ```
  #
  # Note: To allow you more control, this method does not take a splat of cache keys.
  # If you need to pass multiple cache keys, you should pass an array.
  def low_level_cache: (untyped cache_key, **untyped options) { (?) -> untyped } -> nil

  def json_escape: (untyped string) -> untyped

  private

  # Override this method to use a different deployment key.
  def app_version_key: () -> untyped

  # Override this method to use a different cache store.
  def cache_store: () -> bot

  def enable_cache_reloading?: () -> false

  def vanish: (*untyped, **untyped) ?{ (?) -> untyped } -> nil

  def render?: () -> true

  def format_object: (untyped object) -> (::String | nil)

  def around_template: () { () -> untyped } -> nil

  def before_template: () { (?) -> untyped } -> nil

  def after_template: () { (?) -> untyped } -> nil

  def __yield_content__: () ?{ (untyped) -> untyped } -> nil

  def __yield_content_with_no_yield_args__: () ?{ () -> untyped } -> nil

  def __yield_content_with_args__: (*untyped a) ?{ (untyped) -> untyped } -> nil

  def __implicit_output__: (untyped content) -> (true | false)

  # same as __implicit_output__ but escapes even `safe` objects
  def __text__: (untyped content) -> (true | false)

  def __attributes__: (untyped attributes) -> untyped

  public

  def self.method_added: (untyped method_name) -> untyped

  def self.method_removed: (untyped method_name) -> untyped

  def self.method_undefined: (untyped method_name) -> untyped

  def self.include: (*untyped modules) -> self

  def self.prepend: (*untyped modules) -> self

  # A frozen class can't be recompiled when an element or helper it inlined
  # changes, so its original definitions are put back first.
  def self.freeze: () -> untyped

  # Compiled methods inline elements and helpers as they were at compile
  # time, so a change to one has to be seen. Nothing to do until something
  # has been compiled.
  def self.__inlining_changed__: (untyped target, untyped names) -> (untyped | nil)

  private

  def singleton_method_added: (untyped method_name) -> untyped

  public

  def extend: (*untyped modules) -> self

  def __map_exception__: (untyped exception) -> untyped
end

module ::Phlex::SGML::Attributes
  extend ::Phlex::SGML::Attributes

  ::Phlex::SGML::Attributes::UNSAFE_ATTRIBUTES: untyped

  ::Phlex::SGML::Attributes::REF_ATTRIBUTES: untyped

  ::Phlex::SGML::Attributes::NAMED_CHARACTER_REFERENCES: { "colon" => ":", "tab" => "\t", "newline" => "\n" }

  ::Phlex::SGML::Attributes::UNSAFE_ATTRIBUTE_NAME_CHARS: ::Regexp

  ::Phlex::SGML::Attributes::SIMPLE_ATTRIBUTE_NAME: ::Regexp

  def generate_attributes: (untyped attributes, ?untyped buffer) -> untyped

  def attribute_name: (untyped k) -> ::String

  # Serialises one attribute into the buffer, with every check.
  def generate_attribute: (untyped k, untyped name, untyped v, untyped buffer) -> untyped

  # Raises if the name fails a check that doesn't depend on the value, so a
  # name that passes can be serialised with `attribute` or `reference_attribute`.
  def validate_attribute_name: (untyped k, untyped name) -> nil

  def reference_attribute?: (untyped name) -> (false | true)

  # The text to append for an attribute whose name has been validated.
  def attribute: (untyped k, untyped name, untyped v) -> ("" | untyped)

  # The text to append for a validated attribute that references a URL.
  def reference_attribute: (untyped k, untyped name, untyped v) -> ("" | untyped)

  private

  def attribute_value: (untyped k, untyped name, untyped v, untyped buffer) -> untyped

  # Dates serialise as `YYYY-MM-DD` and Times as ISO 8601, which is what the
  # `datetime` attribute and most `data-` consumers expect.
  def date_time_value: (untyped v) -> untyped

  # Whether a reference should be dropped because it could run script. Only a
  # String can be a reference.
  def drop_reference?: (untyped k, untyped v, untyped value) -> (false | true)

  def check_unsafe_attribute_name: (untyped k, untyped normalized_name) -> nil

  def check_attribute_name: (untyped k, untyped name, untyped lower_name, untyped simple_name) -> nil

  def append_attribute: (untyped buffer, untyped name, untyped value) -> untyped

  public

  # Provides the nested-attributes case for serializing out attributes.
  # This allows us to skip many of the checks the `__attributes__` method must perform.
  def generate_nested_attributes: (untyped attributes, untyped base_name, ?untyped buffer) -> untyped

  # Detects `javascript:` URLs, including ones obfuscated with HTML character
  # references, whitespace or case. The full check has to decode and normalise
  # the value, which allocates several strings, so it's skipped when the value
  # can't possibly normalise to `javascript:`. Character references are the only
  # way to introduce a `j` or a `:` that isn't already present in the value.
  def unsafe_reference?: (untyped value) -> (untyped | false)

  def decode_html_character_references: (untyped value) -> untyped

  def generate_nested_tokens: (untyped tokens, ?::String sep, ?untyped? gsub_from, ?::String gsub_to) -> (nil | untyped)

  # The result is unsafe so should be escaped.
  def generate_styles: (untyped styles) -> untyped
end

module ::Phlex::SGML::Elements
  # Elements whose attributes need rewriting before they're rendered.
  # Shared by the runtime element methods and the compiler.
  ::Phlex::SGML::Elements::ATTRIBUTE_NORMALIZERS: { img: :normalize_img_attributes, link: :normalize_link_attributes, input: :normalize_input_attributes }

  # The attributes each normalizer rewrites, so the compiler can serialise the
  # others on their own.
  ::Phlex::SGML::Elements::NORMALIZED_ATTRIBUTES: { img: untyped, link: untyped, input: untyped }

  def self.normalize_img_attributes: (untyped attributes) -> untyped

  def self.normalize_link_attributes: (untyped attributes) -> untyped

  def self.normalize_input_attributes: (untyped attributes) -> untyped

  def self.normalizer_call: (untyped method_name) -> (::String | nil)

  def __registered_elements__: () -> ::Hash[untyped, untyped]

  def __registered_void_elements__: () -> ::Hash[untyped, untyped]

  def register_element: (untyped method_name, ?tag: untyped) -> untyped

  def __register_void_element__: (untyped method_name, ?tag: untyped) -> untyped
end

# @api private
module ::Phlex::SGML::SafeObject
end

class ::Phlex::SGML::SafeValue
  include ::Phlex::SGML::SafeObject

  def initialize: (untyped to_s) -> void

  attr_reader to_s: untyped
end

class ::Phlex::SGML::State
  def initialize: (output_buffer: untyped, fragments: untyped, ?user_context: ::Hash[untyped, untyped]) -> void

  attr_accessor capturing: untyped

  attr_accessor user_context: untyped

  attr_reader fragments: untyped

  attr_reader fragment_depth: untyped

  attr_reader output_buffer: untyped

  attr_reader buffer: untyped

  attr_reader should_render: untyped

  # Kept as a stored boolean so the check is a plain attribute read.
  alias should_render? should_render

  def around_render: (untyped component) { () -> untyped } -> untyped

  def begin_fragment: (untyped id) -> untyped

  def end_fragment: (untyped id, ?halt: bool) -> (nil | untyped)

  def record_fragment: (untyped id, untyped offset, untyped length, untyped nested_fragments) -> (nil | untyped)

  def caching: () { () -> untyped } -> untyped

  def caching?: () -> untyped

  def capture: (?cache: bool) { () -> untyped } -> ""

  # Flushing moves bytes out of the buffer without changing how much was written.
  def output_bytesize: () -> untyped

  def append: (untyped content) -> untyped

  def flush: () -> nil
end

class ::Phlex::SVG < ::Phlex::SGML
  include ::Phlex::SVG::StandardElements

  # Returns the string "image/svg+xml"
  def content_type: () -> "image/svg+xml"

  # Override to provide a filename for the SVG file
  def filename: () -> nil

  def cdata: (?untyped? content) ?{ (?) -> untyped } -> nil

  def tag: (untyped name, **untyped attributes) ?{ (untyped) -> untyped } -> (nil | untyped)
end

module ::Phlex::SVG::StandardElements
  extend ::Phlex::SGML::Elements

