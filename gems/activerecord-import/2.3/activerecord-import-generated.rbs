  def self.set_attributes_and_mark_clean: (untyped conn, untyped models, untyped import_result, untyped timestamps, untyped options) -> (nil | untyped)

  # Sync belongs_to association ids with foreign key field
  def self.load_association_ids: (untyped model) -> untyped

  def self.import_associations: (untyped models, untyped options) -> (nil | untyped)

  def self.schema_columns_hash: (untyped conn) -> untyped

  # We are eventually going to call Class.import <objects> so we build up a hash
  # of class => objects to import.
  def self.find_associated_objects_for_import: (untyped associated_objects_by_class, untyped model) -> untyped

  # Returns SQL the VALUES for an INSERT statement given the passed in +columns+
  # and +array_of_attributes+.
  def self.values_sql_for_columns_and_attributes: (untyped conn, untyped columns, untyped array_of_attributes) -> untyped

  def self.add_special_rails_stamps: (untyped conn, untyped column_names, untyped array_of_attributes, untyped options) -> ::Hash[untyped, ::Time]

  # Returns an Array of Hashes for the passed in +column_names+ and +array_of_attributes+.
  def self.validations_array_for_column_names_and_attributes: (untyped column_names, untyped array_of_attributes) -> untyped

  # Checks that the imported hash has the required_keys, optionally also checks that the hash has
  # no keys beyond those required when `allow_extra_keys` is false.
  # returns `nil` if validation passes, or an error message if it fails
  def self.validate_hash_import: (untyped hash, untyped required_keys, untyped allow_extra_keys) -> (nil | untyped)
end

module ::ActiveRecord
  class ::ActiveRecord::Base
    # Synchronizes the passed in ActiveRecord instances with data
    # from the database. This is like calling reload on an individual
    # ActiveRecord instance but it is intended for use on multiple instances.
    #
    # This uses one query for all instance updates and then updates existing
    # instances rather sending one query for each instance
    #
    # == Examples
    # # Synchronizing existing models by matching on the primary key field
    # posts = Post.where(author: "Zach").first
    # <.. out of system changes occur to change author name from Zach to Zachary..>
    # Post.synchronize posts
    # posts.first.author # => "Zachary" instead of Zach
    #
    # # Synchronizing using custom key fields
    # posts = Post.where(author: "Zach").first
    # <.. out of system changes occur to change the address of author 'Zach' to 1245 Foo Ln ..>
    # Post.synchronize posts, [:name] # queries on the :name column and not the :id column
    # posts.first.address # => "1245 Foo Ln" instead of whatever it was
    #
    def self.synchronize: (untyped instances, ?::Array[untyped] keys) -> (nil | untyped)

    # See ActiveRecord::ConnectionAdapters::AbstractAdapter.synchronize
    def synchronize: (untyped instances, ?::Array[untyped] key) -> untyped
  end
end

module ::ActiveRecord::Import
  class ::ActiveRecord::Import::ValueSetTooLargeError < ::StandardError
    attr_reader size: untyped

    def initialize: (?::String msg, ?::Integer size) -> void
  end

  class ::ActiveRecord::Import::ValueSetsBytesParser
    attr_reader reserved_bytes: untyped

    attr_reader max_bytes: untyped

    attr_reader values: untyped

    def self.parse: (untyped values, untyped options) -> ::Array[untyped]

    def initialize: (untyped values, untyped options) -> void

    def parse: () -> ::Array[untyped]

    private

    def default_max_bytes: () -> untyped
  end

  class ::ActiveRecord::Import::ValueSetsRecordsParser
    attr_reader max_records: untyped

    attr_reader values: untyped

    def self.parse: (untyped values, untyped options) -> untyped

    def initialize: (untyped values, untyped options) -> void

    def parse: () -> untyped
  end
end

module ::ActiveRecord
  module ::ActiveRecord::Import
    ::ActiveRecord::Import::VERSION: "2.3.0"
  end
end
