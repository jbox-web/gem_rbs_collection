      #
      #   # confirm_within = 3.days and confirmation_sent_at = 2.days.ago
      #   confirmation_period_expired?  # returns false
      #
      #   # confirm_within = 3.days and confirmation_sent_at = 4.days.ago
      #   confirmation_period_expired?  # returns true
      #
      #   # confirm_within = nil
