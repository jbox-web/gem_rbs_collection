      # uses String keys, no Symbols!
      def url_params: (untyped key) -> untyped

      # variables embedded in path, `/metrics/:name`
      # uses Symbol keys, no Strings!
      def route_params: (untyped key) -> untyped

      def params: () -> untyped

      def session: () -> untyped

      def logger: () -> untyped

      # flash { "Some message to show on redirect" }
      def flash: () { () -> untyped } -> untyped

      def flash?: () -> untyped

      def get_flash: () -> untyped

      def erb: (untyped content, ?::Hash[untyped, untyped] options) -> untyped

      def render: (untyped engine, untyped content, ?::Hash[untyped, untyped] options) -> untyped

      def json: (untyped payload) -> ::Array[200 | { "content-type" => "application/json", "cache-control" => "private, no-store" } | ::Array[untyped]]

      private

      def warn: () { () -> untyped } -> untyped

      def _erb: (untyped file, untyped locals) -> untyped
    end
