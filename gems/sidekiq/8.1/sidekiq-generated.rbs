      include ::Sidekiq::Component

      def initialize: (untyped config) -> void

      def track: (untyped queue, untyped klass) { () -> untyped } -> untyped

      # LONG_TERM = 90 * 24 * 60 * 60
      ::Sidekiq::Metrics::ExecutionTracker::MID_TERM: untyped

      ::Sidekiq::Metrics::ExecutionTracker::SHORT_TERM: untyped

      def flush: (?untyped time) -> (nil | untyped)

      private

