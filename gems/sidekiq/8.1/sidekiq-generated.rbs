module ::Sidekiq
  #
  # The Processor is a standalone thread which:
  #
  # 1. fetches a job from Redis
  # 2. executes the job
  #   a. instantiate the job class
  #   b. run the middleware chain
  #   c. call #perform
  #
  # A Processor can exit due to shutdown or due to
  # an error during job execution.
  #
  # If an error occurs in the job execution, the
  # Processor calls the Manager to create a new one
  # to replace itself and exits.
  #
  class ::Sidekiq::Processor
    include ::Sidekiq::Component

    attr_reader thread: untyped

    attr_reader job: untyped

    attr_reader capsule: untyped

    def initialize: (untyped capsule) { (?) -> untyped } -> void

    def terminate: (?bool wait) -> (nil | untyped)

    def kill: (?bool wait) -> (nil | untyped)

    def stopping?: () -> (false | true)

    def start: () -> untyped

    private

    def run: () -> untyped

    def process_one: () { (?) -> untyped } -> nil

    def get_one: () -> untyped

    def fetch: () -> untyped

    def handle_fetch_exception: (untyped ex) -> nil

    def profile: (untyped job) { () -> untyped } -> untyped

    def dispatch: (untyped job_hash, untyped queue, untyped jobstr) { (untyped) -> untyped } -> untyped

    ::Sidekiq::Processor::IGNORE_SHUTDOWN_INTERRUPTS: ::Hash[untyped, :never]

    ::Sidekiq::Processor::ALLOW_SHUTDOWN_INTERRUPTS: ::Hash[untyped, :immediate]

    def process: (untyped uow) -> untyped

    def execute_job: (untyped instance, untyped cloned_args) -> untyped

    # Ruby doesn't provide atomic counters out of the box so we'll
    # implement something simple ourselves.
    # https://bugs.ruby-lang.org/issues/14706
    class ::Sidekiq::Processor::Counter
      def initialize: () -> void

      def incr: (?::Integer amount) -> untyped

      def reset: () -> untyped
    end

    # jruby's Hash implementation is not threadsafe, so we wrap it in a mutex here
    class ::Sidekiq::Processor::SharedWorkState
      def initialize: () -> void

      def set: (untyped tid, untyped hash) -> untyped

      def delete: (untyped tid) -> untyped

      def dup: () -> ::Hash[untyped, untyped]

      def size: () -> ::Integer

      def clear: () -> ::Hash[untyped, untyped]
    end

    ::Sidekiq::Processor::PROCESSED: untyped

    ::Sidekiq::Processor::FAILURE: untyped

    ::Sidekiq::Processor::WORK_STATE: untyped

    def stats: (untyped jobstr, untyped queue) { () -> untyped } -> untyped
  end
end

