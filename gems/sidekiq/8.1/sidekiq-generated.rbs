module ::Sidekiq
  # The Launcher starts the Capsule Managers, the Poller thread and provides the process heartbeat.
  class ::Sidekiq::Launcher
    include ::Sidekiq::Component

    ::Sidekiq::Launcher::STATS_TTL: untyped

    ::Sidekiq::Launcher::PROCTITLES: ::Array[untyped]

    attr_accessor managers: untyped

    attr_accessor poller: untyped

    def initialize: (untyped config, ?embedded: bool) -> void

    # Start this Sidekiq instance. If an embedding process already
    # has a heartbeat thread, caller can use `async_beat: false`
    # and instead have thread call Launcher#heartbeat every N seconds.
    def run: (?async_beat: bool) -> untyped

    # Stops this instance from processing any more jobs,
    def quiet: () -> (nil | untyped)

    # Shuts down this Sidekiq instance. Waits up to the deadline for all jobs to complete.
    def stop: () -> untyped

    def stopping?: () -> (false | true)

    # If embedding Sidekiq, you can have the process heartbeat
    # call this method to regularly heartbeat rather than creating
    # a separate thread.
    def heartbeat: () -> untyped

    private

    ::Sidekiq::Launcher::BEAT_PAUSE: 10

    def start_heartbeat: () -> untyped

    def beat: () -> untyped

    def clear_heartbeat: () -> untyped

    def flush_stats: () -> (nil | untyped)

    def `❤`: () -> untyped

    # We run the heartbeat every five seconds.
    # Capture five samples of RTT, log a warning if each sample
    # is above our warning threshold.
    ::Sidekiq::Launcher::RTT_READINGS: untyped

    ::Sidekiq::Launcher::RTT_WARNING_LEVEL: 50000

    def check_rtt: () -> untyped

    ::Sidekiq::Launcher::MEMORY_GRABBER: untyped

    def memory_usage: (untyped pid) -> untyped

    def to_data: () -> ::Hash[::String, untyped]

    def to_json: () -> untyped
  end
end

