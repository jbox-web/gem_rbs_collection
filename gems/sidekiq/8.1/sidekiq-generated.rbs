module ::Sidekiq
  class ::Sidekiq::RedisClientAdapter
    ::Sidekiq::RedisClientAdapter::BaseError: untyped

    ::Sidekiq::RedisClientAdapter::CommandError: untyped

    # You can add/remove items or clear the whole thing if you don't want deprecation warnings.
    ::Sidekiq::RedisClientAdapter::DEPRECATED_COMMANDS: untyped

    module ::Sidekiq::RedisClientAdapter::CompatMethods
      def info: () -> untyped

      def evalsha: (untyped sha, untyped keys, untyped argv) -> untyped

      # this is the set of Redis commands used by Sidekiq. Not guaranteed
      # to be comprehensive, we use this as a performance enhancement to
      # avoid calling method_missing on most commands
      ::Sidekiq::RedisClientAdapter::CompatMethods::USED_COMMANDS: ::Array["bitfield" | "bitfield_ro" | "del" | "exists" | "expire" | "flushdb" | "get" | "hdel" | "hget" | "hgetall" | "hincrby" | "hlen" | "hmget" | "hset" | "hsetnx" | "incr" | "incrby" | "lindex" | "llen" | "lmove" | "lpop" | "lpush" | "lrange" | "lrem" | "mget" | "mset" | "ping" | "pttl" | "publish" | "rpop" | "rpush" | "sadd" | "scard" | "script" | "set" | "sismember" | "smembers" | "srem" | "ttl" | "type" | "unlink" | "zadd" | "zcard" | "zincrby" | "zrange" | "zrem" | "zremrangebyrank" | "zremrangebyscore"]

      private

      # this allows us to use methods like `conn.hmset(...)` instead of having to use
      # redis-client's native `conn.call("hmset", ...)`
      def method_missing: (*untyped args) { (?) -> untyped } -> untyped

      def respond_to_missing?: (untyped name, ?bool include_private) -> untyped
    end

    class ::Sidekiq::RedisClientAdapter::CompatClient
      def config: () -> untyped
    end

    def initialize: (untyped options) -> void

    def new_client: () -> ::Sidekiq::RedisClientAdapter::CompatClient

    private

    def client_opts: (untyped options) -> untyped
  end
end

