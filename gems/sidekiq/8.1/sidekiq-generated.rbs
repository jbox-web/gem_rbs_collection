module ::Sidekiq
  class ::Sidekiq::TUI
    class ::Sidekiq::TUI::BaseTab
      include ::Sidekiq::TUI::Controls

      attr_reader name: untyped

      attr_reader data: untyped

      def initialize: (untyped parent) -> void

      def t: (*untyped) -> untyped

      def reset_data: () -> { selected: [ ], selected_row_index: 0 }

      def error: () -> untyped

      def error=: (untyped e) -> untyped

      def selected?: (untyped entry) -> untyped

      def filtering?: () -> false

      def each_selection: (?unselect: bool) { (untyped) -> untyped } -> untyped

      # Navigate the row selection up or down in the current tab's table.
      # @param direction [Symbol] :up or :down
      def navigate_row: (untyped direction) -> (nil | untyped)

      def prev_page: () -> (nil | untyped)

      def next_page: () -> (nil | untyped)

      def toggle_select: (?::Symbol which) -> untyped

      def refresh_data_for_stats: () -> { processed: untyped, failed: untyped, busy: untyped, enqueued: untyped, retries: untyped, scheduled: untyped, dead: untyped }

      def render_table: (untyped tui, untyped frame, untyped area) { () -> untyped } -> untyped

      def render_stats_section: (untyped tui, untyped frame, untyped area) -> untyped

      # Render a bordered paragraph with a line of (translated) keys over
      # a line of preformatted values, each column ljust'ed to +width+.
      def render_kv_section: (untyped tui, untyped frame, untyped area, title: untyped, keys: untyped, values: untyped, ?width: ::Integer) -> untyped

      # Split a tab's area into the standard stats header and a fill
      # area for the tab's main content.
      def stats_content_split: (untyped tui, untyped area) -> untyped

      def striped_rows: (untyped tui, untyped rows) -> untyped

      def chart_y_axis: (untyped tui, untyped y_max, ?num_labels: ::Integer) -> untyped

      # [thousands_separator, decimal_separator] per locale.
      # Locales not listed here use the English default [",", "."].
      ::Sidekiq::TUI::BaseTab::NUMERIC_SEPARATORS: { "da" => ::Array["." | ","], "de" => ::Array["." | ","], "el" => ::Array["." | ","], "es" => ::Array["." | ","], "it" => ::Array["." | ","], "nl" => ::Array["." | ","], "pt" => ::Array["." | ","], "pt-BR" => ::Array["." | ","], "tr" => ::Array["." | ","], "vi" => ::Array["." | ","], "cs" => ::Array[" " | ","], "fr" => ::Array[" " | ","], "lt" => ::Array[" " | ","], "nb" => ::Array[" " | ","], "pl" => ::Array[" " | ","], "ru" => ::Array[" " | ","], "sv" => ::Array[" " | ","], "uk" => ::Array[" " | ","] }

      def number_with_delimiter: (untyped number, ?::Hash[untyped, untyped] options) -> untyped

      def format_memory: (untyped rss_kb) -> ("0" | untyped)
    end
  end
end

