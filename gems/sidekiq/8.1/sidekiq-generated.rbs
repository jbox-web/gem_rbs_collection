    # Executes all blocks registered to +name+ via on_load.
    #
    #   Sidekiq.loader.run_load_hooks(:api)
    #
    # In the case of the above example, it will execute all hooks registered for +:api+.
    #
    def run_load_hooks: (untyped name) -> untyped
  end
