    def self.inline?: () -> untyped

    def self.server_middleware: () ?{ (untyped) -> untyped } -> untyped
  end

  class ::Sidekiq::EmptyQueueError < ::RuntimeError
  end

  module ::Sidekiq::TestingClient
    private

    def atomic_push: (untyped conn, untyped payloads) -> (true | true | untyped)
  end

  module ::Sidekiq::Queues
    def self.[]: (untyped queue) -> untyped

    def self.push: (untyped queue, untyped klass, untyped job) -> untyped

    def self.jobs_by_queue: () -> ::Hash[untyped, untyped]

    def self.jobs_by_class: () -> ::Hash[untyped, untyped]

    alias self.jobs_by_worker self.jobs_by_class

    def self.delete_for: (untyped jid, untyped queue, untyped klass) -> untyped

    def self.clear_for: (untyped queue, untyped klass) -> untyped

    def self.clear_all: () -> untyped
  end

  module ::Sidekiq::Job
    #
    # The Sidekiq testing infrastructure overrides perform_async
    # so that it does not actually touch the network.  Instead it
    # stores the asynchronous jobs in a per-class array so that
    # their presence/absence can be asserted by your tests.
    #
    # This is similar to ActionMailer's :test delivery_method and its
    # ActionMailer::Base.deliveries array.
    #
    # Example:
    #
    #   require 'sidekiq/testing'
    #
    #   assert_equal 0, HardJob.jobs.size
    #   HardJob.perform_async(:something)
    #   assert_equal 1, HardJob.jobs.size
    #   assert_equal :something, HardJob.jobs[0]['args'][0]
    #
    # You can also clear and drain all job types:
    #
    #   Sidekiq::Job.clear_all # or .drain_all
    #
    # This can be useful to make sure jobs don't linger between tests:
    #
    #   RSpec.configure do |config|
    #     config.before(:each) do
    #       Sidekiq::Job.clear_all
    #     end
    #   end
    #
    # or for acceptance testing, i.e. with cucumber:
    #
    #   AfterStep do
    #     Sidekiq::Job.drain_all
    #   end
    #
    #   When I sign up as "foo@example.com"
    #   Then I should receive a welcome email to "foo@example.com"
    #
    module ::Sidekiq::Job::ClassMethods
      # Queue for this worker
      def queue: () -> untyped

      # Jobs queued for this worker
      def jobs: () -> untyped

      # Clear all jobs for this worker
      def clear: () -> untyped

      # Drain and run all jobs for this worker
      def drain: () -> nil

      # Pop out a single job and perform it
      def perform_one: () -> untyped

      def process_job: (untyped job) -> untyped

      def execute_job: (untyped worker, untyped args) -> untyped
    end

    def self.jobs: () -> untyped

    # Clear all queued jobs
    def self.clear_all: () -> untyped

    # Drain (execute) all queued jobs
    def self.drain_all: () -> nil
  end

  module ::Sidekiq::TestingExtensions
    def jobs_for: (untyped klass) -> untyped
  end
end

module ::Sidekiq
  class ::Sidekiq::TransactionAwareClient
    def initialize: (?pool: untyped?, ?config: untyped?) -> void

    def batching?: () -> untyped

    def push: (untyped item) -> untyped

    #
    # We don't provide transactionality for push_bulk because we don't want
    # to hold potentially hundreds of thousands of job records in memory due to
    # a long running enqueue process.
    def push_bulk: (untyped items) -> untyped
  end
end

