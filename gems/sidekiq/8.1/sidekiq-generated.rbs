module ::Sidekiq
  class ::Sidekiq::TUI
    module ::Sidekiq::TUI::Controls
      # Defines data for input handling and for displaying controls.
      # :code is the key code for input handling.
      # :display and :description are shown in the controls area, with different
      #   styling between them. If :display is omitted, :code is displayed instead.
      # :action is a lambda to execute when the control is triggered.
      # :refresh means the action requires immediate refreshing of data
      #
      # Conventions: dangerous/irreversible actions should use UPPERCASE codes.
      # The Shift button means "I'm sure".
      ::Sidekiq::TUI::Controls::GLOBAL: ::Array[{ code: "?", display: "?", description: "Help", action: untyped } | { code: "left", display: ::String, description: "Select Tab", action: untyped, refresh: true } | { code: "right", action: untyped, refresh: true } | { code: "q", description: "Quit", action: untyped } | { code: "c", modifiers: ::Array["ctrl"], action: untyped }]

      ::Sidekiq::TUI::Controls::SHARED: { pageable: ::Array[{ code: "h", display: "h/l", description: "Prev/Next Page", action: untyped, refresh: true } | { code: "l", action: untyped, refresh: true }], selectable: ::Array[{ code: "k", display: "j/k", description: "Prev/Next Row", action: untyped } | { code: "j", action: untyped } | { code: "x", description: "Select", action: untyped } | { code: "A", modifiers: ::Array["shift"], display: "A", description: "Select All", action: untyped }], filterable: ::Array[{ code: "/", display: "/", description: "Filter", action: untyped } | { code: "backspace", action: untyped, refresh: true } | { code: "enter", action: untyped, refresh: true } | { code: "esc", action: untyped, refresh: true }] }

      # Returns an array of symbols for functionality which this tab implements
      def features: () -> ::Array[untyped]

      def controls: () -> ::Array[untyped]
    end
  end
end

