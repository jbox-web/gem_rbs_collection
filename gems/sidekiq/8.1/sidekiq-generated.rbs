module ::Sidekiq
  #
  # The Manager is the central coordination point in Sidekiq, controlling
  # the lifecycle of the Processors.
  #
  # Tasks:
  #
  # 1. start: Spin up Processors.
  # 3. processor_died: Handle job failure, throw away Processor, create new one.
  # 4. quiet: shutdown idle Processors.
  # 5. stop: hard stop the Processors by deadline.
  #
  # Note that only the last task requires its own Thread since it has to monitor
  # the shutdown process.  The other tasks are performed by other threads.
  #
  class ::Sidekiq::Manager
    include ::Sidekiq::Component

    attr_reader workers: untyped

    attr_reader capsule: untyped

    def initialize: (untyped capsule) -> void

    def start: () -> ::Set[untyped]

    def quiet: () -> (nil | untyped)

    def stop: (untyped deadline) -> nil

    def processor_result: (untyped processor, ?untyped? reason) -> nil

    def stopped?: () -> (false | true)

    private

    def hard_shutdown: () -> nil

    # hack for quicker development / testing environment #2774
    ::Sidekiq::Manager::PAUSE_TIME: untyped

    # Wait for the orblock to be true or the deadline passed.
    def wait_for: (untyped deadline) { (?) -> untyped } -> (nil | untyped)
  end
end

module ::Sidekiq
  module ::Sidekiq::Metrics
    # Allows caller to query for Sidekiq execution metrics within Redis.
    # Caller sets a set of attributes to act as filters. {#fetch} will call
    # Redis and return a Hash of results.
    #
    # NB: all metrics and times/dates are UTC only. We explicitly do not
    # support timezones.
    class ::Sidekiq::Metrics::Query
      def initialize: (?pool: untyped?, ?now: untyped) -> void

      ::Sidekiq::Metrics::Query::ROLLUPS: { minutely: ::Array[60 | untyped], hourly: ::Array[600 | untyped] }

      # Get metric data for all jobs from the last hour
      #  +class_filter+: return only results for classes matching filter
      #  +minutes+: the number of fine-grained minute buckets to retrieve
      #  +hours+: the number of coarser-grained 10-minute buckets to retrieve, in hours
      def top_jobs: (?class_filter: untyped?, ?minutes: untyped?, ?hours: untyped?) -> ::Sidekiq::Metrics::Query::Result

      def for_job: (untyped klass, ?minutes: untyped?, ?hours: untyped?) -> ::Sidekiq::Metrics::Query::Result

      class ::Sidekiq::Metrics::Query::Result
        def initialize: (?::Symbol granularity) -> void
      end

      class ::Sidekiq::Metrics::Query::JobResult
        def initialize: (?::Symbol granularity) -> void

        def add_metric: (untyped metric, untyped time, untyped value) -> nil

        def add_hist: (untyped time, untyped hist_result) -> untyped

        def total_avg: (?::String metric) -> (0 | untyped)

        def series_avg: (?::String metric) -> untyped
      end

      ::Sidekiq::Metrics::Query::MarkResult: untyped

      def self.bkt_time_s: (untyped time, untyped granularity) -> ::String

      private

      def fetch_marks: (untyped time_range, untyped granularity) -> ::Array[untyped]
    end
  end
end

module ::Sidekiq
  module ::Sidekiq::Metrics
    class ::Sidekiq::Metrics::Counter
      def initialize: () -> void

      def increment: () -> ::Integer

      def value: () -> (0 | ::Integer)
    end

    # Implements space-efficient but statistically useful histogram storage.
    # A precise time histogram stores every time. Instead we break times into a set of
    # known buckets and increment counts of the associated time bucket. Even if we call
    # the histogram a million times, we'll still only store 26 buckets.
    # NB: needs to be thread-safe or resiliant to races.
    #
    # To store this data, we use Redis' BITFIELD command to store unsigned 16-bit counters
    # per bucket per klass per minute. It's unlikely that most people will be executing more
    # than 1000 job/sec for a full minute of a specific type (i.e. overflow 65,536).
    #
    # Histograms are only stored at the fine-grained level, they are not rolled up
    # for longer-term buckets.
    class ::Sidekiq::Metrics::Histogram
      include ::Enumerable[untyped]

      # This number represents the maximum milliseconds for this bucket.
      # 20 means all job executions up to 20ms, e.g. if a job takes
      # 280ms, it'll increment bucket[7]. Note we can track job executions
      # up to about 5.5 minutes. After that, it's assumed you're probably
      # not too concerned with its performance.
      ::Sidekiq::Metrics::Histogram::BUCKET_INTERVALS: ::Array[20 | 30 | 45 | 65 | 100 | 150 | 225 | 335 | 500 | 750 | 1100 | 1700 | 2500 | 3800 | 5750 | 8500 | 13000 | 20000 | 30000 | 45000 | 65000 | 100000 | 150000 | 225000 | 335000 | ::Float]

      ::Sidekiq::Metrics::Histogram::LABELS: ::Array["20ms" | "30ms" | "45ms" | "65ms" | "100ms" | "150ms" | "225ms" | "335ms" | "500ms" | "750ms" | "1.1s" | "1.7s" | "2.5s" | "3.8s" | "5.75s" | "8.5s" | "13s" | "20s" | "30s" | "45s" | "65s" | "100s" | "150s" | "225s" | "335s" | "Slow"]

      ::Sidekiq::Metrics::Histogram::FETCH: untyped

      ::Sidekiq::Metrics::Histogram::HISTOGRAM_TTL: untyped

      def each: () { (untyped) -> untyped } -> untyped

      def label: (untyped idx) -> untyped

      attr_reader buckets: untyped

      def initialize: (untyped klass) -> void

      def record_time: (untyped ms) -> untyped

      def fetch: (untyped conn, ?untyped now) -> untyped

      def persist: (untyped conn, ?untyped now) -> ::String
    end
  end
end

