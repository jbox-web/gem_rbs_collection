module ::Sidekiq
  module ::Sidekiq::Scheduled
    ::Sidekiq::Scheduled::SETS: ::Array["retry" | "schedule"]

    class ::Sidekiq::Scheduled::Enq
      include ::Sidekiq::Component

      ::Sidekiq::Scheduled::Enq::LUA_ZPOPBYSCORE: "local key, now = KEYS[1], ARGV[1]\nlocal jobs = redis.call(\"zrange\", key, \"-inf\", now, \"byscore\", \"limit\", 0, 1)\nif jobs[1] then\n  redis.call(\"zrem\", key, jobs[1])\n  return jobs[1]\nend\n"

      def initialize: (untyped container) -> void

      def enqueue_jobs: (?untyped sorted_sets) -> untyped

      def terminate: () -> true

      private

      def zpopbyscore: (untyped conn, ?keys: untyped?, ?argv: untyped?) -> untyped
    end

    #
    # The Poller checks Redis every N seconds for jobs in the retry or scheduled
    # set have passed their timestamp and should be enqueued.  If so, it
    # just pops the job back onto its original queue so the
    # workers can pick it up like any other job.
    class ::Sidekiq::Scheduled::Poller
      include ::Sidekiq::Component

      ::Sidekiq::Scheduled::Poller::INITIAL_WAIT: 10

      attr_accessor rnd: untyped

      def initialize: (untyped config) -> void

      # Shut down this instance, will pause until the thread is dead.
      def terminate: () -> untyped

      def start: () -> untyped

      def enqueue: () -> untyped

      private

      def wait: () -> untyped

      def random_poll_interval: () -> untyped

      # We do our best to tune the poll interval to the size of the active Sidekiq
      # cluster.  If you have 30 processes and poll every 15 seconds, that means one
      # Sidekiq is checking Redis every 0.5 seconds - way too often for most people
      # and really bad if the retry or scheduled sets are large.
      #
      # Instead try to avoid polling more than once every 15 seconds.  If you have
      # 30 Sidekiq processes, we'll poll every 30 * 15 or 450 seconds.
      # To keep things statistically random, we'll sleep a random amount between
      # 225 and 675 seconds for each poll or 450 seconds on average.  Otherwise restarting
      # all your Sidekiq processes at the same time will lead to them all polling at
      # the same time: the thundering herd problem.
      #
      # We only do this if poll_interval_average is unset (the default).
      def poll_interval_average: (untyped count) -> untyped

      # Calculates an average poll interval based on the number of known Sidekiq processes.
      # This minimizes a single point of failure by dispersing check-ins but without taxing
      # Redis if you run many Sidekiq processes.
      def scaled_poll_interval: (untyped process_count) -> untyped

      def process_count: () -> untyped

      # A copy of Sidekiq::ProcessSet#cleanup because server
      # should never depend on sidekiq/api.
      def cleanup: () -> (0 | untyped)

      def initial_wait: () -> untyped
    end
  end
end

# SdNotify is a pure-Ruby implementation of sd_notify(3). It can be used to
# notify systemd about state changes. Methods of this package are no-op on
# non-systemd systems (eg. Darwin).
#
# The API maps closely to the original implementation of sd_notify(3),
# therefore be sure to check the official man pages prior to using SdNotify.
#
# @see https://www.freedesktop.org/software/systemd/man/sd_notify.html
module ::Sidekiq
  module ::Sidekiq::SdNotify
    # Exception raised when there's an error writing to the notification socket
    class ::Sidekiq::SdNotify::NotifyError < ::RuntimeError
    end

    ::Sidekiq::SdNotify::READY: "READY=1"

    ::Sidekiq::SdNotify::RELOADING: "RELOADING=1"

    ::Sidekiq::SdNotify::STOPPING: "STOPPING=1"

    ::Sidekiq::SdNotify::STATUS: "STATUS="

    ::Sidekiq::SdNotify::ERRNO: "ERRNO="

    ::Sidekiq::SdNotify::MAINPID: "MAINPID="

    ::Sidekiq::SdNotify::WATCHDOG: "WATCHDOG=1"

    ::Sidekiq::SdNotify::FDSTORE: "FDSTORE=1"

    def self.ready: (?bool unset_env) -> top

    def self.reloading: (?bool unset_env) -> top

    def self.stopping: (?bool unset_env) -> top

    # @param status [String] a custom status string that describes the current
    #   state of the service
    def self.status: (untyped status, ?bool unset_env) -> top

    # @param errno [Integer]
    def self.errno: (untyped errno, ?bool unset_env) -> top

    # @param pid [Integer]
    def self.mainpid: (untyped pid, ?bool unset_env) -> top

    def self.watchdog: (?bool unset_env) -> top

    def self.fdstore: (?bool unset_env) -> top

    # @return [Boolean] true if the service manager expects watchdog keep-alive
    #   notification messages to be sent from this process.
    #
    # If the $WATCHDOG_USEC environment variable is set,
    # and the $WATCHDOG_PID variable is unset or set to the PID of the current
    # process
    #
    # @note Unlike sd_watchdog_enabled(3), this method does not mutate the
    #   environment.
    def self.watchdog?: () -> (false | true)

    # Notify systemd with the provided state, via the notification socket, if
    # any.
    #
    # Generally this method will be used indirectly through the other methods
    # of the library.
    #
    # @param state [String]
    # @param unset_env [Boolean]
    #
    # @return [Fixnum, nil] the number of bytes written to the notification
    #   socket or nil if there was no socket to report to (eg. the program wasn't
    #   started by systemd)
    #
    # @raise [NotifyError] if there was an error communicating with the systemd
    #   socket
    #
    # @see https://www.freedesktop.org/software/systemd/man/sd_notify.html
    def self.notify: (untyped state, ?bool unset_env) -> (nil | untyped)
  end
end

#
# Sidekiq's systemd integration allows Sidekiq to inform systemd:
#  1. when it has successfully started
#  2. when it is starting shutdown
#  3. periodically for a liveness check with a watchdog thread
#
module ::Sidekiq
  def self.start_watchdog: () -> untyped
end

