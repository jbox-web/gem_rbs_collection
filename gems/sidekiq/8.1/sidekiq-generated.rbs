    # back to the proper page after performing that action.
    def redirect_with_query: (untyped url) -> untyped

    def environment_title_prefix: () -> (::String | nil)

    def product_version: () -> ::String

    def server_utc_time: () -> ::String

    def pollable?: () -> (false | true)

    def retry_or_delete_or_kill: (untyped job, untyped params) -> (untyped | untyped | untyped | nil)

    def delete_or_add_queue: (untyped job, untyped params) -> (untyped | untyped | nil)
  end
end

module ::Sidekiq
  class ::Sidekiq::Web
    # Provides an API to declare endpoints, along with a match
    # API to dynamically route a request to an endpoint.
    module ::Sidekiq::Web::Router
      def head: (untyped path) { (?) -> untyped } -> untyped

      def get: (untyped path) { (?) -> untyped } -> untyped

      def post: (untyped path) { (?) -> untyped } -> untyped

      def put: (untyped path) { (?) -> untyped } -> untyped

      def patch: (untyped path) { (?) -> untyped } -> untyped

      def delete: (untyped path) { (?) -> untyped } -> untyped

      def route: (*untyped methods, untyped path) { (?) -> untyped } -> untyped

      def match: (untyped env) -> (untyped | nil)

      def route_cache: () -> { get: [ ], post: [ ], put: [ ], patch: [ ], delete: [ ], head: [ ] }
    end

    class ::Sidekiq::Web::Route
      attr_accessor request_method: untyped

      attr_accessor pattern: untyped

      attr_accessor block: untyped

      attr_accessor name: untyped

      ::Sidekiq::Web::Route::NAMED_SEGMENTS_PATTERN: ::Regexp

      def initialize: (untyped request_method, untyped pattern, untyped block) -> void

      def matcher: () -> untyped

      def compile: () -> untyped

      ::Sidekiq::Web::Route::EMPTY: ::Hash[untyped, untyped]

      def match: (untyped request_method, untyped path) -> untyped
    end
  end
end

module ::Sidekiq
  # Sidekiq::Job is a new alias for Sidekiq::Worker as of Sidekiq 6.3.0.
  # Use `include Sidekiq::Job` rather than `include Sidekiq::Worker`.
  #
  # The term "worker" is too generic and overly confusing, used in several
  # different contexts meaning different things. Many people call a Sidekiq
  # process a "worker". Some people call the thread that executes jobs a
  # "worker". This change brings Sidekiq closer to ActiveJob where your job
  # classes extend ApplicationJob.
  ::Sidekiq::Worker: untyped
end
