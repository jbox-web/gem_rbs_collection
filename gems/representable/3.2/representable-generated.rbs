      def property: (untyped name, ?::Hash[untyped, untyped] options) -> untyped

      # :private:
      # super ugly hack
      # recursively injects the namespace_defs into all representers of this tree. will be done better in 4.0.
      def update_namespace_defs!: (untyped namespace_defs) -> untyped
    end

    module ::Representable::XML::Namespace::AsWithNamespace
      def write: (untyped doc, untyped fragment, untyped as) -> untyped

      # FIXME: this is shit, the NestedOptions is executed too late here!
      def read: (untyped node, untyped as) -> untyped

      private

      def prefixed: (untyped dfn, untyped as) -> ::String
    end

    # FIXME: some "bug" in Representable's XML doesn't consider the container tag, so we could theoretically pick the
    # wrong namespaced tag here :O
    def from_node: (untyped node, ?::Hash[untyped, untyped] options) -> untyped

    def to_node: (?::Hash[untyped, untyped] options) -> untyped

    # "Physically" add `xmlns` attributes to `node`.
    def add_namespace_definitions!: (untyped node, untyped namespaces) -> untyped

    def self.Namespaced: (untyped prefix, untyped name) -> ::String

    # FIXME: this is a PoC, we need a better API to inject code.
    def representable_map: (untyped options, untyped format) -> untyped
  end
end

module ::Representable
  module ::Representable::YAML
    include ::Representable::Hash

    def self.included: (untyped base) -> untyped

    module ::Representable::YAML::ClassMethods
      def format_engine: () -> singleton(::Representable::YAML)
    end

    def from_yaml: (untyped doc, ?::Hash[untyped, untyped] options) -> untyped

    # Returns a Nokogiri::XML object representing this object.
    def to_ast: (?::Hash[untyped, untyped] options) -> untyped

    def to_yaml: (*untyped args) -> untyped

    alias render to_yaml

    alias parse from_yaml
  end
end

