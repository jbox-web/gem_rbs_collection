#!/usr/bin/env ruby
# frozen_string_literal: true

# Generates the RBS of the Rails gems from their installed source, in the
# layout `rbs collection` expects from a source (`gems/<gem>/<MAJOR.MINOR>/`).
#
# Two generators are combined, because neither is enough on its own:
#
# - `rbs prototype rb` declares every method written with `def`, but types
#   almost every return as `untyped` (81 % on activesupport 8.1.4);
# - `rigor sig-gen` infers return types, but skips every method whose return
#   it cannot type (1,428 of them on activesupport 8.1.4) — and a method
#   missing from the RBS reads as undefined to a type checker.
#
# The prototype gives the skeleton, sig-gen's inferred returns replace the
# `untyped` ones wherever sig-gen has one for the same method.
#
# Usage (see README.md for the options):
#   bin/generate [--gems-dir PATH/.bundle/ruby/4.0.0/gems --rails 8.1.4 [RAILS_GEM...]] \
#     [--gem NAME:VERSION:DIR...] [--defer-to DIR...] [--resolve-with DIR...]

require 'fileutils'
require 'open3'
require 'optparse'
require 'stringio'
require_relative '../lib/rbs_support'

GEMS = [
  'activesupport', 'activemodel', 'activerecord', 'actionpack', 'actionview', 'activejob',
  'railties', 'actionmailer', 'activestorage', 'actioncable', 'actiontext',
].freeze

# Standard library dependencies the gems load without declaring them in their
# gemspec, taken from the manifests of ruby/gem_rbs_collection.
STDLIB_DEPENDENCIES = {
  'activesupport' => ['date', 'logger', 'monitor', 'openssl', 'singleton', 'time', 'securerandom', 'erb', 'stringio'],
  'activemodel'   => ['date', 'logger', 'monitor', 'singleton', 'time'],
  'activerecord'  => ['date', 'delegate', 'logger', 'monitor', 'singleton', 'time'],
  'railties'      => ['tsort'],
  'actionmailer'  => ['cgi', 'date', 'logger', 'monitor', 'singleton', 'time', 'tsort'],
  'activestorage' => ['tempfile'],
}.freeze

# Paths left out of the generation, relative to the gem's `lib/`.
#
# activesupport's core extensions are declared by the rigor-activesupport-core-ext
# plugin. Declaring them a second time makes the whole RBS environment fail with
# RBS::DuplicatedMethodDefinitionError (::Object#acts_like?, ::Array#compact_blank!),
# which takes ::Object down — the reason a project typing with rigor had to ignore
# the community collection's activesupport in the first place. The same plugin declares ActiveSupport::Concern
# — leniently, which is what keeps methods declared in `included do` / `class_methods`
# blocks from reading as undefined — and Duration and TimeWithZone: their source
# files are left out too, so the plugin's declarations stay the only ones.
#
# The JDOM backend of XmlMini only loads on JRuby, and its `class Object;
# include Java; end` would make ::Object fail to build on MRI (Java is undeclared).
#
# railties' API documentation generator subclasses RDoc::Generator::SDoc, from the
# sdoc gem Rails only uses to build its own docs: undeclared, it fails to build.
EXCLUDED = {
  'activesupport' => [
    'active_support/core_ext/**/*.rb', 'active_support/core_ext.rb', 'active_support/xml_mini/jdom.rb',
    'active_support/concern.rb', 'active_support/duration.rb', 'active_support/time_with_zone.rb',
  ],
  'railties'      => ['rails/api/**/*.rb'],
}.freeze

LICENSE_HEADER = <<~TEXT
  # Generated by bin/generate from the source of %<gem>s %<version>s.
  # Do not edit: regenerate, and put hand-written fixes in %<gem>s.rbs.
  #
  # Ruby on Rails is released under the MIT License.
  # Copyright (c) David Heinemeier Hansson
TEXT

GENERIC_HEADER = <<~TEXT
  # Generated by bin/generate from the source of %<gem>s %<version>s.
  # Do not edit: regenerate, and put hand-written fixes in %<gem>s.rbs.
  # The gem's own license applies — see its gemspec.
TEXT

# Left out of every gem: the generators' templates are Ruby files the
# generators copy into an application, not code the gem loads — they would
# declare SessionsControllerTest, DummyConfig or top-level TestUnit modules.
EXCLUDED_EVERYWHERE = ['**/templates/**/*.rb'].freeze

def source_files(lib, gem)
  files    = Dir.glob('**/*.rb', base: lib)
  excluded = (EXCLUDED_EVERYWHERE + EXCLUDED.fetch(gem, [])).flat_map { |pattern| Dir.glob(pattern, base: lib) }
  (files - excluded).sort.map { |file| File.join(lib, file) }
end

def run!(*command, chdir:)
  stdout, stderr, status = Open3.capture3({ 'LANG' => 'en_US.UTF-8', 'LC_ALL' => 'en_US.UTF-8' }, *command,
                                          chdir: chdir)
  abort "#{command.first} failed in #{chdir}:\n#{stderr}" unless status.success?

  stdout
end

# The gem's manifest: the libraries of STDLIB_DEPENDENCIES, plus those its
# generated RBS refers to — names are resolved against RbsSupport::RESOLUTION_LIBRARIES,
# and `rbs collection` loads only what a manifest lists.
def manifest(gem, declarations, roots)
  dependencies = (STDLIB_DEPENDENCIES.fetch(gem, []) + RbsSupport::Stdlib.dependencies(declarations, roots)).uniq
  return if dependencies.empty?

  "dependencies:\n#{dependencies.map { |name| "  - name: #{name}\n" }.join}"
end

# A gem to generate: its name, its version, and the directory of its source.
Target = Struct.new(:name, :version, :source) do
  def directory
    version.split('.').first(2).join('.')
  end

  def header
    format(GEMS.include?(name) ? LICENSE_HEADER : GENERIC_HEADER, gem: name, version: version)
  end
end

options = { defer_to: [], resolve_with: [], gems: [] }
OptionParser.new do |parser|
  parser.on('--gems-dir PATH') { |path| options[:gems_dir] = path }
  parser.on('--rails VERSION') { |version| options[:rails] = version }
  parser.on('--gem NAME:VERSION:DIR') do |spec|
    name, version, source = spec.split(':', 3)
    abort "--gem expects NAME:VERSION:DIR, got #{spec}" if [name, version, source].any? { |part| part.to_s.empty? }

    options[:gems] << Target.new(name, version, source)
  end
  parser.on('--defer-to DIR') { |path| options[:defer_to] << path }
  parser.on('--resolve-with DIR') { |path| options[:resolve_with] << path }
end.parse!

usage = 'usage: bin/generate [--gems-dir PATH --rails VERSION [GEM...]] [--gem NAME:VERSION:DIR...] ' \
        '[--defer-to DIR...] [--resolve-with DIR...]'
rails = options[:gems_dir] && options[:rails]
abort usage unless rails || options[:gems].any?

# The Rails gems — all of them, unless named — share one version and live
# side by side in the bundle; any other gem is given with its own.
rails_names = ARGV.empty? ? GEMS : ARGV
targets     = (rails ? rails_names : []).map do |name|
  Target.new(name, options[:rails], File.join(options[:gems_dir], "#{name}-#{options[:rails]}"))
end + options[:gems]

root = File.expand_path('..', __dir__)

# The hand-written files of this repository are deferred to as well: a fix
# written in `<gem>.rbs` replaces the generated declaration instead of
# colliding with it. So are the generated RBS of the gems this run does not
# regenerate: a method they declare is not declared twice, as it would not be
# in a run regenerating every gem.
hand_written, others = RbsSupport.repository_signatures(root, targets.to_h { |target| [target.name, target.directory] })
deferred_index       = RbsSupport::Deferred.load(options[:defer_to] + hand_written + others)

sources = targets.to_h do |target|
  lib = File.join(target.source, 'lib')
  abort "#{lib} not found" unless File.directory?(lib)

  files     = source_files(lib, target.name)
  prototype = run!('rbs', 'prototype', 'rb', *files, chdir: target.source)
  inferred  = run!('rigor', 'sig-gen', '--print', '--include-private', '--no-cache', *files, chdir: target.source)
  [target.name, [files, RbsSupport.parse(prototype), RbsSupport.parse(inferred)]]
end

# A first macro index, over every gem's skeleton, so a gem's own load hooks
# apply the `extended` hooks of the modules they extend (ransack's
# `on_load(:active_record) { extend Ransack::ActiveRecord::Base }` declares
# _ransack_aliases on every model). The index written next to each gem is
# rebuilt below, against the resolved environment.
skeleton_paths = Set.new(sources.values.flat_map { |_, skeleton, _| RbsSupport.container_names(skeleton).keys })
early_index    = RbsSupport.merged_macro_indexes([]).tap do |merged|
  sources.each_value do |files, _, _|
    index = MacroIndex.new(skeleton_paths).index(files)
    ['macros', 'extended'].each do |section|
      merged[section].merge!(index[section]) do |_, a, b|
        MacroIndex.merge(a, b)
      end
    end
  end
end

generated = targets.to_h do |target|
  files, skeleton, inferred = sources.fetch(target.name)

  dsl          = DslExtractor.new(RbsSupport.container_names(skeleton), macros: early_index).extract(files).to_rbs
  declarations = RbsSupport.drop_core_reopenings(skeleton + RbsSupport.parse(dsl))
  declarations = RbsSupport.merge_returns(declarations, RbsSupport.typed_returns(inferred))
  declarations = RbsSupport.dedupe(declarations, RbsSupport.container_names(declarations))
  declarations = RbsSupport.mirror_instance_methods(declarations, RbsSupport::FORWARDED_TO_INSTANCE)
  declarations = deferred_index.give_way(declarations)

  puts format('%<name>-20s %<version>-8s %<files>4d files', name: target.name, version: target.version,
files: files.size)
  [target.name, declarations]
end

# Across gems too, a name is declared once: sidekiq declares the constant
# ActiveJob::QueueAdapters::SidekiqAdapter::JobWrapper, activejob the class.
# The gems are processed in order, Rails first, so the first declaration wins;
# the gems not regenerated this run come before them all.
existing  = others.flat_map { |file| RbsSupport.parse(File.read(file, encoding: 'UTF-8')) }
generated = RbsSupport.dedupe_across(generated, existing)

# The gems not regenerated this run still resolve names: their current RBS,
# and every hand-written file, join the resolution environment as is.
environment = RbsSupport.resolution_environment(generated,
                                                options[:defer_to] + options[:resolve_with] + hand_written + others)
resolved    = environment.sources.select { |source| generated.key?(source.buffer.name) }.group_by { |s| s.buffer.name }

sanitizer   = RbsSupport::Sanitizer.new(environment, deferred_index)
known_paths = Set.new(environment.class_decls.keys.map { |name| name.to_s.delete_prefix('::').split('::') })
roots       = RbsSupport::Stdlib.roots(RbsSupport::RESOLUTION_LIBRARIES)

# Every output is built before the first is written: a failure leaves the
# repository as it was rather than half regenerated.
outputs = targets.to_h do |target|
  declarations = sanitizer.call(resolved.fetch(target.name, []).flat_map(&:declarations))
  rbs          = StringIO.new.tap do |io|
    io.puts target.header
    RBS::Writer.new(out: io).write(declarations)
  end

  # What the gem's macros do to the classes calling them — read by the
  # projects that type their own code (myapp's bin/siggen).
  lib   = File.join(target.source, 'lib')
  index = MacroIndex.new(known_paths).index(source_files(lib, target.name))

  files = {
    "#{target.name}-generated.rbs" => rbs.string,
    'manifest.yaml'                => manifest(target.name, declarations, roots),
    "#{target.name}-macros.yml"    => index.to_yaml,
  }
  [target, files.compact]
end

outputs.each do |target, files|
  directory = File.join(root, 'gems', target.name, target.directory)
  FileUtils.mkdir_p(directory)
  files.each { |name, content| RbsSupport.write_atomically(File.join(directory, name)) { |io| io.write(content) } }
end
